limit: liblapzt.u128 = [[[[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.true, liblapzt.bool.true]]]], [[[[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]], [[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]], [[[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]]

from.u64 = (value: liblapzt.u64) liblapzt.u128 {
    [value, liblapzt.u64.zero]
}

sum.squares.linear = (n: liblapzt.u128, high: liblapzt.u128) liblapzt.u128 {
    done: liblapzt.bool = liblapzt.u128.ge(n, high)
    BRANCH (done) {
        liblapzt.u128.zero
    } {
        square: liblapzt.u128 = liblapzt.u128.mul(n, n)
        rest: liblapzt.u128 = sum.squares.linear(liblapzt.u128.inc(n), high)
        liblapzt.u128.add(square, rest)
    }
}

sum.squares = (low: liblapzt.u128, high: liblapzt.u128) liblapzt.u128 {
    done: liblapzt.bool = liblapzt.u128.ge(low, high)
    BRANCH (done) {
        liblapzt.u128.zero
    } {
        size: liblapzt.u128 = liblapzt.u128.sub(high, low)
        small: liblapzt.bool = liblapzt.u128.le(size, threshold)
        BRANCH (small) {
            sum.squares.linear(low, high)
        } {
            middle: liblapzt.u128 = liblapzt.u128.add(low, liblapzt.u128.div(size, two))
            left: liblapzt.u128 = sum.squares(low, middle)
            right: liblapzt.u128 = sum.squares(middle, high)
            liblapzt.u128.add(left, right)
        }
    }
}

main = () [] {
    [ok, extra] = liblapzt.io.read(liblapzt.io.stdin, liblapzt.u64.zero)
    limit.runtime: liblapzt.u128 = liblapzt.u128.add(limit, from.u64(extra))
    result: liblapzt.u128 = sum.squares(liblapzt.u128.zero, limit.runtime)
    liblapzt.print.u128(result)
    liblapzt.print.newline()
    []
}
