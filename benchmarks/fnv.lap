prime: liblapzt.u64 = [[[[[[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]]], [[[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]
basis: liblapzt.u64 = [[[[[[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.true]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.true, liblapzt.bool.true]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.true]], [[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.true]]]], [[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.true, liblapzt.bool.true]]], [[[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.true]]]]]]
limit: liblapzt.u64 = [[[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.true, liblapzt.bool.true]]]], [[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.true, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.true]]], [[[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]

fnv = (n: liblapzt.u64, high: liblapzt.u64, hash: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.ge(n, high)
    BRANCH (done) {
        hash
    } {
        mixed: liblapzt.u64 = liblapzt.u64.xor(hash, n)
        next: liblapzt.u64 = liblapzt.u64.mul(mixed, prime)
        fnv(liblapzt.u64.inc(n), high, next)
    }
}

main = () [] {
    [ok, extra] = liblapzt.io.read(liblapzt.io.stdin, liblapzt.u64.zero)
    limit.runtime: liblapzt.u64 = liblapzt.u64.add(limit, extra)
    result: liblapzt.u64 = fnv(liblapzt.u64.zero, limit.runtime, basis)
    liblapzt.print.u64(result)
    liblapzt.print.newline()
    []
}
