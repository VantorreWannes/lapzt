fib = (n: liblapzt.u64, a: liblapzt.u64, b: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.is.zero(n)
    BRANCH (done) {
        a
    } {
        fib(liblapzt.u64.dec(n), b, liblapzt.u64.add(a, b))
    }
}

write.digit = (digit: liblapzt.u64) [] {
    ascii: liblapzt.u64 = liblapzt.u64.add(digit, forty.eight)
    [ok] = liblapzt.io.write(liblapzt.io.stdout, liblapzt.u64.zero, ascii)
    liblapzt.assert.true(ok)
    []
}

print.digits = (value: liblapzt.u64) [] {
    quotient: liblapzt.u64 = liblapzt.u64.div(value, ten)
    remainder: liblapzt.u64 = liblapzt.u64.mod(value, ten)
    done: liblapzt.bool = liblapzt.u64.is.zero(quotient)
    BRANCH (done) {
        write.digit(remainder)
    } {
        print.digits(quotient)
        write.digit(remainder)
    }
}

