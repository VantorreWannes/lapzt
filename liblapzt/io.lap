// Handles for the standard streams and the command line.
//
// A handle is a word, not a reference. The runtime resolves it on each
// read or write.

// Standard input, a readable stream.
liblapzt.io.stdin: liblapzt.u64 = IO.STDIN
// Standard output, a writable stream.
liblapzt.io.stdout: liblapzt.u64 = IO.STDOUT
// Standard error, a writable stream.
liblapzt.io.stderr: liblapzt.u64 = IO.STDERR
// Command-line arguments, a readable stream of zero-terminated bytes.
liblapzt.io.args: liblapzt.u64 = IO.ARGS

// Reads a word from a memory handle at offset, or the next word from a
// stream handle. Returns a status and the word. A stream read zero-pads
// the final word and reports false at end of stream.
liblapzt.io.read = (handle: liblapzt.u64, offset: liblapzt.u64) [BIT, liblapzt.u64] {
    EXTERN(OP.READ, handle, offset)
}

// Writes a word to a memory handle at offset, or the next word to a
// stream handle. Returns true on success.
liblapzt.io.write = (handle: liblapzt.u64, offset: liblapzt.u64, value: liblapzt.u64) [BIT] {
    EXTERN(OP.WRITE, handle, offset, value)
}

// Reads the next word from a stream handle.
liblapzt.io.read.word = (handle: liblapzt.u64) [BIT, liblapzt.u64] {
    liblapzt.io.read(handle, liblapzt.u64.zero)
}

// Writes a word to a stream handle.
liblapzt.io.write.word = (handle: liblapzt.u64, value: liblapzt.u64) [BIT] {
    liblapzt.io.write(handle, liblapzt.u64.zero, value)
}

// Writes count bytes of value to a memory handle at offset, or the next
// count bytes to a stream handle. Count must not exceed eight. Returns
// true on success.
liblapzt.io.write.bytes = (handle: liblapzt.u64, offset: liblapzt.u64, value: liblapzt.u64, count: liblapzt.u64) [BIT] {
    EXTERN(OP.WRITE.BYTES, handle, offset, value, count)
}
