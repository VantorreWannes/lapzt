//! 128-bit signed integer type, stored in two's complement form

// --- Erased ---

__liblapzt.integer.i128.erased = [liblapzt.integer.u64, liblapzt.integer.u64]
__liblapzt.integer.i128.MIN.erased = [liblapzt.integer.u64.MIN, liblapzt.integer.i64.MIN]
__liblapzt.integer.i128.MAX.erased = [liblapzt.integer.u64.MAX, liblapzt.integer.i64.MAX]
__liblapzt.integer.i128.ZERO.erased = [liblapzt.integer.u64.MIN, liblapzt.integer.u64.MIN]

// --- Types ---

liblapzt.integer.i128 = __liblapzt.integer.i128.erased
liblapzt.integer.i128.MIN = __liblapzt.integer.i128.MIN.erased
liblapzt.integer.i128.MAX = __liblapzt.integer.i128.MAX.erased
liblapzt.integer.i128.ZERO = __liblapzt.integer.i128.ZERO.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.i128.not = (self: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [liblapzt.integer.u64.not(self_low), liblapzt.integer.u64.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.i128.and = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.and(self_low, other_low), liblapzt.integer.u64.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.i128.or = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.or(self_low, other_low), liblapzt.integer.u64.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.i128.not.and = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.not.and(self_low, other_low), liblapzt.integer.u64.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.i128.not.or = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.not.or(self_low, other_low), liblapzt.integer.u64.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.i128.exclusive.or = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.exclusive.or(self_low, other_low), liblapzt.integer.u64.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.i128.equal = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.i128.not.equal = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u64.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u64.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is less than other under signed ordering.
liblapzt.integer.i128.less_than = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.i64.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.i64.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u64.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns true when self is greater than other under signed ordering.
liblapzt.integer.i128.greater_than = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.boolean {
    liblapzt.integer.i128.less_than(other, self)
}

// Returns the smaller of self and other under signed ordering.
liblapzt.integer.i128.min = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    less: liblapzt.boolean = liblapzt.integer.i128.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other under signed ordering.
liblapzt.integer.i128.max = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    greater: liblapzt.boolean = liblapzt.integer.i128.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^128.
liblapzt.integer.i128.add.wrapping = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u64 = liblapzt.integer.u64.and(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and the
// value is then MIN.
liblapzt.integer.i128.add.checked = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.boolean, liblapzt.integer.i128] {
    sum: liblapzt.integer.i128 = liblapzt.integer.i128.add.wrapping(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(other, liblapzt.integer.i128.ZERO)
    sum_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(sum, liblapzt.integer.i128.ZERO)
    same_sign: liblapzt.boolean = liblapzt.boolean.equal(self_negative, other_negative)
    changed: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, sum_negative)
    overflow: liblapzt.boolean = liblapzt.boolean.and(same_sign, changed)
    BRANCH (overflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i128.MIN]
    } {
        [liblapzt.boolean.TRUE, sum]
    }
}

// Returns the sum of self and other, saturated at MAX or MIN.
liblapzt.integer.i128.add.saturating = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [ok, sum] = liblapzt.integer.i128.add.checked(self, other)
    BRANCH (ok) {
        sum
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
        BRANCH (self_negative) { liblapzt.integer.i128.MIN } { liblapzt.integer.i128.MAX }
    }
}

// Returns the difference of self and other modulo 2^128.
liblapzt.integer.i128.subtract.wrapping = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u64.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// overflows, and the value is then MIN.
liblapzt.integer.i128.subtract.checked = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.boolean, liblapzt.integer.i128] {
    difference: liblapzt.integer.i128 = liblapzt.integer.i128.subtract.wrapping(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(other, liblapzt.integer.i128.ZERO)
    difference_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(difference, liblapzt.integer.i128.ZERO)
    differ: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, other_negative)
    changed: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, difference_negative)
    overflow: liblapzt.boolean = liblapzt.boolean.and(differ, changed)
    BRANCH (overflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i128.MIN]
    } {
        [liblapzt.boolean.TRUE, difference]
    }
}

// Returns the difference of self and other, saturated at MAX or MIN.
liblapzt.integer.i128.subtract.saturating = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [ok, difference] = liblapzt.integer.i128.subtract.checked(self, other)
    BRANCH (ok) {
        difference
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
        BRANCH (self_negative) { liblapzt.integer.i128.MIN } { liblapzt.integer.i128.MAX }
    }
}

// Returns the full 2*128-bit product of self and other as a pair
// [low, high].
liblapzt.integer.i128.multiply.full = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.integer.i128, liblapzt.integer.i128] {
    [low, high] = liblapzt.integer.u128.multiply.full(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(other, liblapzt.integer.i128.ZERO)
    high_1: liblapzt.integer.u128 = BRANCH (self_negative) {
        liblapzt.integer.u128.subtract.wrapping(high, other)
    } {
        high
    }
    high_2: liblapzt.integer.u128 = BRANCH (other_negative) {
        liblapzt.integer.u128.subtract.wrapping(high_1, self)
    } {
        high_1
    }
    [low, high_2]
}

// Returns the low 128 bits of the product of self and other.
liblapzt.integer.i128.multiply.wrapping = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [low, high] = liblapzt.integer.i128.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.i128.multiply.checked = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.boolean, liblapzt.integer.i128] {
    [low, high] = liblapzt.integer.i128.multiply.full(self, other)
    sign: liblapzt.boolean = liblapzt.integer.i128.less_than(low, liblapzt.integer.i128.ZERO)
    fill: liblapzt.integer.u128 = BRANCH (sign) { liblapzt.integer.u128.MAX } { liblapzt.integer.u128.MIN }
    [liblapzt.integer.u128.equal(high, fill), low]
}

// Returns the product of self and other, saturated at MAX or MIN.
liblapzt.integer.i128.multiply.saturating = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [ok, low] = liblapzt.integer.i128.multiply.checked(self, other)
    BRANCH (ok) {
        low
    } {
        negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
        other_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(other, liblapzt.integer.i128.ZERO)
        differ: liblapzt.boolean = liblapzt.boolean.not.equal(negative, other_negative)
        BRANCH (differ) { liblapzt.integer.i128.MIN } { liblapzt.integer.i128.MAX }
    }
}

// Returns [quotient, remainder] of self divided by other, truncating
// toward zero. Returns [MAX, MIN] when other is zero.
liblapzt.integer.i128.divide.full = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.integer.i128, liblapzt.integer.i128] {
    zero: liblapzt.boolean = liblapzt.integer.i128.equal(other, liblapzt.integer.i128.ZERO)
    BRANCH (zero) {
        [liblapzt.integer.i128.MAX, liblapzt.integer.i128.MIN]
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
        other_negative: liblapzt.boolean = liblapzt.integer.i128.less_than(other, liblapzt.integer.i128.ZERO)
        self_magnitude: liblapzt.integer.i128 = BRANCH (self_negative) { liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, self) } { self }
        other_magnitude: liblapzt.integer.i128 = BRANCH (other_negative) { liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, other) } { other }
        [quotient_u, remainder_u] = liblapzt.integer.u128.divide.full(self_magnitude, other_magnitude)
        quotient_negative: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, other_negative)
        quotient: liblapzt.integer.i128 = BRANCH (quotient_negative) { liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, quotient_u) } { quotient_u }
        remainder: liblapzt.integer.i128 = BRANCH (self_negative) { liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, remainder_u) } { remainder_u }
        [quotient, remainder]
    }
}

// Returns self divided by other, truncating toward zero. Division by
// zero saturates to MAX; MIN divided by -1 wraps to MIN.
liblapzt.integer.i128.divide.wrapping = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [quotient, remainder] = liblapzt.integer.i128.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX or MIN.
liblapzt.integer.i128.divide.saturating = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    [ok, quotient] = liblapzt.integer.i128.divide.checked(self, other)
    BRANCH (ok) {
        quotient
    } {
        negative: liblapzt.boolean = liblapzt.integer.i128.less_than(self, liblapzt.integer.i128.ZERO)
        BRANCH (negative) { liblapzt.integer.i128.MIN } { liblapzt.integer.i128.MAX }
    }
}

// Returns [ok, quotient]. Ok is false when other is zero or the
// quotient overflows, and the value is then MIN.
liblapzt.integer.i128.divide.checked = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.boolean, liblapzt.integer.i128] {
    zero: liblapzt.boolean = liblapzt.integer.i128.equal(other, liblapzt.integer.i128.ZERO)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i128.MIN]
    } {
        overflow: liblapzt.boolean = liblapzt.boolean.and(liblapzt.integer.i128.equal(self, liblapzt.integer.i128.MIN), liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MAX))
        BRANCH (overflow) {
            [liblapzt.boolean.FALSE, liblapzt.integer.i128.MIN]
        } {
            [quotient, remainder] = liblapzt.integer.i128.divide.full(self, other)
            [liblapzt.boolean.TRUE, quotient]
        }
    }
}

// Returns the remainder of self divided by other, with the sign of
// self. Division by zero saturates to MAX.
liblapzt.integer.i128.remainder.wrapping = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    zero: liblapzt.boolean = liblapzt.integer.i128.equal(other, liblapzt.integer.i128.ZERO)
    BRANCH (zero) {
        liblapzt.integer.i128.MAX
    } {
        [quotient, remainder] = liblapzt.integer.i128.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.i128.remainder.saturating = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) liblapzt.integer.i128 {
    zero: liblapzt.boolean = liblapzt.integer.i128.equal(other, liblapzt.integer.i128.ZERO)
    BRANCH (zero) {
        liblapzt.integer.i128.MAX
    } {
        [quotient, remainder] = liblapzt.integer.i128.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.i128.remainder.checked = (self: liblapzt.integer.i128, other: liblapzt.integer.i128) [liblapzt.boolean, liblapzt.integer.i128] {
    zero: liblapzt.boolean = liblapzt.integer.i128.equal(other, liblapzt.integer.i128.ZERO)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i128.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.i128.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}

// Converts self to i2, truncating or sign extending.
liblapzt.integer.i128.to.i2 = (self: liblapzt.integer.i128) liblapzt.integer.i2 {
    [low, high] = self
    liblapzt.integer.i64.to.i2(low)
}

// Converts an i2 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i2 = (value: liblapzt.integer.i2) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i2.less_than(value, liblapzt.integer.i2.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [liblapzt.integer.i2.to.i64(value), fill]
}

// Converts self to i4, truncating or sign extending.
liblapzt.integer.i128.to.i4 = (self: liblapzt.integer.i128) liblapzt.integer.i4 {
    [low, high] = self
    liblapzt.integer.i64.to.i4(low)
}

// Converts an i4 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i4 = (value: liblapzt.integer.i4) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i4.less_than(value, liblapzt.integer.i4.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [liblapzt.integer.i4.to.i64(value), fill]
}

// Converts self to i8, truncating or sign extending.
liblapzt.integer.i128.to.i8 = (self: liblapzt.integer.i128) liblapzt.integer.i8 {
    [low, high] = self
    liblapzt.integer.i64.to.i8(low)
}

// Converts an i8 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i8 = (value: liblapzt.integer.i8) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i8.less_than(value, liblapzt.integer.i8.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [liblapzt.integer.i8.to.i64(value), fill]
}

// Converts self to i16, truncating or sign extending.
liblapzt.integer.i128.to.i16 = (self: liblapzt.integer.i128) liblapzt.integer.i16 {
    [low, high] = self
    liblapzt.integer.i64.to.i16(low)
}

// Converts an i16 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i16 = (value: liblapzt.integer.i16) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i16.less_than(value, liblapzt.integer.i16.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [liblapzt.integer.i16.to.i64(value), fill]
}

// Converts self to i32, truncating or sign extending.
liblapzt.integer.i128.to.i32 = (self: liblapzt.integer.i128) liblapzt.integer.i32 {
    [low, high] = self
    liblapzt.integer.i64.to.i32(low)
}

// Converts an i32 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i32 = (value: liblapzt.integer.i32) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i32.less_than(value, liblapzt.integer.i32.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [liblapzt.integer.i32.to.i64(value), fill]
}

// Converts self to i64, truncating or sign extending.
liblapzt.integer.i128.to.i64 = (self: liblapzt.integer.i128) liblapzt.integer.i64 {
    [low, high] = self
    low
}

// Converts an i64 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i64 = (value: liblapzt.integer.i64) liblapzt.integer.i128 {
    sign: liblapzt.boolean = liblapzt.integer.i64.less_than(value, liblapzt.integer.i64.ZERO)
    fill: liblapzt.integer.u64 = BRANCH (sign) { liblapzt.integer.u64.MAX } { liblapzt.integer.u64.MIN }
    [value, fill]
}

// Converts self to i128, truncating or sign extending.
liblapzt.integer.i128.to.i128 = (self: liblapzt.integer.i128) liblapzt.integer.i128 {
    self
}

// Converts an i128 to liblapzt.integer.i128, truncating or sign extending.
liblapzt.integer.i128.from.i128 = (value: liblapzt.integer.i128) liblapzt.integer.i128 {
    value
}
