liblapzt.i4.erased = [liblapzt.i2.erased, liblapzt.i2.erased]

// A signed 4-bit integer stored in two's complement form.
liblapzt.i4 = liblapzt.i4.erased

liblapzt.i4.zero.erased: liblapzt.i4.erased = [liblapzt.i2.zero.erased, liblapzt.i2.zero.erased]
liblapzt.i4.one.erased: liblapzt.i4.erased = [liblapzt.i2.one.erased, liblapzt.i2.zero.erased]
liblapzt.i4.minimum.erased: liblapzt.i4.erased = [liblapzt.i2.zero.erased, liblapzt.i2.minimum.erased]
liblapzt.i4.maximum.erased: liblapzt.i4.erased = [liblapzt.u2.maximum.erased, liblapzt.i2.maximum.erased]

// The value 0.
liblapzt.i4.zero: liblapzt.i4 = liblapzt.i4.zero.erased
// The value 1.
liblapzt.i4.one: liblapzt.i4 = liblapzt.i4.one.erased
// The most negative value, -2^(N-1).
liblapzt.i4.minimum: liblapzt.i4 = liblapzt.i4.minimum.erased
// The largest positive value, 2^(N-1) - 1.
liblapzt.i4.maximum: liblapzt.i4 = liblapzt.i4.maximum.erased

// Reinterprets the bit pattern as unsigned; negative values map to
// values at or above 2^(N-1).
liblapzt.i4.to.u4 = (a: liblapzt.i4) liblapzt.u4 {
    [low, high] = a
    [liblapzt.i2.to.u2(low), liblapzt.i2.to.u2(high)]
