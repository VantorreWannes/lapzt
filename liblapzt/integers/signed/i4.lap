// Returns the larger of a and b under signed ordering.
liblapzt.i4.max = liblapzt.i4.max.erased

liblapzt.i4.inc.erased = (a: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.add(a, liblapzt.i4.one)
}

// Returns a + 1, wrapping from maximum to minimum.
liblapzt.i4.inc = liblapzt.i4.inc.erased

liblapzt.i4.dec.erased = (a: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.sub(a, liblapzt.i4.one)
}

// Returns a - 1, wrapping from minimum to maximum.
liblapzt.i4.dec = liblapzt.i4.dec.erased

liblapzt.i4.is.zero.erased = (a: liblapzt.i4) liblapzt.bool {
    liblapzt.u4.is.zero(liblapzt.i4.to.u4(a))
}

// Returns true when a is zero.
liblapzt.i4.is.zero = liblapzt.i4.is.zero.erased

liblapzt.i4.is.one.erased = (a: liblapzt.i4) liblapzt.bool {
    liblapzt.u4.is.one(liblapzt.i4.to.u4(a))
}

// Returns true when a equals one.
liblapzt.i4.is.one = liblapzt.i4.is.one.erased

liblapzt.i4.to.bool.erased = (a: liblapzt.i4) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i4.is.zero(a))
}

// Returns false when a is zero and true otherwise.
liblapzt.i4.to.bool = liblapzt.i4.to.bool.erased

liblapzt.i4.neg.erased = (a: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.inc(liblapzt.i4.not(a))
}

// Returns the two's complement negation of a, wrapping so that
// negating minimum yields minimum.
liblapzt.i4.neg = liblapzt.i4.neg.erased

liblapzt.i4.abs.erased = (a: liblapzt.i4) liblapzt.i4 {
    negative: liblapzt.bool = liblapzt.i4.sign(a)
    BRANCH (negative) {
        liblapzt.i4.neg(a)
    } {
        a
    }
}

// Returns the absolute value of a; the absolute value of minimum
// wraps back to minimum.
liblapzt.i4.abs = liblapzt.i4.abs.erased

liblapzt.i4.div.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    zero: liblapzt.bool = liblapzt.i4.is.zero(b)
    BRANCH (zero) {
        liblapzt.i4.zero
    } {
        negative: liblapzt.bool = liblapzt.bool.xor(liblapzt.i4.sign(a), liblapzt.i4.sign(b))
        magnitude: liblapzt.u4 = liblapzt.u4.div(liblapzt.i4.to.u4(liblapzt.i4.abs(a)), liblapzt.i4.to.u4(liblapzt.i4.abs(b)))
        quotient: liblapzt.i4 = liblapzt.i4.from.u4(magnitude)
        BRANCH (negative) {
            liblapzt.i4.neg(quotient)
        } {
            quotient
        }
    }
}

// Returns a divided by b, truncating toward zero. Returns zero when b
// is zero; minimum divided by -1 wraps to minimum.
liblapzt.i4.div = liblapzt.i4.div.erased

liblapzt.i4.mod.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    zero: liblapzt.bool = liblapzt.i4.is.zero(b)
    BRANCH (zero) {
        liblapzt.i4.zero
    } {
        negative: liblapzt.bool = liblapzt.i4.sign(a)
        magnitude: liblapzt.u4 = liblapzt.u4.mod(liblapzt.i4.to.u4(liblapzt.i4.abs(a)), liblapzt.i4.to.u4(liblapzt.i4.abs(b)))
        remainder: liblapzt.i4 = liblapzt.i4.from.u4(magnitude)
        BRANCH (negative) {
            liblapzt.i4.neg(remainder)
