// Reinterprets an unsigned bit pattern as signed; values at or above
// 2^(N-1) become negative.
liblapzt.i4.from.u4 = (a: liblapzt.u4) liblapzt.i4 {
    [low, high] = a
    [liblapzt.i2.from.u2(low), liblapzt.i2.from.u2(high)]
}

liblapzt.i4.from.bool.erased = (a: liblapzt.bool) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.from.bool(a))
}

// Returns one when a is true and zero otherwise.
liblapzt.i4.from.bool = liblapzt.i4.from.bool.erased

liblapzt.i4.not.erased = (a: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.not(liblapzt.i4.to.u4(a)))
}

// Returns the bitwise complement of a; equals -a - 1.
liblapzt.i4.not = liblapzt.i4.not.erased

liblapzt.i4.and.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.and(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise AND of a and b.
liblapzt.i4.and = liblapzt.i4.and.erased

liblapzt.i4.or.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.or(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise OR of a and b.
liblapzt.i4.or = liblapzt.i4.or.erased

liblapzt.i4.xor.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.xor(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise XOR of a and b.
liblapzt.i4.xor = liblapzt.i4.xor.erased

liblapzt.i4.nand.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.nand(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise complement of a AND b.
liblapzt.i4.nand = liblapzt.i4.nand.erased

liblapzt.i4.nor.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.nor(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise complement of a OR b.
liblapzt.i4.nor = liblapzt.i4.nor.erased

liblapzt.i4.xnor.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.xnor(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the bitwise complement of a XOR b; true per bit where equal.
liblapzt.i4.xnor = liblapzt.i4.xnor.erased

liblapzt.i4.add.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.add(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns a + b, wrapping modulo 2^N on overflow.
liblapzt.i4.add = liblapzt.i4.add.erased

liblapzt.i4.sub.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.sub(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns a - b, wrapping modulo 2^N on underflow.
liblapzt.i4.sub = liblapzt.i4.sub.erased

liblapzt.i4.mul.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.mul(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b)))
}

// Returns the low N bits of a * b, wrapping modulo 2^N.
liblapzt.i4.mul = liblapzt.i4.mul.erased

// Returns [a + b, carry] where carry is the carry out of the top bit.
liblapzt.i4.add.carry = (a: liblapzt.i4, b: liblapzt.i4) [liblapzt.i4, liblapzt.bool] {
    [sum, carry] = liblapzt.u4.add.carry(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b))
    [liblapzt.i4.from.u4(sum), carry]
}

// Returns [a - b, borrow], where borrow is the borrow out of the
// top bit.
liblapzt.i4.sub.borrow = (a: liblapzt.i4, b: liblapzt.i4) [liblapzt.i4, liblapzt.bool] {
    [difference, borrow] = liblapzt.u4.sub.borrow(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b))
    [liblapzt.i4.from.u4(difference), borrow]
}

// Returns [a + b + c mod 2^N, carry] where carry is 0, 1, or 2.
liblapzt.i4.add3 = (a: liblapzt.i4, b: liblapzt.i4, c: liblapzt.i4) [liblapzt.i4, liblapzt.i4] {
    [s1, c1] = liblapzt.i4.add.carry(a, b)
    [s2, c2] = liblapzt.i4.add.carry(s1, c)
    carry: liblapzt.i4 = liblapzt.i4.add(liblapzt.i4.from.bool(c1), liblapzt.i4.from.bool(c2))
    [s2, carry]
}

// Returns the full double-width product as [low, high] halves.
liblapzt.i4.mul.full = (a: liblapzt.i4, b: liblapzt.i4) [liblapzt.i4, liblapzt.i4] {
    [low, high] = liblapzt.u4.mul.full(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b))
    [liblapzt.i4.from.u4(low), liblapzt.i4.from.u4(high)]
}

// Returns a shifted left by one bit, filling the low bit with zero.
liblapzt.i4.shl1 = (a: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.shl1(liblapzt.i4.to.u4(a)))
}

// Returns a with its least significant bit replaced by bit.
liblapzt.i4.with.lsb = (a: liblapzt.i4, bit: liblapzt.bool) liblapzt.i4 {
    liblapzt.i4.from.u4(liblapzt.u4.with.lsb(liblapzt.i4.to.u4(a), bit))
}

// Returns the most significant bit of a as a one-bit value.
liblapzt.i4.msb = (a: liblapzt.i4) liblapzt.u1 {
    [low, high] = a
    liblapzt.i2.msb(high)
}

liblapzt.i4.sign.erased = (a: liblapzt.i4) liblapzt.bool {
    [low, high] = a
    liblapzt.i2.sign(high)
}

// Returns true when the sign bit is set, meaning a is negative.
liblapzt.i4.sign = liblapzt.i4.sign.erased

liblapzt.i4.is.negative.erased = (a: liblapzt.i4) liblapzt.bool {
    liblapzt.i4.sign(a)
}

// Returns true when a is less than zero.
liblapzt.i4.is.negative = liblapzt.i4.is.negative.erased

liblapzt.i4.eq.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    liblapzt.u4.eq(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b))
}

// Returns true when a and b have the same bit pattern.
liblapzt.i4.eq = liblapzt.i4.eq.erased

liblapzt.i4.ne.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i4.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.i4.ne = liblapzt.i4.ne.erased

liblapzt.i4.lt.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    a.negative: liblapzt.bool = liblapzt.i4.sign(a)
    b.negative: liblapzt.bool = liblapzt.i4.sign(b)
    differ: liblapzt.bool = liblapzt.bool.xor(a.negative, b.negative)
    BRANCH (differ) {
        a.negative
    } {
        liblapzt.u4.lt(liblapzt.i4.to.u4(a), liblapzt.i4.to.u4(b))
    }
}

// Returns true when a is less than b under signed ordering.
liblapzt.i4.lt = liblapzt.i4.lt.erased

liblapzt.i4.le.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    liblapzt.bool.or(liblapzt.i4.lt(a, b), liblapzt.i4.eq(a, b))
}

// Returns true when a is less than or equal to b.
liblapzt.i4.le = liblapzt.i4.le.erased

liblapzt.i4.gt.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    liblapzt.i4.lt(b, a)
}

// Returns true when a is greater than b.
liblapzt.i4.gt = liblapzt.i4.gt.erased

liblapzt.i4.ge.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.bool {
    liblapzt.i4.le(b, a)
}

// Returns true when a is greater than or equal to b.
liblapzt.i4.ge = liblapzt.i4.ge.erased

liblapzt.i4.select.erased = (flag: liblapzt.bool, when.true: liblapzt.i4, when.false: liblapzt.i4) liblapzt.i4 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.i2.select(flag, tl, fl), liblapzt.i2.select(flag, th, fh)]
}

// Returns when.true when flag is true, otherwise when.false.
liblapzt.i4.select = liblapzt.i4.select.erased

liblapzt.i4.min.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.select(liblapzt.i4.lt(a, b), a, b)
}

// Returns the smaller of a and b under signed ordering.
liblapzt.i4.min = liblapzt.i4.min.erased

liblapzt.i4.max.erased = (a: liblapzt.i4, b: liblapzt.i4) liblapzt.i4 {
    liblapzt.i4.select(liblapzt.i4.gt(a, b), a, b)
