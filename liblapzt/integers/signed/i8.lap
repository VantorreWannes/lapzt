// Returns the bitwise complement of a OR b.
liblapzt.i8.nor = liblapzt.i8.nor.erased

liblapzt.i8.xnor.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.xnor(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b)))
