// Returns the low N bits of a * b, wrapping modulo 2^N.
liblapzt.i8.mul = liblapzt.i8.mul.erased

// Returns [a + b, carry] where carry is the carry out of the top bit.
liblapzt.i8.add.carry = (a: liblapzt.i8, b: liblapzt.i8) [liblapzt.i8, liblapzt.bool] {
