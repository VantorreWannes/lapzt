// Returns true when a and b have the same bit pattern.
liblapzt.i8.eq = liblapzt.i8.eq.erased

liblapzt.i8.ne.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i8.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.i8.ne = liblapzt.i8.ne.erased

liblapzt.i8.lt.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.bool {
    a.negative: liblapzt.bool = liblapzt.i8.sign(a)
    b.negative: liblapzt.bool = liblapzt.i8.sign(b)
    differ: liblapzt.bool = liblapzt.bool.xor(a.negative, b.negative)
    BRANCH (differ) {
        a.negative
    } {
