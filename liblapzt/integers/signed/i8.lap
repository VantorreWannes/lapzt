liblapzt.i8.sub.borrow = (a: liblapzt.i8, b: liblapzt.i8) [liblapzt.i8, liblapzt.bool] {
    [difference, borrow] = liblapzt.u8.sub.borrow(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b))
    [liblapzt.i8.from.u8(difference), borrow]
}

// Returns [a + b + c mod 2^N, carry] where carry is 0, 1, or 2.
liblapzt.i8.add3 = (a: liblapzt.i8, b: liblapzt.i8, c: liblapzt.i8) [liblapzt.i8, liblapzt.i8] {
    [s1, c1] = liblapzt.i8.add.carry(a, b)
    [s2, c2] = liblapzt.i8.add.carry(s1, c)
    carry: liblapzt.i8 = liblapzt.i8.add(liblapzt.i8.from.bool(c1), liblapzt.i8.from.bool(c2))
    [s2, carry]
}

// Returns the full double-width product as [low, high] halves.
liblapzt.i8.mul.full = (a: liblapzt.i8, b: liblapzt.i8) [liblapzt.i8, liblapzt.i8] {
    [low, high] = liblapzt.u8.mul.full(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b))
    [liblapzt.i8.from.u8(low), liblapzt.i8.from.u8(high)]
}

// Returns a shifted left by one bit, filling the low bit with zero.
liblapzt.i8.shl1 = (a: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.shl1(liblapzt.i8.to.u8(a)))
}

// Returns a with its least significant bit replaced by bit.
liblapzt.i8.with.lsb = (a: liblapzt.i8, bit: liblapzt.bool) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.with.lsb(liblapzt.i8.to.u8(a), bit))
}

// Returns the most significant bit of a as a one-bit value.
liblapzt.i8.msb = (a: liblapzt.i8) liblapzt.u1 {
    [low, high] = a
    liblapzt.i4.msb(high)
}

liblapzt.i8.sign.erased = (a: liblapzt.i8) liblapzt.bool {
    [low, high] = a
    liblapzt.i4.sign(high)
}

// Returns true when the sign bit is set, meaning a is negative.
liblapzt.i8.sign = liblapzt.i8.sign.erased

liblapzt.i8.is.negative.erased = (a: liblapzt.i8) liblapzt.bool {
    liblapzt.i8.sign(a)
}

// Returns true when a is less than zero.
liblapzt.i8.is.negative = liblapzt.i8.is.negative.erased

liblapzt.i8.eq.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.bool {
    liblapzt.u8.eq(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b))
