liblapzt.i8.neg = liblapzt.i8.neg.erased

liblapzt.i8.abs.erased = (a: liblapzt.i8) liblapzt.i8 {
    negative: liblapzt.bool = liblapzt.i8.sign(a)
    BRANCH (negative) {
        liblapzt.i8.neg(a)
