// Returns the bitwise complement of a AND b.
liblapzt.i8.nand = liblapzt.i8.nand.erased

liblapzt.i8.nor.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.nor(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b)))
