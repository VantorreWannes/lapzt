// Returns a - 1, wrapping from minimum to maximum.
liblapzt.i8.dec = liblapzt.i8.dec.erased

liblapzt.i8.is.zero.erased = (a: liblapzt.i8) liblapzt.bool {
    liblapzt.u8.is.zero(liblapzt.i8.to.u8(a))
}

// Returns true when a is zero.
liblapzt.i8.is.zero = liblapzt.i8.is.zero.erased

liblapzt.i8.is.one.erased = (a: liblapzt.i8) liblapzt.bool {
    liblapzt.u8.is.one(liblapzt.i8.to.u8(a))
