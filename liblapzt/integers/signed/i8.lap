// Returns true when a is greater than or equal to b.
liblapzt.i8.ge = liblapzt.i8.ge.erased

liblapzt.i8.select.erased = (flag: liblapzt.bool, when.true: liblapzt.i8, when.false: liblapzt.i8) liblapzt.i8 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.i4.select(flag, tl, fl), liblapzt.i4.select(flag, th, fh)]
