}

// Returns true when a is less than b under signed ordering.
liblapzt.i8.lt = liblapzt.i8.lt.erased

liblapzt.i8.le.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.bool {
    liblapzt.bool.or(liblapzt.i8.lt(a, b), liblapzt.i8.eq(a, b))
