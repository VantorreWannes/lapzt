// Returns true when a equals one.
liblapzt.i8.is.one = liblapzt.i8.is.one.erased

liblapzt.i8.to.bool.erased = (a: liblapzt.i8) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i8.is.zero(a))
}

// Returns false when a is zero and true otherwise.
liblapzt.i8.to.bool = liblapzt.i8.to.bool.erased

liblapzt.i8.neg.erased = (a: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.inc(liblapzt.i8.not(a))
