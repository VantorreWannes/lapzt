liblapzt.i8.zero.erased: liblapzt.i8.erased = [liblapzt.i4.zero.erased, liblapzt.i4.zero.erased]
liblapzt.i8.one.erased: liblapzt.i8.erased = [liblapzt.i4.one.erased, liblapzt.i4.zero.erased]
