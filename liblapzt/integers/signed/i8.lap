// Returns the bitwise complement of a XOR b; true per bit where equal.
liblapzt.i8.xnor = liblapzt.i8.xnor.erased

liblapzt.i8.add.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.add(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b)))
}

// Returns a + b, wrapping modulo 2^N on overflow.
liblapzt.i8.add = liblapzt.i8.add.erased

liblapzt.i8.sub.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.sub(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b)))
}

// Returns a - b, wrapping modulo 2^N on underflow.
liblapzt.i8.sub = liblapzt.i8.sub.erased

liblapzt.i8.mul.erased = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.i8 {
    liblapzt.i8.from.u8(liblapzt.u8.mul(liblapzt.i8.to.u8(a), liblapzt.i8.to.u8(b)))
