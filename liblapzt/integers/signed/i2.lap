// Returns [a - b, borrow], where borrow is the borrow out of the
// top bit.
liblapzt.i2.sub.borrow = (a: liblapzt.i2, b: liblapzt.i2) [liblapzt.i2, liblapzt.bool] {
    [difference, borrow] = liblapzt.u2.sub.borrow(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b))
    [liblapzt.i2.from.u2(difference), borrow]
}

// Returns [a + b + c mod 2^N, carry] where carry is 0, 1, or 2.
liblapzt.i2.add3 = (a: liblapzt.i2, b: liblapzt.i2, c: liblapzt.i2) [liblapzt.i2, liblapzt.i2] {
    [s1, c1] = liblapzt.i2.add.carry(a, b)
    [s2, c2] = liblapzt.i2.add.carry(s1, c)
    carry: liblapzt.i2 = liblapzt.i2.add(liblapzt.i2.from.bool(c1), liblapzt.i2.from.bool(c2))
    [s2, carry]
}

// Returns the full double-width product as [low, high] halves.
liblapzt.i2.mul.full = (a: liblapzt.i2, b: liblapzt.i2) [liblapzt.i2, liblapzt.i2] {
    [low, high] = liblapzt.u2.mul.full(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b))
    [liblapzt.i2.from.u2(low), liblapzt.i2.from.u2(high)]
}

// Returns a shifted left by one bit, filling the low bit with zero.
liblapzt.i2.shl1 = (a: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.shl1(liblapzt.i2.to.u2(a)))
}

// Returns a with its least significant bit replaced by bit.
liblapzt.i2.with.lsb = (a: liblapzt.i2, bit: liblapzt.bool) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.with.lsb(liblapzt.i2.to.u2(a), bit))
}

// Returns the most significant bit of a as a one-bit value.
liblapzt.i2.msb = (a: liblapzt.i2) liblapzt.u1 {
    [low, high] = a
    high
}

liblapzt.i2.sign.erased = (a: liblapzt.i2) liblapzt.bool {
    [low, high] = a
    high
}

// Returns true when the sign bit is set, meaning a is negative.
liblapzt.i2.sign = liblapzt.i2.sign.erased

liblapzt.i2.is.negative.erased = (a: liblapzt.i2) liblapzt.bool {
    liblapzt.i2.sign(a)
}

// Returns true when a is less than zero.
liblapzt.i2.is.negative = liblapzt.i2.is.negative.erased

liblapzt.i2.eq.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    liblapzt.u2.eq(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b))
