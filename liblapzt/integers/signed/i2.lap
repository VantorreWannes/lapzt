// Returns a - 1, wrapping from minimum to maximum.
liblapzt.i2.dec = liblapzt.i2.dec.erased

liblapzt.i2.is.zero.erased = (a: liblapzt.i2) liblapzt.bool {
    liblapzt.u2.is.zero(liblapzt.i2.to.u2(a))
}

// Returns true when a is zero.
liblapzt.i2.is.zero = liblapzt.i2.is.zero.erased

liblapzt.i2.is.one.erased = (a: liblapzt.i2) liblapzt.bool {
    liblapzt.u2.is.one(liblapzt.i2.to.u2(a))
}

// Returns true when a equals one.
liblapzt.i2.is.one = liblapzt.i2.is.one.erased

liblapzt.i2.to.bool.erased = (a: liblapzt.i2) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i2.is.zero(a))
}

// Returns false when a is zero and true otherwise.
liblapzt.i2.to.bool = liblapzt.i2.to.bool.erased

liblapzt.i2.neg.erased = (a: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.inc(liblapzt.i2.not(a))
}

// Returns the two's complement negation of a, wrapping so that
