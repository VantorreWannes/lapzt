liblapzt.i2.erased = [liblapzt.u1.erased, liblapzt.u1.erased]

// A signed 2-bit integer stored in two's complement form.
liblapzt.i2 = liblapzt.i2.erased

liblapzt.i2.zero.erased: liblapzt.i2.erased = [liblapzt.u1.zero.erased, liblapzt.u1.zero.erased]
liblapzt.i2.one.erased: liblapzt.i2.erased = [liblapzt.u1.one.erased, liblapzt.u1.zero.erased]
liblapzt.i2.minimum.erased: liblapzt.i2.erased = [liblapzt.u1.zero.erased, liblapzt.u1.one.erased]
liblapzt.i2.maximum.erased: liblapzt.i2.erased = [liblapzt.u1.one.erased, liblapzt.u1.zero.erased]

// The value 0.
liblapzt.i2.zero: liblapzt.i2 = liblapzt.i2.zero.erased
// The value 1.
liblapzt.i2.one: liblapzt.i2 = liblapzt.i2.one.erased
// The most negative value, -2^(N-1).
liblapzt.i2.minimum: liblapzt.i2 = liblapzt.i2.minimum.erased
// The largest positive value, 2^(N-1) - 1.
liblapzt.i2.maximum: liblapzt.i2 = liblapzt.i2.maximum.erased

// Reinterprets the bit pattern as unsigned; negative values map to
// values at or above 2^(N-1).
liblapzt.i2.to.u2 = (a: liblapzt.i2) liblapzt.u2 {
    [low, high] = a
    [low, high]
}

// Reinterprets an unsigned bit pattern as signed; values at or above
// 2^(N-1) become negative.
liblapzt.i2.from.u2 = (a: liblapzt.u2) liblapzt.i2 {
    [low, high] = a
    [low, high]
