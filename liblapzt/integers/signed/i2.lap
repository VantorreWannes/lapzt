liblapzt.i2.select = liblapzt.i2.select.erased

liblapzt.i2.min.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.select(liblapzt.i2.lt(a, b), a, b)
