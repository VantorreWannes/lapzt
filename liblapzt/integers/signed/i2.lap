liblapzt.i2.div = liblapzt.i2.div.erased

liblapzt.i2.mod.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    zero: liblapzt.bool = liblapzt.i2.is.zero(b)
    BRANCH (zero) {
        liblapzt.i2.zero
    } {
        negative: liblapzt.bool = liblapzt.i2.sign(a)
        magnitude: liblapzt.u2 = liblapzt.u2.mod(liblapzt.i2.to.u2(liblapzt.i2.abs(a)), liblapzt.i2.to.u2(liblapzt.i2.abs(b)))
        remainder: liblapzt.i2 = liblapzt.i2.from.u2(magnitude)
