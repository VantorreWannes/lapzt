// Returns the bitwise AND of a and b.
liblapzt.i2.and = liblapzt.i2.and.erased

liblapzt.i2.or.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.or(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns the bitwise OR of a and b.
liblapzt.i2.or = liblapzt.i2.or.erased

liblapzt.i2.xor.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.xor(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns the bitwise XOR of a and b.
liblapzt.i2.xor = liblapzt.i2.xor.erased

liblapzt.i2.nand.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.nand(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns the bitwise complement of a AND b.
liblapzt.i2.nand = liblapzt.i2.nand.erased

liblapzt.i2.nor.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.nor(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns the bitwise complement of a OR b.
liblapzt.i2.nor = liblapzt.i2.nor.erased

liblapzt.i2.xnor.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.xnor(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns the bitwise complement of a XOR b; true per bit where equal.
liblapzt.i2.xnor = liblapzt.i2.xnor.erased

liblapzt.i2.add.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.add(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns a + b, wrapping modulo 2^N on overflow.
liblapzt.i2.add = liblapzt.i2.add.erased

liblapzt.i2.sub.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.sub(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
}

// Returns a - b, wrapping modulo 2^N on underflow.
liblapzt.i2.sub = liblapzt.i2.sub.erased

liblapzt.i2.mul.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.from.u2(liblapzt.u2.mul(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b)))
