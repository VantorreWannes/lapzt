//! 2-bit signed integer type, stored in two's complement form

// --- Erased ---

__liblapzt.integer.i2.erased = [liblapzt.integer.u1, liblapzt.integer.u1]
__liblapzt.integer.i2.MIN.erased = [liblapzt.integer.u1.MIN, liblapzt.integer.u1.MAX]
__liblapzt.integer.i2.MAX.erased = [liblapzt.integer.u1.MAX, liblapzt.integer.u1.MIN]
__liblapzt.integer.i2.ZERO.erased = [liblapzt.integer.u1.MIN, liblapzt.integer.u1.MIN]

// --- Types ---

liblapzt.integer.i2 = __liblapzt.integer.i2.erased
liblapzt.integer.i2.MIN = __liblapzt.integer.i2.MIN.erased
liblapzt.integer.i2.MAX = __liblapzt.integer.i2.MAX.erased
liblapzt.integer.i2.ZERO = __liblapzt.integer.i2.ZERO.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.i2.not = (self: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [liblapzt.integer.u1.not(self_low), liblapzt.integer.u1.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.i2.and = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.and(self_low, other_low), liblapzt.integer.u1.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.i2.or = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.or(self_low, other_low), liblapzt.integer.u1.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.i2.not.and = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.not.and(self_low, other_low), liblapzt.integer.u1.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.i2.not.or = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.not.or(self_low, other_low), liblapzt.integer.u1.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.i2.exclusive.or = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.exclusive.or(self_low, other_low), liblapzt.integer.u1.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.i2.equal = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.i2.not.equal = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u1.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u1.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is less than other under signed ordering.
liblapzt.integer.i2.less_than = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.boolean.and(self_high, liblapzt.boolean.not(other_high))
    high_equal: liblapzt.boolean = liblapzt.boolean.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u1.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns true when self is greater than other under signed ordering.
liblapzt.integer.i2.greater_than = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.boolean {
    liblapzt.integer.i2.less_than(other, self)
}

// Returns the smaller of self and other under signed ordering.
liblapzt.integer.i2.min = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    less: liblapzt.boolean = liblapzt.integer.i2.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other under signed ordering.
liblapzt.integer.i2.max = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    greater: liblapzt.boolean = liblapzt.integer.i2.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^2.
liblapzt.integer.i2.add.wrapping = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u1 = liblapzt.integer.u1.and(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and the
// value is then MIN.
liblapzt.integer.i2.add.checked = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.boolean, liblapzt.integer.i2] {
    sum: liblapzt.integer.i2 = liblapzt.integer.i2.add.wrapping(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(other, liblapzt.integer.i2.ZERO)
    sum_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(sum, liblapzt.integer.i2.ZERO)
    same_sign: liblapzt.boolean = liblapzt.boolean.equal(self_negative, other_negative)
    changed: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, sum_negative)
    overflow: liblapzt.boolean = liblapzt.boolean.and(same_sign, changed)
    BRANCH (overflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i2.MIN]
    } {
        [liblapzt.boolean.TRUE, sum]
    }
}

// Returns the sum of self and other, saturated at MAX or MIN.
liblapzt.integer.i2.add.saturating = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [ok, sum] = liblapzt.integer.i2.add.checked(self, other)
    BRANCH (ok) {
        sum
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
        BRANCH (self_negative) { liblapzt.integer.i2.MIN } { liblapzt.integer.i2.MAX }
    }
}

// Returns the difference of self and other modulo 2^2.
liblapzt.integer.i2.subtract.wrapping = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u1.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// overflows, and the value is then MIN.
liblapzt.integer.i2.subtract.checked = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.boolean, liblapzt.integer.i2] {
    difference: liblapzt.integer.i2 = liblapzt.integer.i2.subtract.wrapping(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(other, liblapzt.integer.i2.ZERO)
    difference_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(difference, liblapzt.integer.i2.ZERO)
    differ: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, other_negative)
    changed: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, difference_negative)
    overflow: liblapzt.boolean = liblapzt.boolean.and(differ, changed)
    BRANCH (overflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i2.MIN]
    } {
        [liblapzt.boolean.TRUE, difference]
    }
}

// Returns the difference of self and other, saturated at MAX or MIN.
liblapzt.integer.i2.subtract.saturating = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [ok, difference] = liblapzt.integer.i2.subtract.checked(self, other)
    BRANCH (ok) {
        difference
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
        BRANCH (self_negative) { liblapzt.integer.i2.MIN } { liblapzt.integer.i2.MAX }
    }
}

// Returns the full 2*2-bit product of self and other as a pair
// [low, high].
liblapzt.integer.i2.multiply.full = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.integer.i2, liblapzt.integer.i2] {
    [low, high] = liblapzt.integer.u2.multiply.full(self, other)
    self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
    other_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(other, liblapzt.integer.i2.ZERO)
    high_1: liblapzt.integer.u2 = BRANCH (self_negative) {
        liblapzt.integer.u2.subtract.wrapping(high, other)
    } {
        high
    }
    high_2: liblapzt.integer.u2 = BRANCH (other_negative) {
        liblapzt.integer.u2.subtract.wrapping(high_1, self)
    } {
        high_1
    }
    [low, high_2]
}

// Returns the low 2 bits of the product of self and other.
liblapzt.integer.i2.multiply.wrapping = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [low, high] = liblapzt.integer.i2.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.i2.multiply.checked = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.boolean, liblapzt.integer.i2] {
    [low, high] = liblapzt.integer.i2.multiply.full(self, other)
    sign: liblapzt.boolean = liblapzt.integer.i2.less_than(low, liblapzt.integer.i2.ZERO)
    fill: liblapzt.integer.u2 = BRANCH (sign) { liblapzt.integer.u2.MAX } { liblapzt.integer.u2.MIN }
    [liblapzt.integer.u2.equal(high, fill), low]
}

// Returns the product of self and other, saturated at MAX or MIN.
liblapzt.integer.i2.multiply.saturating = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [ok, low] = liblapzt.integer.i2.multiply.checked(self, other)
    BRANCH (ok) {
        low
    } {
        negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
        other_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(other, liblapzt.integer.i2.ZERO)
        differ: liblapzt.boolean = liblapzt.boolean.not.equal(negative, other_negative)
        BRANCH (differ) { liblapzt.integer.i2.MIN } { liblapzt.integer.i2.MAX }
    }
}

// Returns [quotient, remainder] of self divided by other, truncating
// toward zero. Returns [MAX, MIN] when other is zero.
liblapzt.integer.i2.divide.full = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.integer.i2, liblapzt.integer.i2] {
    zero: liblapzt.boolean = liblapzt.integer.i2.equal(other, liblapzt.integer.i2.ZERO)
    BRANCH (zero) {
        [liblapzt.integer.i2.MAX, liblapzt.integer.i2.MIN]
    } {
        self_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
        other_negative: liblapzt.boolean = liblapzt.integer.i2.less_than(other, liblapzt.integer.i2.ZERO)
        self_magnitude: liblapzt.integer.i2 = BRANCH (self_negative) { liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, self) } { self }
        other_magnitude: liblapzt.integer.i2 = BRANCH (other_negative) { liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, other) } { other }
        [quotient_u, remainder_u] = liblapzt.integer.u2.divide.full(self_magnitude, other_magnitude)
        quotient_negative: liblapzt.boolean = liblapzt.boolean.not.equal(self_negative, other_negative)
        quotient: liblapzt.integer.i2 = BRANCH (quotient_negative) { liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, quotient_u) } { quotient_u }
        remainder: liblapzt.integer.i2 = BRANCH (self_negative) { liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, remainder_u) } { remainder_u }
        [quotient, remainder]
    }
}

// Returns self divided by other, truncating toward zero. Division by
// zero saturates to MAX; MIN divided by -1 wraps to MIN.
liblapzt.integer.i2.divide.wrapping = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [quotient, remainder] = liblapzt.integer.i2.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero or the
// quotient overflows, and the value is then MIN.
liblapzt.integer.i2.divide.checked = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.boolean, liblapzt.integer.i2] {
    zero: liblapzt.boolean = liblapzt.integer.i2.equal(other, liblapzt.integer.i2.ZERO)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i2.MIN]
    } {
        overflow: liblapzt.boolean = liblapzt.boolean.and(liblapzt.integer.i2.equal(self, liblapzt.integer.i2.MIN), liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MAX))
        BRANCH (overflow) {
            [liblapzt.boolean.FALSE, liblapzt.integer.i2.MIN]
        } {
            [quotient, remainder] = liblapzt.integer.i2.divide.full(self, other)
            [liblapzt.boolean.TRUE, quotient]
        }
    }
}

// Returns self divided by other, saturated at MAX or MIN.
liblapzt.integer.i2.divide.saturating = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    [ok, quotient] = liblapzt.integer.i2.divide.checked(self, other)
    BRANCH (ok) {
        quotient
    } {
        negative: liblapzt.boolean = liblapzt.integer.i2.less_than(self, liblapzt.integer.i2.ZERO)
        BRANCH (negative) { liblapzt.integer.i2.MIN } { liblapzt.integer.i2.MAX }
    }
}

// Returns the remainder of self divided by other, with the sign of
// self. Division by zero saturates to MAX.
liblapzt.integer.i2.remainder.wrapping = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    zero: liblapzt.boolean = liblapzt.integer.i2.equal(other, liblapzt.integer.i2.ZERO)
    BRANCH (zero) {
        liblapzt.integer.i2.MAX
    } {
        [quotient, remainder] = liblapzt.integer.i2.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.i2.remainder.saturating = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) liblapzt.integer.i2 {
    zero: liblapzt.boolean = liblapzt.integer.i2.equal(other, liblapzt.integer.i2.ZERO)
    BRANCH (zero) {
        liblapzt.integer.i2.MAX
    } {
        [quotient, remainder] = liblapzt.integer.i2.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.i2.remainder.checked = (self: liblapzt.integer.i2, other: liblapzt.integer.i2) [liblapzt.boolean, liblapzt.integer.i2] {
    zero: liblapzt.boolean = liblapzt.integer.i2.equal(other, liblapzt.integer.i2.ZERO)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.i2.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.i2.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}
