// Returns true when a and b have the same bit pattern.
liblapzt.i2.eq = liblapzt.i2.eq.erased

liblapzt.i2.ne.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i2.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.i2.ne = liblapzt.i2.ne.erased

liblapzt.i2.lt.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    a.negative: liblapzt.bool = liblapzt.i2.sign(a)
    b.negative: liblapzt.bool = liblapzt.i2.sign(b)
    differ: liblapzt.bool = liblapzt.bool.xor(a.negative, b.negative)
    BRANCH (differ) {
        a.negative
    } {
