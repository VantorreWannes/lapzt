liblapzt.i2.min = liblapzt.i2.min.erased

liblapzt.i2.max.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.i2 {
    liblapzt.i2.select(liblapzt.i2.gt(a, b), a, b)
