// Returns the low N bits of a * b, wrapping modulo 2^N.
liblapzt.i2.mul = liblapzt.i2.mul.erased

// Returns [a + b, carry] where carry is the carry out of the top bit.
liblapzt.i2.add.carry = (a: liblapzt.i2, b: liblapzt.i2) [liblapzt.i2, liblapzt.bool] {
    [sum, carry] = liblapzt.u2.add.carry(liblapzt.i2.to.u2(a), liblapzt.i2.to.u2(b))
    [liblapzt.i2.from.u2(sum), carry]
