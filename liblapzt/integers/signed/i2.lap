}

// Returns true when a is less than b under signed ordering.
liblapzt.i2.lt = liblapzt.i2.lt.erased

liblapzt.i2.le.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    liblapzt.bool.or(liblapzt.i2.lt(a, b), liblapzt.i2.eq(a, b))
}

// Returns true when a is less than or equal to b.
liblapzt.i2.le = liblapzt.i2.le.erased

liblapzt.i2.gt.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    liblapzt.i2.lt(b, a)
}

// Returns true when a is greater than b.
liblapzt.i2.gt = liblapzt.i2.gt.erased

liblapzt.i2.ge.erased = (a: liblapzt.i2, b: liblapzt.i2) liblapzt.bool {
    liblapzt.i2.le(b, a)
}

// Returns true when a is greater than or equal to b.
liblapzt.i2.ge = liblapzt.i2.ge.erased

liblapzt.i2.select.erased = (flag: liblapzt.bool, when.true: liblapzt.i2, when.false: liblapzt.i2) liblapzt.i2 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.u1.select(flag, tl, fl), liblapzt.u1.select(flag, th, fh)]
