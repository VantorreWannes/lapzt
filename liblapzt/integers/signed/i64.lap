// Returns true when a is zero.
liblapzt.i64.is.zero = liblapzt.i64.is.zero.erased

liblapzt.i64.is.one.erased = (a: liblapzt.i64) liblapzt.bool {
    liblapzt.u64.is.one(liblapzt.i64.to.u64(a))
