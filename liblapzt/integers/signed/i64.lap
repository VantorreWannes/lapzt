// Returns the bitwise OR of a and b.
liblapzt.i64.or = liblapzt.i64.or.erased

liblapzt.i64.xor.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.xor(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
}

// Returns the bitwise XOR of a and b.
liblapzt.i64.xor = liblapzt.i64.xor.erased

liblapzt.i64.nand.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.nand(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
