// Returns true when a and b have the same bit pattern.
liblapzt.i64.eq = liblapzt.i64.eq.erased

liblapzt.i64.ne.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i64.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.i64.ne = liblapzt.i64.ne.erased

liblapzt.i64.lt.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.bool {
    a.negative: liblapzt.bool = liblapzt.i64.sign(a)
    b.negative: liblapzt.bool = liblapzt.i64.sign(b)
    differ: liblapzt.bool = liblapzt.bool.xor(a.negative, b.negative)
    BRANCH (differ) {
        a.negative
