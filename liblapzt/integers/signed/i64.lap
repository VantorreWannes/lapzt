// Returns true when a equals one.
liblapzt.i64.is.one = liblapzt.i64.is.one.erased

liblapzt.i64.to.bool.erased = (a: liblapzt.i64) liblapzt.bool {
    liblapzt.bool.not(liblapzt.i64.is.zero(a))
