liblapzt.i64.sign.erased = (a: liblapzt.i64) liblapzt.bool {
    [low, high] = a
    liblapzt.i32.sign(high)
}

// Returns true when the sign bit is set, meaning a is negative.
liblapzt.i64.sign = liblapzt.i64.sign.erased

liblapzt.i64.is.negative.erased = (a: liblapzt.i64) liblapzt.bool {
    liblapzt.i64.sign(a)
}

// Returns true when a is less than zero.
liblapzt.i64.is.negative = liblapzt.i64.is.negative.erased

liblapzt.i64.eq.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.bool {
    liblapzt.u64.eq(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b))
