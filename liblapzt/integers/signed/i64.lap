// Returns the bitwise complement of a OR b.
liblapzt.i64.nor = liblapzt.i64.nor.erased

liblapzt.i64.xnor.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.xnor(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
