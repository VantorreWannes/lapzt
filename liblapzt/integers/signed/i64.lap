// Returns the low N bits of a * b, wrapping modulo 2^N.
liblapzt.i64.mul = liblapzt.i64.mul.erased

// Returns [a + b, carry] where carry is the carry out of the top bit.
liblapzt.i64.add.carry = (a: liblapzt.i64, b: liblapzt.i64) [liblapzt.i64, liblapzt.bool] {
    [sum, carry] = liblapzt.u64.add.carry(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b))
    [liblapzt.i64.from.u64(sum), carry]
