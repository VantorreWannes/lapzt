}

// Returns true when a is less than b under signed ordering.
liblapzt.i64.lt = liblapzt.i64.lt.erased

liblapzt.i64.le.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.bool {
    liblapzt.bool.or(liblapzt.i64.lt(a, b), liblapzt.i64.eq(a, b))
