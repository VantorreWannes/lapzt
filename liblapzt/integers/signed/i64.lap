liblapzt.i64.erased = [liblapzt.i32.erased, liblapzt.i32.erased]

// A signed 64-bit integer stored in two's complement form.
liblapzt.i64 = liblapzt.i64.erased

liblapzt.i64.zero.erased: liblapzt.i64.erased = [liblapzt.i32.zero.erased, liblapzt.i32.zero.erased]
liblapzt.i64.one.erased: liblapzt.i64.erased = [liblapzt.i32.one.erased, liblapzt.i32.zero.erased]
liblapzt.i64.minimum.erased: liblapzt.i64.erased = [liblapzt.i32.zero.erased, liblapzt.i32.minimum.erased]
liblapzt.i64.maximum.erased: liblapzt.i64.erased = [liblapzt.u32.maximum.erased, liblapzt.i32.maximum.erased]

// The value 0.
liblapzt.i64.zero: liblapzt.i64 = liblapzt.i64.zero.erased
// The value 1.
liblapzt.i64.one: liblapzt.i64 = liblapzt.i64.one.erased
// The most negative value, -2^(N-1).
