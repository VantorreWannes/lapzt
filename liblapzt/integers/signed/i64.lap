// Returns true when a is greater than or equal to b.
liblapzt.i64.ge = liblapzt.i64.ge.erased

liblapzt.i64.select.erased = (flag: liblapzt.bool, when.true: liblapzt.i64, when.false: liblapzt.i64) liblapzt.i64 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.i32.select(flag, tl, fl), liblapzt.i32.select(flag, th, fh)]
