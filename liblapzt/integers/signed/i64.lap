// Returns the bitwise complement of a XOR b; true per bit where equal.
liblapzt.i64.xnor = liblapzt.i64.xnor.erased

liblapzt.i64.add.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.add(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
}

// Returns a + b, wrapping modulo 2^N on overflow.
liblapzt.i64.add = liblapzt.i64.add.erased

liblapzt.i64.sub.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.sub(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
}

// Returns a - b, wrapping modulo 2^N on underflow.
liblapzt.i64.sub = liblapzt.i64.sub.erased

liblapzt.i64.mul.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.mul(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
