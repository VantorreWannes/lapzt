// Returns the bitwise complement of a AND b.
liblapzt.i64.nand = liblapzt.i64.nand.erased

liblapzt.i64.nor.erased = (a: liblapzt.i64, b: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.nor(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b)))
