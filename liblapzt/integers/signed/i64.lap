// Returns [a - b, borrow], where borrow is the borrow out of the
// top bit.
liblapzt.i64.sub.borrow = (a: liblapzt.i64, b: liblapzt.i64) [liblapzt.i64, liblapzt.bool] {
    [difference, borrow] = liblapzt.u64.sub.borrow(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b))
    [liblapzt.i64.from.u64(difference), borrow]
}

// Returns [a + b + c mod 2^N, carry] where carry is 0, 1, or 2.
liblapzt.i64.add3 = (a: liblapzt.i64, b: liblapzt.i64, c: liblapzt.i64) [liblapzt.i64, liblapzt.i64] {
    [s1, c1] = liblapzt.i64.add.carry(a, b)
    [s2, c2] = liblapzt.i64.add.carry(s1, c)
    carry: liblapzt.i64 = liblapzt.i64.add(liblapzt.i64.from.bool(c1), liblapzt.i64.from.bool(c2))
    [s2, carry]
}

// Returns the full double-width product as [low, high] halves.
liblapzt.i64.mul.full = (a: liblapzt.i64, b: liblapzt.i64) [liblapzt.i64, liblapzt.i64] {
    [low, high] = liblapzt.u64.mul.full(liblapzt.i64.to.u64(a), liblapzt.i64.to.u64(b))
    [liblapzt.i64.from.u64(low), liblapzt.i64.from.u64(high)]
}

// Returns a shifted left by one bit, filling the low bit with zero.
liblapzt.i64.shl1 = (a: liblapzt.i64) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.shl1(liblapzt.i64.to.u64(a)))
}

// Returns a with its least significant bit replaced by bit.
liblapzt.i64.with.lsb = (a: liblapzt.i64, bit: liblapzt.bool) liblapzt.i64 {
    liblapzt.i64.from.u64(liblapzt.u64.with.lsb(liblapzt.i64.to.u64(a), bit))
}

// Returns the most significant bit of a as a one-bit value.
liblapzt.i64.msb = (a: liblapzt.i64) liblapzt.u1 {
    [low, high] = a
    liblapzt.i32.msb(high)
