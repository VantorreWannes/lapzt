        magnitude: liblapzt.u64 = liblapzt.u64.div(liblapzt.i64.to.u64(liblapzt.i64.abs(a)), liblapzt.i64.to.u64(liblapzt.i64.abs(b)))
        quotient: liblapzt.i64 = liblapzt.i64.from.u64(magnitude)
