// Returns the full 64-bit product of a and b as a pair
// [low, high].
liblapzt.u32.mul.full = (a: liblapzt.u32, b: liblapzt.u32) [liblapzt.u32, liblapzt.u32] {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u16.mul.full(al, bl)
    [cl, ch] = liblapzt.u16.mul.full(al, bh)
    [dl, dh] = liblapzt.u16.mul.full(ah, bl)
    [el, eh] = liblapzt.u16.mul.full(ah, bh)
    [low.sum, low.carry] = liblapzt.u16.add3(lh, cl, dl)
    low: liblapzt.u32 = [ll, low.sum]
    [high.sum, high.carry] = liblapzt.u16.add3(ch, dh, el)
    [high.sum2, high.carry2] = liblapzt.u16.add.carry(high.sum, low.carry)
    high.high: liblapzt.u16 = liblapzt.u16.add(liblapzt.u16.add(eh, high.carry), liblapzt.u16.from.bool(high.carry2))
    high: liblapzt.u32 = [high.sum2, high.high]
    [low, high]
}

liblapzt.u32.mul.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u16.mul.full(al, bl)
    cross: liblapzt.u16 = liblapzt.u16.add(liblapzt.u16.mul(al, bh), liblapzt.u16.mul(ah, bl))
    [ll, liblapzt.u16.add(lh, cross)]
}

// Returns the low 32 bits of the product of a and b, discarding the
// high half.
liblapzt.u32.mul = liblapzt.u32.mul.erased

// Returns a shifted left by one bit. The top bit is discarded and
// the low bit becomes zero.
liblapzt.u32.shl1 = (a: liblapzt.u32) liblapzt.u32 {
    [low, high] = a
