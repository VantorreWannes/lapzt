// Returns true when a is less than b.
liblapzt.u32.lt = liblapzt.u32.lt.erased

liblapzt.u32.le.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.bool {
    liblapzt.bool.or(liblapzt.u32.lt(a, b), liblapzt.u32.eq(a, b))
