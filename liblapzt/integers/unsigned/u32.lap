// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u32.divide.wrapping = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u32.divide.saturating = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u32.divide.checked = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.boolean, liblapzt.integer.u32] {
    zero: liblapzt.boolean = liblapzt.integer.u32.equal(other, liblapzt.integer.u32.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u32.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u32.remainder.wrapping = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    zero: liblapzt.boolean = liblapzt.integer.u32.equal(other, liblapzt.integer.u32.MIN)
    BRANCH (zero) {
        liblapzt.integer.u32.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u32.remainder.saturating = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    zero: liblapzt.boolean = liblapzt.integer.u32.equal(other, liblapzt.integer.u32.MIN)
    BRANCH (zero) {
        liblapzt.integer.u32.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u32.remainder.checked = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.boolean, liblapzt.integer.u32] {
    zero: liblapzt.boolean = liblapzt.integer.u32.equal(other, liblapzt.integer.u32.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u32.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u32.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}
