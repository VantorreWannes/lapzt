}

// Returns a with its least significant bit replaced by bit.
liblapzt.u32.with.lsb = (a: liblapzt.u32, bit: liblapzt.bool) liblapzt.u32 {
    [low, high] = a
    [liblapzt.u16.with.lsb(low, bit), high]
}

// Returns the most significant bit of a as a u1.
liblapzt.u32.msb = (a: liblapzt.u32) liblapzt.u1 {
    [low, high] = a
    liblapzt.u16.msb(high)
}

liblapzt.u32.eq.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    liblapzt.bool.and(liblapzt.u16.eq(al, bl), liblapzt.u16.eq(ah, bh))
}

// Returns true when a and b have the same value.
liblapzt.u32.eq = liblapzt.u32.eq.erased

liblapzt.u32.ne.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.bool {
