// Returns the sum of a, b and c as a pair [sum, carry].
liblapzt.u32.add3 = (a: liblapzt.u32, b: liblapzt.u32, c: liblapzt.u32) [liblapzt.u32, liblapzt.u32] {
    [s1, c1] = liblapzt.u32.add.carry(a, b)
    [s2, c2] = liblapzt.u32.add.carry(s1, c)
    carry: liblapzt.u32 = liblapzt.u32.add(liblapzt.u32.from.bool(c1), liblapzt.u32.from.bool(c2))
    [s2, carry]
