liblapzt.u32.add = liblapzt.u32.add.erased

// Returns a - b as a pair [difference, borrow], where borrow is the
// borrow out of the top bit.
liblapzt.u32.sub.borrow = (a: liblapzt.u32, b: liblapzt.u32) [liblapzt.u32, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, blw] = liblapzt.u16.sub.borrow(al, bl)
    [sh, bhw] = liblapzt.u16.sub.borrow(ah, bh)
    [sh2, bhw2] = liblapzt.u16.sub.borrow(sh, liblapzt.u16.from.bool(blw))
    [[sl, sh2], liblapzt.bool.or(bhw, bhw2)]
