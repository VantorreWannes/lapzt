//! 32-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u32.erased = [liblapzt.integer.u16, liblapzt.integer.u16]
__liblapzt.integer.u32.MIN.erased = [liblapzt.integer.u16.MIN, liblapzt.integer.u16.MIN]
__liblapzt.integer.u32.MAX.erased = [liblapzt.integer.u16.MAX, liblapzt.integer.u16.MAX]

// --- Types ---

liblapzt.integer.u32 = __liblapzt.integer.u32.erased
liblapzt.integer.u32.MIN = __liblapzt.integer.u32.MIN.erased
liblapzt.integer.u32.MAX = __liblapzt.integer.u32.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u32.not = (self: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [liblapzt.integer.u16.not(self_low), liblapzt.integer.u16.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u32.and = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u16.and(self_low, other_low), liblapzt.integer.u16.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u32.or = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u16.or(self_low, other_low), liblapzt.integer.u16.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u32.not.and = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u16.not.and(self_low, other_low), liblapzt.integer.u16.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u32.not.or = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u16.not.or(self_low, other_low), liblapzt.integer.u16.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u32.exclusive.or = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u16.exclusive.or(self_low, other_low), liblapzt.integer.u16.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u32.equal = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u16.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u16.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u32.not.equal = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u16.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u16.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u32.greater_than = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u16.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u16.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u16.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u32.less_than = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u16.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u16.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u16.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u32.min = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    less: liblapzt.boolean = liblapzt.integer.u32.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u32.max = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    greater: liblapzt.boolean = liblapzt.integer.u32.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^32.
liblapzt.integer.u32.add.wrapping = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u16 = liblapzt.integer.u16.and(self_low, other_low)
    xor_high: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u32.add.checked = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.boolean, liblapzt.integer.u32] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u16 = liblapzt.integer.u16.and(self_low, other_low)
    xor_high: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u16 = liblapzt.integer.u16.or(liblapzt.integer.u16.and(self_high, other_high), liblapzt.integer.u16.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u32.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u32.add.saturating = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [ok, sum] = liblapzt.integer.u32.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u32.MAX }
}

// Returns the difference of self and other modulo 2^32.
liblapzt.integer.u32.subtract.wrapping = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u16.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u32.subtract.checked = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.boolean, liblapzt.integer.u32] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u16.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u16.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u16.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u32.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u32.subtract.saturating = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [ok, difference] = liblapzt.integer.u32.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u32.MIN }
}

// Returns the full 2*32-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u32.multiply.full = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.integer.u32, liblapzt.integer.u32] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u16.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u32 = liblapzt.integer.u16.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u32 = liblapzt.integer.u16.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u32.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u32.add.checked([p_low, p_high], [liblapzt.integer.u16.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u16.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u32.add.checked([q_high, liblapzt.integer.u16.MIN], [r_low, r_high])
    one: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(liblapzt.integer.u32.MIN, liblapzt.integer.u32.MAX)
    high2: liblapzt.integer.u32 = BRANCH (carry_low) { liblapzt.integer.u32.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u32 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u16.MIN, liblapzt.integer.u16.MAX] } { liblapzt.integer.u32.MIN }
    high3: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 32 bits of the product of self and other.
liblapzt.integer.u32.multiply.wrapping = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [low, high] = liblapzt.integer.u32.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u32.multiply.checked = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.boolean, liblapzt.integer.u32] {
    [low, high] = liblapzt.integer.u32.multiply.full(self, other)
    [liblapzt.integer.u32.equal(high, liblapzt.integer.u32.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u32.multiply.saturating = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) liblapzt.integer.u32 {
    [ok, low] = liblapzt.integer.u32.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u32.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u32.divide.full = (self: liblapzt.integer.u32, other: liblapzt.integer.u32) [liblapzt.integer.u32, liblapzt.integer.u32] {
    zero: liblapzt.boolean = liblapzt.integer.u32.equal(other, liblapzt.integer.u32.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u32.MAX, liblapzt.integer.u32.MIN]
    } {
        [[[[[a0, a1], [a2, a3]], [[a4, a5], [a6, a7]]], [[[a8, a9], [a10, a11]], [[a12, a13], [a14, a15]]]], [[[[a16, a17], [a18, a19]], [[a20, a21], [a22, a23]]], [[[a24, a25], [a26, a27]], [[a28, a29], [a30, a31]]]]] = self
        one: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(liblapzt.integer.u32.MIN, liblapzt.integer.u32.MAX)
        mask: liblapzt.integer.u32 = liblapzt.integer.u32.not(one)
        r0: liblapzt.integer.u32 = liblapzt.integer.u32.MIN
        r1: liblapzt.integer.u32 = BRANCH (a31) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r0, r0), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r0, r0), mask) }
        q31: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r1, other))
        r2: liblapzt.integer.u32 = BRANCH (q31) { liblapzt.integer.u32.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u32 = BRANCH (a30) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r2, r2), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r2, r2), mask) }
        q30: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r3, other))
        r4: liblapzt.integer.u32 = BRANCH (q30) { liblapzt.integer.u32.subtract.wrapping(r3, other) } { r3 }
        r5: liblapzt.integer.u32 = BRANCH (a29) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r4, r4), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r4, r4), mask) }
        q29: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r5, other))
        r6: liblapzt.integer.u32 = BRANCH (q29) { liblapzt.integer.u32.subtract.wrapping(r5, other) } { r5 }
        r7: liblapzt.integer.u32 = BRANCH (a28) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r6, r6), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r6, r6), mask) }
        q28: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r7, other))
        r8: liblapzt.integer.u32 = BRANCH (q28) { liblapzt.integer.u32.subtract.wrapping(r7, other) } { r7 }
        r9: liblapzt.integer.u32 = BRANCH (a27) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r8, r8), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r8, r8), mask) }
        q27: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r9, other))
        r10: liblapzt.integer.u32 = BRANCH (q27) { liblapzt.integer.u32.subtract.wrapping(r9, other) } { r9 }
        r11: liblapzt.integer.u32 = BRANCH (a26) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r10, r10), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r10, r10), mask) }
        q26: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r11, other))
        r12: liblapzt.integer.u32 = BRANCH (q26) { liblapzt.integer.u32.subtract.wrapping(r11, other) } { r11 }
        r13: liblapzt.integer.u32 = BRANCH (a25) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r12, r12), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r12, r12), mask) }
        q25: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r13, other))
        r14: liblapzt.integer.u32 = BRANCH (q25) { liblapzt.integer.u32.subtract.wrapping(r13, other) } { r13 }
        r15: liblapzt.integer.u32 = BRANCH (a24) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r14, r14), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r14, r14), mask) }
        q24: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r15, other))
        r16: liblapzt.integer.u32 = BRANCH (q24) { liblapzt.integer.u32.subtract.wrapping(r15, other) } { r15 }
        r17: liblapzt.integer.u32 = BRANCH (a23) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r16, r16), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r16, r16), mask) }
        q23: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r17, other))
        r18: liblapzt.integer.u32 = BRANCH (q23) { liblapzt.integer.u32.subtract.wrapping(r17, other) } { r17 }
        r19: liblapzt.integer.u32 = BRANCH (a22) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r18, r18), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r18, r18), mask) }
        q22: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r19, other))
        r20: liblapzt.integer.u32 = BRANCH (q22) { liblapzt.integer.u32.subtract.wrapping(r19, other) } { r19 }
        r21: liblapzt.integer.u32 = BRANCH (a21) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r20, r20), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r20, r20), mask) }
        q21: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r21, other))
        r22: liblapzt.integer.u32 = BRANCH (q21) { liblapzt.integer.u32.subtract.wrapping(r21, other) } { r21 }
        r23: liblapzt.integer.u32 = BRANCH (a20) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r22, r22), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r22, r22), mask) }
        q20: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r23, other))
        r24: liblapzt.integer.u32 = BRANCH (q20) { liblapzt.integer.u32.subtract.wrapping(r23, other) } { r23 }
        r25: liblapzt.integer.u32 = BRANCH (a19) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r24, r24), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r24, r24), mask) }
        q19: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r25, other))
        r26: liblapzt.integer.u32 = BRANCH (q19) { liblapzt.integer.u32.subtract.wrapping(r25, other) } { r25 }
        r27: liblapzt.integer.u32 = BRANCH (a18) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r26, r26), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r26, r26), mask) }
        q18: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r27, other))
        r28: liblapzt.integer.u32 = BRANCH (q18) { liblapzt.integer.u32.subtract.wrapping(r27, other) } { r27 }
        r29: liblapzt.integer.u32 = BRANCH (a17) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r28, r28), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r28, r28), mask) }
        q17: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r29, other))
        r30: liblapzt.integer.u32 = BRANCH (q17) { liblapzt.integer.u32.subtract.wrapping(r29, other) } { r29 }
        r31: liblapzt.integer.u32 = BRANCH (a16) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r30, r30), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r30, r30), mask) }
        q16: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r31, other))
        r32: liblapzt.integer.u32 = BRANCH (q16) { liblapzt.integer.u32.subtract.wrapping(r31, other) } { r31 }
        r33: liblapzt.integer.u32 = BRANCH (a15) { liblapzt.integer.u32.or(liblapzt.integer.u32.add.wrapping(r32, r32), one) } { liblapzt.integer.u32.and(liblapzt.integer.u32.add.wrapping(r32, r32), mask) }
        q15: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u32.less_than(r33, other))
        r34: liblapzt.integer.u32 = BRANCH (q15) { liblapzt.integer.u32.subtract.wrapping(r33, other) } { r33 }
