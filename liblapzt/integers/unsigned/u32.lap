liblapzt.u32.erased = [liblapzt.u16.erased, liblapzt.u16.erased]

// A 32-bit unsigned integer stored as a pair of u16 words.
// Operations are defined in terms of the smaller word.
liblapzt.u32 = liblapzt.u32.erased

liblapzt.u32.zero.erased: liblapzt.u32.erased = [liblapzt.u16.zero.erased, liblapzt.u16.zero.erased]
liblapzt.u32.one.erased: liblapzt.u32.erased = [liblapzt.u16.one.erased, liblapzt.u16.zero.erased]
liblapzt.u32.maximum.erased: liblapzt.u32.erased = [liblapzt.u16.maximum.erased, liblapzt.u16.maximum.erased]

// The additive identity, with every bit clear.
liblapzt.u32.zero: liblapzt.u32 = liblapzt.u32.zero.erased
// The value one, with only the least significant bit set.
liblapzt.u32.one: liblapzt.u32 = liblapzt.u32.one.erased
// The largest representable value, with every bit set.
liblapzt.u32.maximum: liblapzt.u32 = liblapzt.u32.maximum.erased

liblapzt.u32.not.erased = (a: liblapzt.u32) liblapzt.u32 {
    [low, high] = a
    [liblapzt.u16.not(low), liblapzt.u16.not(high)]
}

// Returns the bitwise complement of a, flipping every bit.
liblapzt.u32.not = liblapzt.u32.not.erased

liblapzt.u32.and.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.and(al, bl), liblapzt.u16.and(ah, bh)]
}

// Returns the bitwise AND of a and b.
liblapzt.u32.and = liblapzt.u32.and.erased

liblapzt.u32.or.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.or(al, bl), liblapzt.u16.or(ah, bh)]
}

// Returns the bitwise OR of a and b.
liblapzt.u32.or = liblapzt.u32.or.erased

liblapzt.u32.xor.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.xor(al, bl), liblapzt.u16.xor(ah, bh)]
