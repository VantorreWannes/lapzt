// Returns the bitwise XOR of a and b.
liblapzt.u32.xor = liblapzt.u32.xor.erased

liblapzt.u32.nand.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.nand(al, bl), liblapzt.u16.nand(ah, bh)]
}

// Returns the bitwise NAND of a and b.
liblapzt.u32.nand = liblapzt.u32.nand.erased

liblapzt.u32.nor.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.nor(al, bl), liblapzt.u16.nor(ah, bh)]
}

// Returns the bitwise NOR of a and b.
liblapzt.u32.nor = liblapzt.u32.nor.erased

liblapzt.u32.xnor.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u16.xnor(al, bl), liblapzt.u16.xnor(ah, bh)]
}

// Returns the bitwise XNOR of a and b.
liblapzt.u32.xnor = liblapzt.u32.xnor.erased

liblapzt.u32.from.bool.erased = (a: liblapzt.bool) liblapzt.u32 {
    [liblapzt.u16.from.bool(a), liblapzt.u16.zero]
