// Returns one when a is true and zero when a is false.
liblapzt.u32.from.bool = liblapzt.u32.from.bool.erased

// Returns the sum of a and b as a pair [sum, carry], where carry is
// the carry out of the top bit.
liblapzt.u32.add.carry = (a: liblapzt.u32, b: liblapzt.u32) [liblapzt.u32, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, cl] = liblapzt.u16.add.carry(al, bl)
    [sh, ch] = liblapzt.u16.add.carry(ah, bh)
    [sh2, ch2] = liblapzt.u16.add.carry(sh, liblapzt.u16.from.bool(cl))
    [[sl, sh2], liblapzt.bool.or(ch, ch2)]
}

liblapzt.u32.add.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.u32 {
    [sum, carry] = liblapzt.u32.add.carry(a, b)
