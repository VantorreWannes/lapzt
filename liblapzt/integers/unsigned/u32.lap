}

// Returns true when a and b differ.
liblapzt.u32.ne = liblapzt.u32.ne.erased

liblapzt.u32.lt.erased = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    high.lt: liblapzt.bool = liblapzt.u16.lt(ah, bh)
    high.eq: liblapzt.bool = liblapzt.u16.eq(ah, bh)
