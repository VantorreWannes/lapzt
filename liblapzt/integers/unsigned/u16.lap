//! 16-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u16.erased = [liblapzt.integer.u8, liblapzt.integer.u8]
__liblapzt.integer.u16.MIN.erased = [liblapzt.integer.u8.MIN, liblapzt.integer.u8.MIN]
__liblapzt.integer.u16.MAX.erased = [liblapzt.integer.u8.MAX, liblapzt.integer.u8.MAX]

// --- Types ---

liblapzt.integer.u16 = __liblapzt.integer.u16.erased
liblapzt.integer.u16.MIN = __liblapzt.integer.u16.MIN.erased
liblapzt.integer.u16.MAX = __liblapzt.integer.u16.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u16.not = (self: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [liblapzt.integer.u8.not(self_low), liblapzt.integer.u8.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u16.and = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u8.and(self_low, other_low), liblapzt.integer.u8.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u16.or = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u8.or(self_low, other_low), liblapzt.integer.u8.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u16.not.and = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u8.not.and(self_low, other_low), liblapzt.integer.u8.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u16.not.or = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u8.not.or(self_low, other_low), liblapzt.integer.u8.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u16.exclusive.or = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u8.exclusive.or(self_low, other_low), liblapzt.integer.u8.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u16.equal = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u8.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u8.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u16.not.equal = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u8.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u8.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u16.greater_than = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u8.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u8.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u8.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u16.less_than = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u8.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u8.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u8.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u16.min = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    less: liblapzt.boolean = liblapzt.integer.u16.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u16.max = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    greater: liblapzt.boolean = liblapzt.integer.u16.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^16.
liblapzt.integer.u16.add.wrapping = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u8 = liblapzt.integer.u8.and(self_low, other_low)
    xor_high: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u16.add.checked = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.boolean, liblapzt.integer.u16] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u8 = liblapzt.integer.u8.and(self_low, other_low)
    xor_high: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u8 = liblapzt.integer.u8.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u8 = liblapzt.integer.u8.or(liblapzt.integer.u8.and(self_high, other_high), liblapzt.integer.u8.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u16.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u16.add.saturating = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [ok, sum] = liblapzt.integer.u16.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u16.MAX }
}

// Returns the difference of self and other modulo 2^16.
liblapzt.integer.u16.subtract.wrapping = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u8.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u16.subtract.checked = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.boolean, liblapzt.integer.u16] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u8.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u8 = liblapzt.integer.u8.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u8.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u8.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u16.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u16.subtract.saturating = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [ok, difference] = liblapzt.integer.u16.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u16.MIN }
}

// Returns the full 2*16-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u16.multiply.full = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.integer.u16, liblapzt.integer.u16] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u8.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u16 = liblapzt.integer.u8.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u16 = liblapzt.integer.u8.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u16.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u16.add.checked([p_low, p_high], [liblapzt.integer.u8.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u8.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u16.add.checked([q_high, liblapzt.integer.u8.MIN], [r_low, r_high])
    one: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(liblapzt.integer.u16.MIN, liblapzt.integer.u16.MAX)
    high2: liblapzt.integer.u16 = BRANCH (carry_low) { liblapzt.integer.u16.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u16 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u8.MIN, liblapzt.integer.u8.MAX] } { liblapzt.integer.u16.MIN }
    high3: liblapzt.integer.u16 = liblapzt.integer.u16.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 16 bits of the product of self and other.
liblapzt.integer.u16.multiply.wrapping = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [low, high] = liblapzt.integer.u16.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u16.multiply.checked = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.boolean, liblapzt.integer.u16] {
    [low, high] = liblapzt.integer.u16.multiply.full(self, other)
    [liblapzt.integer.u16.equal(high, liblapzt.integer.u16.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u16.multiply.saturating = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [ok, low] = liblapzt.integer.u16.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u16.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u16.divide.full = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.integer.u16, liblapzt.integer.u16] {
    zero: liblapzt.boolean = liblapzt.integer.u16.equal(other, liblapzt.integer.u16.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u16.MAX, liblapzt.integer.u16.MIN]
    } {
        [[[[a0, a1], [a2, a3]], [[a4, a5], [a6, a7]]], [[[a8, a9], [a10, a11]], [[a12, a13], [a14, a15]]]] = self
        one: liblapzt.integer.u16 = liblapzt.integer.u16.subtract.wrapping(liblapzt.integer.u16.MIN, liblapzt.integer.u16.MAX)
        mask: liblapzt.integer.u16 = liblapzt.integer.u16.not(one)
        r0: liblapzt.integer.u16 = liblapzt.integer.u16.MIN
        r1: liblapzt.integer.u16 = BRANCH (a15) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r0, r0), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r0, r0), mask) }
        q15: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r1, other))
        r2: liblapzt.integer.u16 = BRANCH (q15) { liblapzt.integer.u16.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u16 = BRANCH (a14) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r2, r2), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r2, r2), mask) }
        q14: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r3, other))
        r4: liblapzt.integer.u16 = BRANCH (q14) { liblapzt.integer.u16.subtract.wrapping(r3, other) } { r3 }
        r5: liblapzt.integer.u16 = BRANCH (a13) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r4, r4), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r4, r4), mask) }
        q13: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r5, other))
        r6: liblapzt.integer.u16 = BRANCH (q13) { liblapzt.integer.u16.subtract.wrapping(r5, other) } { r5 }
        r7: liblapzt.integer.u16 = BRANCH (a12) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r6, r6), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r6, r6), mask) }
        q12: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r7, other))
        r8: liblapzt.integer.u16 = BRANCH (q12) { liblapzt.integer.u16.subtract.wrapping(r7, other) } { r7 }
        r9: liblapzt.integer.u16 = BRANCH (a11) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r8, r8), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r8, r8), mask) }
        q11: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r9, other))
        r10: liblapzt.integer.u16 = BRANCH (q11) { liblapzt.integer.u16.subtract.wrapping(r9, other) } { r9 }
        r11: liblapzt.integer.u16 = BRANCH (a10) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r10, r10), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r10, r10), mask) }
        q10: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r11, other))
        r12: liblapzt.integer.u16 = BRANCH (q10) { liblapzt.integer.u16.subtract.wrapping(r11, other) } { r11 }
        r13: liblapzt.integer.u16 = BRANCH (a9) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r12, r12), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r12, r12), mask) }
        q9: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r13, other))
        r14: liblapzt.integer.u16 = BRANCH (q9) { liblapzt.integer.u16.subtract.wrapping(r13, other) } { r13 }
        r15: liblapzt.integer.u16 = BRANCH (a8) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r14, r14), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r14, r14), mask) }
        q8: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r15, other))
        r16: liblapzt.integer.u16 = BRANCH (q8) { liblapzt.integer.u16.subtract.wrapping(r15, other) } { r15 }
        r17: liblapzt.integer.u16 = BRANCH (a7) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r16, r16), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r16, r16), mask) }
        q7: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r17, other))
        r18: liblapzt.integer.u16 = BRANCH (q7) { liblapzt.integer.u16.subtract.wrapping(r17, other) } { r17 }
        r19: liblapzt.integer.u16 = BRANCH (a6) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r18, r18), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r18, r18), mask) }
        q6: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r19, other))
        r20: liblapzt.integer.u16 = BRANCH (q6) { liblapzt.integer.u16.subtract.wrapping(r19, other) } { r19 }
        r21: liblapzt.integer.u16 = BRANCH (a5) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r20, r20), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r20, r20), mask) }
        q5: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r21, other))
        r22: liblapzt.integer.u16 = BRANCH (q5) { liblapzt.integer.u16.subtract.wrapping(r21, other) } { r21 }
        r23: liblapzt.integer.u16 = BRANCH (a4) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r22, r22), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r22, r22), mask) }
        q4: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r23, other))
        r24: liblapzt.integer.u16 = BRANCH (q4) { liblapzt.integer.u16.subtract.wrapping(r23, other) } { r23 }
        r25: liblapzt.integer.u16 = BRANCH (a3) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r24, r24), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r24, r24), mask) }
        q3: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r25, other))
        r26: liblapzt.integer.u16 = BRANCH (q3) { liblapzt.integer.u16.subtract.wrapping(r25, other) } { r25 }
        r27: liblapzt.integer.u16 = BRANCH (a2) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r26, r26), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r26, r26), mask) }
        q2: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r27, other))
        r28: liblapzt.integer.u16 = BRANCH (q2) { liblapzt.integer.u16.subtract.wrapping(r27, other) } { r27 }
        r29: liblapzt.integer.u16 = BRANCH (a1) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r28, r28), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r28, r28), mask) }
        q1: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r29, other))
        r30: liblapzt.integer.u16 = BRANCH (q1) { liblapzt.integer.u16.subtract.wrapping(r29, other) } { r29 }
        r31: liblapzt.integer.u16 = BRANCH (a0) { liblapzt.integer.u16.or(liblapzt.integer.u16.add.wrapping(r30, r30), one) } { liblapzt.integer.u16.and(liblapzt.integer.u16.add.wrapping(r30, r30), mask) }
        q0: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u16.less_than(r31, other))
        r32: liblapzt.integer.u16 = BRANCH (q0) { liblapzt.integer.u16.subtract.wrapping(r31, other) } { r31 }
        quotient: liblapzt.integer.u16 = [[[[q0, q1], [q2, q3]], [[q4, q5], [q6, q7]]], [[[q8, q9], [q10, q11]], [[q12, q13], [q14, q15]]]]
        [quotient, r32]
    }
}

// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u16.divide.wrapping = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u16.divide.saturating = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u16.divide.checked = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.boolean, liblapzt.integer.u16] {
    zero: liblapzt.boolean = liblapzt.integer.u16.equal(other, liblapzt.integer.u16.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u16.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u16.remainder.wrapping = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    zero: liblapzt.boolean = liblapzt.integer.u16.equal(other, liblapzt.integer.u16.MIN)
    BRANCH (zero) {
        liblapzt.integer.u16.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u16.remainder.saturating = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) liblapzt.integer.u16 {
    zero: liblapzt.boolean = liblapzt.integer.u16.equal(other, liblapzt.integer.u16.MIN)
    BRANCH (zero) {
        liblapzt.integer.u16.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u16.remainder.checked = (self: liblapzt.integer.u16, other: liblapzt.integer.u16) [liblapzt.boolean, liblapzt.integer.u16] {
    zero: liblapzt.boolean = liblapzt.integer.u16.equal(other, liblapzt.integer.u16.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u16.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u16.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}
