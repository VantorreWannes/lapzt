//! 2-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u2.erased = [liblapzt.integer.u1, liblapzt.integer.u1]
__liblapzt.integer.u2.MIN.erased = [liblapzt.integer.u1.MIN, liblapzt.integer.u1.MIN]
__liblapzt.integer.u2.MAX.erased = [liblapzt.integer.u1.MAX, liblapzt.integer.u1.MAX]

// --- Types ---

liblapzt.integer.u2 = __liblapzt.integer.u2.erased
liblapzt.integer.u2.MIN = __liblapzt.integer.u2.MIN.erased
liblapzt.integer.u2.MAX = __liblapzt.integer.u2.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u2.not = (self: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [liblapzt.integer.u1.not(self_low), liblapzt.integer.u1.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u2.and = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.and(self_low, other_low), liblapzt.integer.u1.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u2.or = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.or(self_low, other_low), liblapzt.integer.u1.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u2.not.and = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.not.and(self_low, other_low), liblapzt.integer.u1.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u2.not.or = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.not.or(self_low, other_low), liblapzt.integer.u1.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u2.exclusive.or = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u1.exclusive.or(self_low, other_low), liblapzt.integer.u1.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u2.equal = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u2.not.equal = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u1.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u1.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u2.greater_than = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u1.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u1.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u2.less_than = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u1.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u1.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u1.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u2.min = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    less: liblapzt.boolean = liblapzt.integer.u2.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u2.max = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    greater: liblapzt.boolean = liblapzt.integer.u2.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^2.
liblapzt.integer.u2.add.wrapping = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u1 = liblapzt.integer.u1.and(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u2.add.checked = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.boolean, liblapzt.integer.u2] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u1 = liblapzt.integer.u1.and(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u1 = liblapzt.integer.u1.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u1 = liblapzt.integer.u1.or(liblapzt.integer.u1.and(self_high, other_high), liblapzt.integer.u1.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u2.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u2.add.saturating = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [ok, sum] = liblapzt.integer.u2.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u2.MAX }
}

// Returns the difference of self and other modulo 2^2.
liblapzt.integer.u2.subtract.wrapping = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u1.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u2.subtract.checked = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.boolean, liblapzt.integer.u2] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u1.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u1 = liblapzt.integer.u1.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u1.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u1.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u2.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u2.subtract.saturating = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [ok, difference] = liblapzt.integer.u2.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u2.MIN }
}

// Returns the full 2*2-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u2.multiply.full = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.integer.u2, liblapzt.integer.u2] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u1.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u2 = liblapzt.integer.u1.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u2 = liblapzt.integer.u1.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u2.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u2.add.checked([p_low, p_high], [liblapzt.integer.u1.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u1.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u2.add.checked([q_high, liblapzt.integer.u1.MIN], [r_low, r_high])
    one: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, liblapzt.integer.u2.MAX)
    high2: liblapzt.integer.u2 = BRANCH (carry_low) { liblapzt.integer.u2.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u2 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u1.MIN, liblapzt.integer.u1.MAX] } { liblapzt.integer.u2.MIN }
    high3: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 2 bits of the product of self and other.
liblapzt.integer.u2.multiply.wrapping = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [low, high] = liblapzt.integer.u2.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u2.multiply.checked = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.boolean, liblapzt.integer.u2] {
    [low, high] = liblapzt.integer.u2.multiply.full(self, other)
    [liblapzt.integer.u2.equal(high, liblapzt.integer.u2.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u2.multiply.saturating = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [ok, low] = liblapzt.integer.u2.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u2.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u2.divide.full = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.integer.u2, liblapzt.integer.u2] {
    zero: liblapzt.boolean = liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u2.MAX, liblapzt.integer.u2.MIN]
    } {
        [a0, a1] = self
        one: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(liblapzt.integer.u2.MIN, liblapzt.integer.u2.MAX)
        mask: liblapzt.integer.u2 = liblapzt.integer.u2.not(one)
        r0: liblapzt.integer.u2 = liblapzt.integer.u2.MIN
        r1: liblapzt.integer.u2 = BRANCH (a1) { liblapzt.integer.u2.or(liblapzt.integer.u2.add.wrapping(r0, r0), one) } { liblapzt.integer.u2.and(liblapzt.integer.u2.add.wrapping(r0, r0), mask) }
        q1: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u2.less_than(r1, other))
        r2: liblapzt.integer.u2 = BRANCH (q1) { liblapzt.integer.u2.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u2 = BRANCH (a0) { liblapzt.integer.u2.or(liblapzt.integer.u2.add.wrapping(r2, r2), one) } { liblapzt.integer.u2.and(liblapzt.integer.u2.add.wrapping(r2, r2), mask) }
        q0: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u2.less_than(r3, other))
        r4: liblapzt.integer.u2 = BRANCH (q0) { liblapzt.integer.u2.subtract.wrapping(r3, other) } { r3 }
        quotient: liblapzt.integer.u2 = [q0, q1]
        [quotient, r4]
    }
}

// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u2.divide.wrapping = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u2.divide.saturating = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u2.divide.checked = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.boolean, liblapzt.integer.u2] {
    zero: liblapzt.boolean = liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u2.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u2.remainder.wrapping = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    zero: liblapzt.boolean = liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MIN)
    BRANCH (zero) {
        liblapzt.integer.u2.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u2.remainder.saturating = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) liblapzt.integer.u2 {
    zero: liblapzt.boolean = liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MIN)
    BRANCH (zero) {
        liblapzt.integer.u2.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u2.remainder.checked = (self: liblapzt.integer.u2, other: liblapzt.integer.u2) [liblapzt.boolean, liblapzt.integer.u2] {
    zero: liblapzt.boolean = liblapzt.integer.u2.equal(other, liblapzt.integer.u2.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u2.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u2.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}
