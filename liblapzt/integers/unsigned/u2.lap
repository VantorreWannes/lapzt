liblapzt.u2.erased = [liblapzt.u1.erased, liblapzt.u1.erased]

// A 2-bit unsigned integer stored as a pair of u1 words. Operations
// are defined in terms of the smaller word.
liblapzt.u2 = liblapzt.u2.erased

liblapzt.u2.zero.erased: liblapzt.u2.erased = [liblapzt.u1.zero.erased, liblapzt.u1.zero.erased]
liblapzt.u2.one.erased: liblapzt.u2.erased = [liblapzt.u1.one.erased, liblapzt.u1.zero.erased]
liblapzt.u2.maximum.erased: liblapzt.u2.erased = [liblapzt.u1.maximum.erased, liblapzt.u1.maximum.erased]

// The additive identity, with every bit clear.
liblapzt.u2.zero: liblapzt.u2 = liblapzt.u2.zero.erased
// The value one, with only the least significant bit set.
liblapzt.u2.one: liblapzt.u2 = liblapzt.u2.one.erased
// The largest representable value, with every bit set.
liblapzt.u2.maximum: liblapzt.u2 = liblapzt.u2.maximum.erased

liblapzt.u2.not.erased = (a: liblapzt.u2) liblapzt.u2 {
    [low, high] = a
    [liblapzt.u1.not(low), liblapzt.u1.not(high)]
}

// Returns the bitwise complement of a, flipping every bit.
liblapzt.u2.not = liblapzt.u2.not.erased

liblapzt.u2.and.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.and(al, bl), liblapzt.u1.and(ah, bh)]
}

// Returns the bitwise AND of a and b.
liblapzt.u2.and = liblapzt.u2.and.erased

liblapzt.u2.or.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.or(al, bl), liblapzt.u1.or(ah, bh)]
}

// Returns the bitwise OR of a and b.
liblapzt.u2.or = liblapzt.u2.or.erased

liblapzt.u2.xor.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.xor(al, bl), liblapzt.u1.xor(ah, bh)]
}

// Returns the bitwise XOR of a and b.
liblapzt.u2.xor = liblapzt.u2.xor.erased

liblapzt.u2.nand.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.nand(al, bl), liblapzt.u1.nand(ah, bh)]
}

// Returns the bitwise NAND of a and b.
liblapzt.u2.nand = liblapzt.u2.nand.erased

liblapzt.u2.nor.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.nor(al, bl), liblapzt.u1.nor(ah, bh)]
}

// Returns the bitwise NOR of a and b.
liblapzt.u2.nor = liblapzt.u2.nor.erased

liblapzt.u2.xnor.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u1.xnor(al, bl), liblapzt.u1.xnor(ah, bh)]
}

// Returns the bitwise XNOR of a and b.
liblapzt.u2.xnor = liblapzt.u2.xnor.erased

liblapzt.u2.from.bool.erased = (a: liblapzt.bool) liblapzt.u2 {
    [liblapzt.u1.from.bool(a), liblapzt.u1.zero]
}

// Returns one when a is true and zero when a is false.
liblapzt.u2.from.bool = liblapzt.u2.from.bool.erased

// Returns the sum of a and b as a pair [sum, carry], where carry is
// the carry out of the top bit.
liblapzt.u2.add.carry = (a: liblapzt.u2, b: liblapzt.u2) [liblapzt.u2, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, cl] = liblapzt.u1.add.carry(al, bl)
    [sh, ch] = liblapzt.u1.add.carry(ah, bh)
    [sh2, ch2] = liblapzt.u1.add.carry(sh, liblapzt.u1.from.bool(cl))
    [[sl, sh2], liblapzt.bool.or(ch, ch2)]
}

liblapzt.u2.add.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [sum, carry] = liblapzt.u2.add.carry(a, b)
    sum
}

// Returns the sum of a and b, discarding the carry out of the top
// bit.
liblapzt.u2.add = liblapzt.u2.add.erased

// Returns a - b as a pair [difference, borrow], where borrow is the
// borrow out of the top bit.
liblapzt.u2.sub.borrow = (a: liblapzt.u2, b: liblapzt.u2) [liblapzt.u2, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, blw] = liblapzt.u1.sub.borrow(al, bl)
    [sh, bhw] = liblapzt.u1.sub.borrow(ah, bh)
    [sh2, bhw2] = liblapzt.u1.sub.borrow(sh, liblapzt.u1.from.bool(blw))
    [[sl, sh2], liblapzt.bool.or(bhw, bhw2)]
}

liblapzt.u2.sub.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [difference, borrow] = liblapzt.u2.sub.borrow(a, b)
    difference
}

// Returns a - b modulo 4, discarding the borrow. Wraps when b is
// greater than a.
liblapzt.u2.sub = liblapzt.u2.sub.erased

// Returns the sum of a, b and c as a pair [sum, carry].
liblapzt.u2.add3 = (a: liblapzt.u2, b: liblapzt.u2, c: liblapzt.u2) [liblapzt.u2, liblapzt.u2] {
    [s1, c1] = liblapzt.u2.add.carry(a, b)
    [s2, c2] = liblapzt.u2.add.carry(s1, c)
    carry: liblapzt.u2 = liblapzt.u2.add(liblapzt.u2.from.bool(c1), liblapzt.u2.from.bool(c2))
    [s2, carry]
}

// Returns the full 4-bit product of a and b as a pair
// [low, high].
liblapzt.u2.mul.full = (a: liblapzt.u2, b: liblapzt.u2) [liblapzt.u2, liblapzt.u2] {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u1.mul.full(al, bl)
    [cl, ch] = liblapzt.u1.mul.full(al, bh)
    [dl, dh] = liblapzt.u1.mul.full(ah, bl)
    [el, eh] = liblapzt.u1.mul.full(ah, bh)
    [low.sum, low.carry] = liblapzt.u1.add3(lh, cl, dl)
    low: liblapzt.u2 = [ll, low.sum]
    [high.sum, high.carry] = liblapzt.u1.add3(ch, dh, el)
    [high.sum2, high.carry2] = liblapzt.u1.add.carry(high.sum, low.carry)
    high.high: liblapzt.u1 = liblapzt.u1.add(liblapzt.u1.add(eh, high.carry), liblapzt.u1.from.bool(high.carry2))
    high: liblapzt.u2 = [high.sum2, high.high]
    [low, high]
}

liblapzt.u2.mul.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u1.mul.full(al, bl)
    cross: liblapzt.u1 = liblapzt.u1.add(liblapzt.u1.mul(al, bh), liblapzt.u1.mul(ah, bl))
    [ll, liblapzt.u1.add(lh, cross)]
}

// Returns the low 2 bits of the product of a and b, discarding the
// high half.
liblapzt.u2.mul = liblapzt.u2.mul.erased

// Returns a shifted left by one bit. The top bit is discarded and
// the low bit becomes zero.
liblapzt.u2.shl1 = (a: liblapzt.u2) liblapzt.u2 {
    [low, high] = a
    [liblapzt.u1.shl1(low), liblapzt.u1.or(liblapzt.u1.shl1(high), liblapzt.u1.from.bool(liblapzt.u1.msb(low)))]
}

// Returns a with its least significant bit replaced by bit.
liblapzt.u2.with.lsb = (a: liblapzt.u2, bit: liblapzt.bool) liblapzt.u2 {
    [low, high] = a
    [liblapzt.u1.with.lsb(low, bit), high]
}

// Returns the most significant bit of a as a u1.
liblapzt.u2.msb = (a: liblapzt.u2) liblapzt.u1 {
    [low, high] = a
    liblapzt.u1.msb(high)
}

liblapzt.u2.eq.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    liblapzt.bool.and(liblapzt.u1.eq(al, bl), liblapzt.u1.eq(ah, bh))
}

// Returns true when a and b have the same value.
liblapzt.u2.eq = liblapzt.u2.eq.erased

liblapzt.u2.ne.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    liblapzt.bool.not(liblapzt.u2.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.u2.ne = liblapzt.u2.ne.erased

liblapzt.u2.lt.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    high.lt: liblapzt.bool = liblapzt.u1.lt(ah, bh)
    high.eq: liblapzt.bool = liblapzt.u1.eq(ah, bh)
    low.lt: liblapzt.bool = liblapzt.u1.lt(al, bl)
    liblapzt.bool.or(high.lt, liblapzt.bool.and(high.eq, low.lt))
}

// Returns true when a is less than b.
liblapzt.u2.lt = liblapzt.u2.lt.erased

liblapzt.u2.le.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    liblapzt.bool.or(liblapzt.u2.lt(a, b), liblapzt.u2.eq(a, b))
}

// Returns true when a is less than or equal to b.
liblapzt.u2.le = liblapzt.u2.le.erased

liblapzt.u2.gt.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    liblapzt.u2.lt(b, a)
}

// Returns true when a is greater than b.
liblapzt.u2.gt = liblapzt.u2.gt.erased

liblapzt.u2.ge.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.bool {
    liblapzt.u2.le(b, a)
}

// Returns true when a is greater than or equal to b.
liblapzt.u2.ge = liblapzt.u2.ge.erased

liblapzt.u2.select.erased = (flag: liblapzt.bool, when.true: liblapzt.u2, when.false: liblapzt.u2) liblapzt.u2 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.u1.select(flag, tl, fl), liblapzt.u1.select(flag, th, fh)]
}

// Returns when.true when flag is true, otherwise when.false.
liblapzt.u2.select = liblapzt.u2.select.erased

liblapzt.u2.min.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    liblapzt.u2.select(liblapzt.u2.lt(a, b), a, b)
}

// Returns the smaller of a and b.
liblapzt.u2.min = liblapzt.u2.min.erased

liblapzt.u2.max.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    liblapzt.u2.select(liblapzt.u2.gt(a, b), a, b)
}

// Returns the larger of a and b.
liblapzt.u2.max = liblapzt.u2.max.erased

liblapzt.u2.inc.erased = (a: liblapzt.u2) liblapzt.u2 {
    liblapzt.u2.add(a, liblapzt.u2.one)
}

// Returns a plus one, wrapping to zero at the maximum value.
liblapzt.u2.inc = liblapzt.u2.inc.erased

liblapzt.u2.dec.erased = (a: liblapzt.u2) liblapzt.u2 {
    liblapzt.u2.sub(a, liblapzt.u2.one)
}

// Returns a minus one, wrapping to the maximum value at zero.
liblapzt.u2.dec = liblapzt.u2.dec.erased

liblapzt.u2.is.zero.erased = (a: liblapzt.u2) liblapzt.bool {
    [low, high] = a
    liblapzt.bool.and(liblapzt.u1.is.zero(low), liblapzt.u1.is.zero(high))
}

// Returns true when every bit of a is clear.
liblapzt.u2.is.zero = liblapzt.u2.is.zero.erased

liblapzt.u2.is.one.erased = (a: liblapzt.u2) liblapzt.bool {
    [low, high] = a
    liblapzt.bool.and(liblapzt.u1.is.one(low), liblapzt.u1.is.zero(high))
}

// Returns true when a equals one.
liblapzt.u2.is.one = liblapzt.u2.is.one.erased

liblapzt.u2.to.bool.erased = (a: liblapzt.u2) liblapzt.bool {
    liblapzt.bool.not(liblapzt.u2.is.zero(a))
}

// Returns true when a is nonzero.
liblapzt.u2.to.bool = liblapzt.u2.to.bool.erased

liblapzt.u2.div.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    zero: liblapzt.bool = liblapzt.u2.is.zero(b)
    BRANCH (zero) {
        liblapzt.u2.zero
    } {
        [a0, a1] = a
        r0: liblapzt.u2 = liblapzt.u2.zero
        r1: liblapzt.u2 = liblapzt.u2.with.lsb(liblapzt.u2.shl1(r0), a1)
        q1: liblapzt.bool = liblapzt.u2.ge(r1, b)
        r2: liblapzt.u2 = liblapzt.u2.select(q1, liblapzt.u2.sub(r1, b), r1)
        r3: liblapzt.u2 = liblapzt.u2.with.lsb(liblapzt.u2.shl1(r2), a0)
        q0: liblapzt.bool = liblapzt.u2.ge(r3, b)
        r4: liblapzt.u2 = liblapzt.u2.select(q0, liblapzt.u2.sub(r3, b), r3)
        [q0, q1]
    }
}

// Returns the quotient of a divided by b, rounding toward zero.
// Returns zero when b is zero.
liblapzt.u2.div = liblapzt.u2.div.erased

liblapzt.u2.mod.erased = (a: liblapzt.u2, b: liblapzt.u2) liblapzt.u2 {
    zero: liblapzt.bool = liblapzt.u2.is.zero(b)
    BRANCH (zero) {
        liblapzt.u2.zero
    } {
        [a0, a1] = a
        r0: liblapzt.u2 = liblapzt.u2.zero
        r1: liblapzt.u2 = liblapzt.u2.with.lsb(liblapzt.u2.shl1(r0), a1)
        q1: liblapzt.bool = liblapzt.u2.ge(r1, b)
        r2: liblapzt.u2 = liblapzt.u2.select(q1, liblapzt.u2.sub(r1, b), r1)
        r3: liblapzt.u2 = liblapzt.u2.with.lsb(liblapzt.u2.shl1(r2), a0)
        q0: liblapzt.bool = liblapzt.u2.ge(r3, b)
        r4: liblapzt.u2 = liblapzt.u2.select(q0, liblapzt.u2.sub(r3, b), r3)
        r4
    }
}

// Returns the remainder of a divided by b. Returns zero when b is
// zero.
liblapzt.u2.mod = liblapzt.u2.mod.erased
