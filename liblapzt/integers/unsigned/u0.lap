liblapzt.u0.erased = []

// The zero-width unsigned integer, whose only value is the empty
// tuple.
liblapzt.u0 = liblapzt.u0.erased

liblapzt.u0.zero.erased: liblapzt.u0.erased = []

// The only value of the zero-width type.
liblapzt.u0.zero: liblapzt.u0 = liblapzt.u0.zero.erased

// Always returns true, since the type has a single value.
liblapzt.u0.eq = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.bool {
    liblapzt.bool.true
}

// Always returns false, since the type has a single value.
liblapzt.u0.ne = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.bool {
    liblapzt.bool.false
}

// Returns the only value; the sum of two zero-width integers.
liblapzt.u0.add = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value; the difference of two zero-width
// integers.
liblapzt.u0.sub = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value; the product of two zero-width integers.
liblapzt.u0.mul = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value. A zero divisor also yields it.
liblapzt.u0.div = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value. A zero divisor also yields it.
liblapzt.u0.mod = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value, since both arguments are equal.
liblapzt.u0.min = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value, since both arguments are equal.
liblapzt.u0.max = (a: liblapzt.u0, b: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value; incrementing wraps immediately.
liblapzt.u0.inc = (a: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value; decrementing wraps immediately.
liblapzt.u0.dec = (a: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns the only value, regardless of flag.
liblapzt.u0.select = (flag: liblapzt.bool, when.one: liblapzt.u0, when.zero: liblapzt.u0) liblapzt.u0 {
    []
}

// Returns zero, since the value cannot be represented in one bit.
liblapzt.u0.to.u1 = (a: liblapzt.u0) liblapzt.u1 {
    liblapzt.u1.zero
}

// Returns the only value, discarding the input.
liblapzt.u0.from.u1 = (a: liblapzt.u1) liblapzt.u0 {
    []
}

// Always returns false, since the only value is zero.
liblapzt.u0.to.bool = (a: liblapzt.u0) liblapzt.bool {
    liblapzt.bool.false
}

// Returns the only value, discarding the input.
liblapzt.u0.from.bool = (a: liblapzt.bool) liblapzt.u0 {
