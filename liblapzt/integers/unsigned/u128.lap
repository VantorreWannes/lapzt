//! 128-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u128.erased = [liblapzt.integer.u64, liblapzt.integer.u64]
__liblapzt.integer.u128.MIN.erased = [liblapzt.integer.u64.MIN, liblapzt.integer.u64.MIN]
__liblapzt.integer.u128.MAX.erased = [liblapzt.integer.u64.MAX, liblapzt.integer.u64.MAX]

// --- Types ---

liblapzt.integer.u128 = __liblapzt.integer.u128.erased
liblapzt.integer.u128.MIN = __liblapzt.integer.u128.MIN.erased
liblapzt.integer.u128.MAX = __liblapzt.integer.u128.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u128.not = (self: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [liblapzt.integer.u64.not(self_low), liblapzt.integer.u64.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u128.and = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.and(self_low, other_low), liblapzt.integer.u64.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u128.or = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.or(self_low, other_low), liblapzt.integer.u64.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u128.not.and = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.not.and(self_low, other_low), liblapzt.integer.u64.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u128.not.or = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.not.or(self_low, other_low), liblapzt.integer.u64.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u128.exclusive.or = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u64.exclusive.or(self_low, other_low), liblapzt.integer.u64.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u128.equal = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u128.not.equal = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u64.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u64.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u128.greater_than = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u64.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u64.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u128.less_than = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u64.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u64.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u64.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u128.min = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    less: liblapzt.boolean = liblapzt.integer.u128.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u128.max = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    greater: liblapzt.boolean = liblapzt.integer.u128.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^128.
liblapzt.integer.u128.add.wrapping = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u64 = liblapzt.integer.u64.and(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u128.add.checked = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.boolean, liblapzt.integer.u128] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u64 = liblapzt.integer.u64.and(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u64 = liblapzt.integer.u64.or(liblapzt.integer.u64.and(self_high, other_high), liblapzt.integer.u64.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u128.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u128.add.saturating = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [ok, sum] = liblapzt.integer.u128.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u128.MAX }
}

// Returns the difference of self and other modulo 2^128.
liblapzt.integer.u128.subtract.wrapping = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u64.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u128.subtract.checked = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.boolean, liblapzt.integer.u128] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u64.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u64.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u64.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u128.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u128.subtract.saturating = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [ok, difference] = liblapzt.integer.u128.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u128.MIN }
}

// Returns the full 2*128-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u128.multiply.full = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.integer.u128, liblapzt.integer.u128] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u64.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u128 = liblapzt.integer.u64.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u128 = liblapzt.integer.u64.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u128.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u128.add.checked([p_low, p_high], [liblapzt.integer.u64.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u64.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u128.add.checked([q_high, liblapzt.integer.u64.MIN], [r_low, r_high])
    one: liblapzt.integer.u128 = liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, liblapzt.integer.u128.MAX)
    high2: liblapzt.integer.u128 = BRANCH (carry_low) { liblapzt.integer.u128.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u128 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u64.MIN, liblapzt.integer.u64.MAX] } { liblapzt.integer.u128.MIN }
    high3: liblapzt.integer.u128 = liblapzt.integer.u128.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 128 bits of the product of self and other.
liblapzt.integer.u128.multiply.wrapping = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [low, high] = liblapzt.integer.u128.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u128.multiply.checked = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.boolean, liblapzt.integer.u128] {
    [low, high] = liblapzt.integer.u128.multiply.full(self, other)
    [liblapzt.integer.u128.equal(high, liblapzt.integer.u128.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u128.multiply.saturating = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [ok, low] = liblapzt.integer.u128.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u128.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u128.divide.full = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.integer.u128, liblapzt.integer.u128] {
    zero: liblapzt.boolean = liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u128.MAX, liblapzt.integer.u128.MIN]
    } {
        [[[[[[[a0, a1], [a2, a3]], [[a4, a5], [a6, a7]]], [[[a8, a9], [a10, a11]], [[a12, a13], [a14, a15]]]], [[[[a16, a17], [a18, a19]], [[a20, a21], [a22, a23]]], [[[a24, a25], [a26, a27]], [[a28, a29], [a30, a31]]]]], [[[[[a32, a33], [a34, a35]], [[a36, a37], [a38, a39]]], [[[a40, a41], [a42, a43]], [[a44, a45], [a46, a47]]]], [[[[a48, a49], [a50, a51]], [[a52, a53], [a54, a55]]], [[[a56, a57], [a58, a59]], [[a60, a61], [a62, a63]]]]]], [[[[[[a64, a65], [a66, a67]], [[a68, a69], [a70, a71]]], [[[a72, a73], [a74, a75]], [[a76, a77], [a78, a79]]]], [[[[a80, a81], [a82, a83]], [[a84, a85], [a86, a87]]], [[[a88, a89], [a90, a91]], [[a92, a93], [a94, a95]]]]], [[[[[a96, a97], [a98, a99]], [[a100, a101], [a102, a103]]], [[[a104, a105], [a106, a107]], [[a108, a109], [a110, a111]]]], [[[[a112, a113], [a114, a115]], [[a116, a117], [a118, a119]]], [[[a120, a121], [a122, a123]], [[a124, a125], [a126, a127]]]]]]] = self
        one: liblapzt.integer.u128 = liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, liblapzt.integer.u128.MAX)
        mask: liblapzt.integer.u128 = liblapzt.integer.u128.not(one)
        r0: liblapzt.integer.u128 = liblapzt.integer.u128.MIN
        r1: liblapzt.integer.u128 = BRANCH (a127) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r0, r0), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r0, r0), mask) }
        q127: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r1, other))
        r2: liblapzt.integer.u128 = BRANCH (q127) { liblapzt.integer.u128.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u128 = BRANCH (a126) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r2, r2), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r2, r2), mask) }
        q126: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r3, other))
        r4: liblapzt.integer.u128 = BRANCH (q126) { liblapzt.integer.u128.subtract.wrapping(r3, other) } { r3 }
        r5: liblapzt.integer.u128 = BRANCH (a125) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r4, r4), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r4, r4), mask) }
        q125: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r5, other))
        r6: liblapzt.integer.u128 = BRANCH (q125) { liblapzt.integer.u128.subtract.wrapping(r5, other) } { r5 }
        r7: liblapzt.integer.u128 = BRANCH (a124) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r6, r6), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r6, r6), mask) }
        q124: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r7, other))
        r8: liblapzt.integer.u128 = BRANCH (q124) { liblapzt.integer.u128.subtract.wrapping(r7, other) } { r7 }
        r9: liblapzt.integer.u128 = BRANCH (a123) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r8, r8), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r8, r8), mask) }
        q123: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r9, other))
        r10: liblapzt.integer.u128 = BRANCH (q123) { liblapzt.integer.u128.subtract.wrapping(r9, other) } { r9 }
        r11: liblapzt.integer.u128 = BRANCH (a122) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r10, r10), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r10, r10), mask) }
        q122: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r11, other))
        r12: liblapzt.integer.u128 = BRANCH (q122) { liblapzt.integer.u128.subtract.wrapping(r11, other) } { r11 }
        r13: liblapzt.integer.u128 = BRANCH (a121) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r12, r12), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r12, r12), mask) }
        q121: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r13, other))
        r14: liblapzt.integer.u128 = BRANCH (q121) { liblapzt.integer.u128.subtract.wrapping(r13, other) } { r13 }
        r15: liblapzt.integer.u128 = BRANCH (a120) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r14, r14), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r14, r14), mask) }
        q120: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r15, other))
        r16: liblapzt.integer.u128 = BRANCH (q120) { liblapzt.integer.u128.subtract.wrapping(r15, other) } { r15 }
        r17: liblapzt.integer.u128 = BRANCH (a119) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r16, r16), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r16, r16), mask) }
        q119: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r17, other))
        r18: liblapzt.integer.u128 = BRANCH (q119) { liblapzt.integer.u128.subtract.wrapping(r17, other) } { r17 }
        r19: liblapzt.integer.u128 = BRANCH (a118) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r18, r18), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r18, r18), mask) }
        q118: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r19, other))
        r20: liblapzt.integer.u128 = BRANCH (q118) { liblapzt.integer.u128.subtract.wrapping(r19, other) } { r19 }
        r21: liblapzt.integer.u128 = BRANCH (a117) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r20, r20), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r20, r20), mask) }
        q117: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r21, other))
        r22: liblapzt.integer.u128 = BRANCH (q117) { liblapzt.integer.u128.subtract.wrapping(r21, other) } { r21 }
        r23: liblapzt.integer.u128 = BRANCH (a116) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r22, r22), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r22, r22), mask) }
        q116: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r23, other))
        r24: liblapzt.integer.u128 = BRANCH (q116) { liblapzt.integer.u128.subtract.wrapping(r23, other) } { r23 }
        r25: liblapzt.integer.u128 = BRANCH (a115) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r24, r24), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r24, r24), mask) }
        q115: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r25, other))
        r26: liblapzt.integer.u128 = BRANCH (q115) { liblapzt.integer.u128.subtract.wrapping(r25, other) } { r25 }
        r27: liblapzt.integer.u128 = BRANCH (a114) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r26, r26), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r26, r26), mask) }
        q114: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r27, other))
        r28: liblapzt.integer.u128 = BRANCH (q114) { liblapzt.integer.u128.subtract.wrapping(r27, other) } { r27 }
        r29: liblapzt.integer.u128 = BRANCH (a113) { liblapzt.integer.u128.or(liblapzt.integer.u128.add.wrapping(r28, r28), one) } { liblapzt.integer.u128.and(liblapzt.integer.u128.add.wrapping(r28, r28), mask) }
        q113: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u128.less_than(r29, other))
        r30: liblapzt.integer.u128 = BRANCH (q113) { liblapzt.integer.u128.subtract.wrapping(r29, other) } { r29 }
