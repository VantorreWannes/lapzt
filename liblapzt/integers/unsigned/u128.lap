// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u128.divide.wrapping = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u128.divide.saturating = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u128.divide.checked = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.boolean, liblapzt.integer.u128] {
    zero: liblapzt.boolean = liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u128.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u128.remainder.wrapping = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    zero: liblapzt.boolean = liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MIN)
    BRANCH (zero) {
        liblapzt.integer.u128.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u128.remainder.saturating = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) liblapzt.integer.u128 {
    zero: liblapzt.boolean = liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MIN)
    BRANCH (zero) {
        liblapzt.integer.u128.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u128.remainder.checked = (self: liblapzt.integer.u128, other: liblapzt.integer.u128) [liblapzt.boolean, liblapzt.integer.u128] {
    zero: liblapzt.boolean = liblapzt.integer.u128.equal(other, liblapzt.integer.u128.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u128.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u128.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}

