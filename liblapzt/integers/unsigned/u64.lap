//! 64-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u64.erased = [liblapzt.integer.u32, liblapzt.integer.u32]
__liblapzt.integer.u64.MIN.erased = [liblapzt.integer.u32.MIN, liblapzt.integer.u32.MIN]
__liblapzt.integer.u64.MAX.erased = [liblapzt.integer.u32.MAX, liblapzt.integer.u32.MAX]

// --- Types ---

liblapzt.integer.u64 = __liblapzt.integer.u64.erased
liblapzt.integer.u64.MIN = __liblapzt.integer.u64.MIN.erased
liblapzt.integer.u64.MAX = __liblapzt.integer.u64.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u64.not = (self: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [liblapzt.integer.u32.not(self_low), liblapzt.integer.u32.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u64.and = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u32.and(self_low, other_low), liblapzt.integer.u32.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u64.or = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u32.or(self_low, other_low), liblapzt.integer.u32.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u64.not.and = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u32.not.and(self_low, other_low), liblapzt.integer.u32.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u64.not.or = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u32.not.or(self_low, other_low), liblapzt.integer.u32.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u64.exclusive.or = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u32.exclusive.or(self_low, other_low), liblapzt.integer.u32.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u64.equal = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u32.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u32.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u64.not.equal = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u32.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u32.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u64.greater_than = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u32.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u32.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u32.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u64.less_than = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u32.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u32.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u32.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u64.min = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    less: liblapzt.boolean = liblapzt.integer.u64.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u64.max = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    greater: liblapzt.boolean = liblapzt.integer.u64.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^64.
liblapzt.integer.u64.add.wrapping = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u32 = liblapzt.integer.u32.and(self_low, other_low)
    xor_high: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u64.add.checked = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.boolean, liblapzt.integer.u64] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u32 = liblapzt.integer.u32.and(self_low, other_low)
    xor_high: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u32 = liblapzt.integer.u32.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u32 = liblapzt.integer.u32.or(liblapzt.integer.u32.and(self_high, other_high), liblapzt.integer.u32.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u64.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u64.add.saturating = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [ok, sum] = liblapzt.integer.u64.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u64.MAX }
}

// Returns the difference of self and other modulo 2^64.
liblapzt.integer.u64.subtract.wrapping = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u32.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u64.subtract.checked = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.boolean, liblapzt.integer.u64] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u32.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u32 = liblapzt.integer.u32.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u32.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u32.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u64.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u64.subtract.saturating = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [ok, difference] = liblapzt.integer.u64.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u64.MIN }
}

// Returns the full 2*64-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u64.multiply.full = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.integer.u64, liblapzt.integer.u64] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u32.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u64 = liblapzt.integer.u32.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u64 = liblapzt.integer.u32.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u64.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u64.add.checked([p_low, p_high], [liblapzt.integer.u32.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u32.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u64.add.checked([q_high, liblapzt.integer.u32.MIN], [r_low, r_high])
    one: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(liblapzt.integer.u64.MIN, liblapzt.integer.u64.MAX)
    high2: liblapzt.integer.u64 = BRANCH (carry_low) { liblapzt.integer.u64.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u64 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u32.MIN, liblapzt.integer.u32.MAX] } { liblapzt.integer.u64.MIN }
    high3: liblapzt.integer.u64 = liblapzt.integer.u64.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 64 bits of the product of self and other.
liblapzt.integer.u64.multiply.wrapping = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [low, high] = liblapzt.integer.u64.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u64.multiply.checked = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.boolean, liblapzt.integer.u64] {
    [low, high] = liblapzt.integer.u64.multiply.full(self, other)
    [liblapzt.integer.u64.equal(high, liblapzt.integer.u64.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u64.multiply.saturating = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [ok, low] = liblapzt.integer.u64.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u64.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u64.divide.full = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.integer.u64, liblapzt.integer.u64] {
    zero: liblapzt.boolean = liblapzt.integer.u64.equal(other, liblapzt.integer.u64.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u64.MAX, liblapzt.integer.u64.MIN]
    } {
        [[[[[[a0, a1], [a2, a3]], [[a4, a5], [a6, a7]]], [[[a8, a9], [a10, a11]], [[a12, a13], [a14, a15]]]], [[[[a16, a17], [a18, a19]], [[a20, a21], [a22, a23]]], [[[a24, a25], [a26, a27]], [[a28, a29], [a30, a31]]]]], [[[[[a32, a33], [a34, a35]], [[a36, a37], [a38, a39]]], [[[a40, a41], [a42, a43]], [[a44, a45], [a46, a47]]]], [[[[a48, a49], [a50, a51]], [[a52, a53], [a54, a55]]], [[[a56, a57], [a58, a59]], [[a60, a61], [a62, a63]]]]]] = self
        one: liblapzt.integer.u64 = liblapzt.integer.u64.subtract.wrapping(liblapzt.integer.u64.MIN, liblapzt.integer.u64.MAX)
        mask: liblapzt.integer.u64 = liblapzt.integer.u64.not(one)
        r0: liblapzt.integer.u64 = liblapzt.integer.u64.MIN
        r1: liblapzt.integer.u64 = BRANCH (a63) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r0, r0), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r0, r0), mask) }
        q63: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r1, other))
        r2: liblapzt.integer.u64 = BRANCH (q63) { liblapzt.integer.u64.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u64 = BRANCH (a62) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r2, r2), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r2, r2), mask) }
        q62: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r3, other))
        r4: liblapzt.integer.u64 = BRANCH (q62) { liblapzt.integer.u64.subtract.wrapping(r3, other) } { r3 }
        r5: liblapzt.integer.u64 = BRANCH (a61) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r4, r4), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r4, r4), mask) }
        q61: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r5, other))
        r6: liblapzt.integer.u64 = BRANCH (q61) { liblapzt.integer.u64.subtract.wrapping(r5, other) } { r5 }
        r7: liblapzt.integer.u64 = BRANCH (a60) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r6, r6), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r6, r6), mask) }
        q60: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r7, other))
        r8: liblapzt.integer.u64 = BRANCH (q60) { liblapzt.integer.u64.subtract.wrapping(r7, other) } { r7 }
        r9: liblapzt.integer.u64 = BRANCH (a59) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r8, r8), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r8, r8), mask) }
        q59: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r9, other))
        r10: liblapzt.integer.u64 = BRANCH (q59) { liblapzt.integer.u64.subtract.wrapping(r9, other) } { r9 }
        r11: liblapzt.integer.u64 = BRANCH (a58) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r10, r10), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r10, r10), mask) }
        q58: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r11, other))
        r12: liblapzt.integer.u64 = BRANCH (q58) { liblapzt.integer.u64.subtract.wrapping(r11, other) } { r11 }
        r13: liblapzt.integer.u64 = BRANCH (a57) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r12, r12), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r12, r12), mask) }
        q57: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r13, other))
        r14: liblapzt.integer.u64 = BRANCH (q57) { liblapzt.integer.u64.subtract.wrapping(r13, other) } { r13 }
        r15: liblapzt.integer.u64 = BRANCH (a56) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r14, r14), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r14, r14), mask) }
        q56: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r15, other))
        r16: liblapzt.integer.u64 = BRANCH (q56) { liblapzt.integer.u64.subtract.wrapping(r15, other) } { r15 }
        r17: liblapzt.integer.u64 = BRANCH (a55) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r16, r16), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r16, r16), mask) }
        q55: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r17, other))
        r18: liblapzt.integer.u64 = BRANCH (q55) { liblapzt.integer.u64.subtract.wrapping(r17, other) } { r17 }
        r19: liblapzt.integer.u64 = BRANCH (a54) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r18, r18), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r18, r18), mask) }
        q54: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r19, other))
        r20: liblapzt.integer.u64 = BRANCH (q54) { liblapzt.integer.u64.subtract.wrapping(r19, other) } { r19 }
        r21: liblapzt.integer.u64 = BRANCH (a53) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r20, r20), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r20, r20), mask) }
        q53: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r21, other))
        r22: liblapzt.integer.u64 = BRANCH (q53) { liblapzt.integer.u64.subtract.wrapping(r21, other) } { r21 }
        r23: liblapzt.integer.u64 = BRANCH (a52) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r22, r22), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r22, r22), mask) }
        q52: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r23, other))
        r24: liblapzt.integer.u64 = BRANCH (q52) { liblapzt.integer.u64.subtract.wrapping(r23, other) } { r23 }
        r25: liblapzt.integer.u64 = BRANCH (a51) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r24, r24), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r24, r24), mask) }
        q51: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r25, other))
        r26: liblapzt.integer.u64 = BRANCH (q51) { liblapzt.integer.u64.subtract.wrapping(r25, other) } { r25 }
        r27: liblapzt.integer.u64 = BRANCH (a50) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r26, r26), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r26, r26), mask) }
        q50: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r27, other))
        r28: liblapzt.integer.u64 = BRANCH (q50) { liblapzt.integer.u64.subtract.wrapping(r27, other) } { r27 }
        r29: liblapzt.integer.u64 = BRANCH (a49) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r28, r28), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r28, r28), mask) }
        q49: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r29, other))
        r30: liblapzt.integer.u64 = BRANCH (q49) { liblapzt.integer.u64.subtract.wrapping(r29, other) } { r29 }
        r31: liblapzt.integer.u64 = BRANCH (a48) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r30, r30), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r30, r30), mask) }
        q48: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r31, other))
        r32: liblapzt.integer.u64 = BRANCH (q48) { liblapzt.integer.u64.subtract.wrapping(r31, other) } { r31 }
        r33: liblapzt.integer.u64 = BRANCH (a47) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r32, r32), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r32, r32), mask) }
