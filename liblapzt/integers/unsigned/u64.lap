        r124: liblapzt.integer.u64 = BRANCH (q2) { liblapzt.integer.u64.subtract.wrapping(r123, other) } { r123 }
        r125: liblapzt.integer.u64 = BRANCH (a1) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r124, r124), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r124, r124), mask) }
        q1: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r125, other))
        r126: liblapzt.integer.u64 = BRANCH (q1) { liblapzt.integer.u64.subtract.wrapping(r125, other) } { r125 }
        r127: liblapzt.integer.u64 = BRANCH (a0) { liblapzt.integer.u64.or(liblapzt.integer.u64.add.wrapping(r126, r126), one) } { liblapzt.integer.u64.and(liblapzt.integer.u64.add.wrapping(r126, r126), mask) }
        q0: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u64.less_than(r127, other))
        r128: liblapzt.integer.u64 = BRANCH (q0) { liblapzt.integer.u64.subtract.wrapping(r127, other) } { r127 }
        quotient: liblapzt.integer.u64 = [[[[[[q0, q1], [q2, q3]], [[q4, q5], [q6, q7]]], [[[q8, q9], [q10, q11]], [[q12, q13], [q14, q15]]]], [[[[q16, q17], [q18, q19]], [[q20, q21], [q22, q23]]], [[[q24, q25], [q26, q27]], [[q28, q29], [q30, q31]]]]], [[[[[q32, q33], [q34, q35]], [[q36, q37], [q38, q39]]], [[[q40, q41], [q42, q43]], [[q44, q45], [q46, q47]]]], [[[[q48, q49], [q50, q51]], [[q52, q53], [q54, q55]]], [[[q56, q57], [q58, q59]], [[q60, q61], [q62, q63]]]]]]
        [quotient, r128]
    }
}

// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u64.divide.wrapping = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u64.divide.saturating = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u64.divide.checked = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.boolean, liblapzt.integer.u64] {
    zero: liblapzt.boolean = liblapzt.integer.u64.equal(other, liblapzt.integer.u64.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u64.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u64.remainder.wrapping = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    zero: liblapzt.boolean = liblapzt.integer.u64.equal(other, liblapzt.integer.u64.MIN)
    BRANCH (zero) {
        liblapzt.integer.u64.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u64.remainder.saturating = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) liblapzt.integer.u64 {
    zero: liblapzt.boolean = liblapzt.integer.u64.equal(other, liblapzt.integer.u64.MIN)
    BRANCH (zero) {
        liblapzt.integer.u64.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u64.remainder.checked = (self: liblapzt.integer.u64, other: liblapzt.integer.u64) [liblapzt.boolean, liblapzt.integer.u64] {
    zero: liblapzt.boolean = liblapzt.integer.u64.equal(other, liblapzt.integer.u64.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u64.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u64.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}
