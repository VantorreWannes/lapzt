liblapzt.u4.erased = [liblapzt.u2.erased, liblapzt.u2.erased]

// A 4-bit unsigned integer stored as a pair of u2 words. Operations
// are defined in terms of the smaller word.
liblapzt.u4 = liblapzt.u4.erased

liblapzt.u4.zero.erased: liblapzt.u4.erased = [liblapzt.u2.zero.erased, liblapzt.u2.zero.erased]
liblapzt.u4.one.erased: liblapzt.u4.erased = [liblapzt.u2.one.erased, liblapzt.u2.zero.erased]
liblapzt.u4.maximum.erased: liblapzt.u4.erased = [liblapzt.u2.maximum.erased, liblapzt.u2.maximum.erased]

// The additive identity, with every bit clear.
liblapzt.u4.zero: liblapzt.u4 = liblapzt.u4.zero.erased
// The value one, with only the least significant bit set.
liblapzt.u4.one: liblapzt.u4 = liblapzt.u4.one.erased
// The largest representable value, with every bit set.
liblapzt.u4.maximum: liblapzt.u4 = liblapzt.u4.maximum.erased

liblapzt.u4.not.erased = (a: liblapzt.u4) liblapzt.u4 {
    [low, high] = a
    [liblapzt.u2.not(low), liblapzt.u2.not(high)]
}

// Returns the bitwise complement of a, flipping every bit.
liblapzt.u4.not = liblapzt.u4.not.erased

liblapzt.u4.and.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.and(al, bl), liblapzt.u2.and(ah, bh)]
}

// Returns the bitwise AND of a and b.
liblapzt.u4.and = liblapzt.u4.and.erased

liblapzt.u4.or.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.or(al, bl), liblapzt.u2.or(ah, bh)]
}

// Returns the bitwise OR of a and b.
liblapzt.u4.or = liblapzt.u4.or.erased

liblapzt.u4.xor.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.xor(al, bl), liblapzt.u2.xor(ah, bh)]
}

// Returns the bitwise XOR of a and b.
liblapzt.u4.xor = liblapzt.u4.xor.erased

liblapzt.u4.nand.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.nand(al, bl), liblapzt.u2.nand(ah, bh)]
}

// Returns the bitwise NAND of a and b.
liblapzt.u4.nand = liblapzt.u4.nand.erased

liblapzt.u4.nor.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.nor(al, bl), liblapzt.u2.nor(ah, bh)]
}

// Returns the bitwise NOR of a and b.
liblapzt.u4.nor = liblapzt.u4.nor.erased

liblapzt.u4.xnor.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [liblapzt.u2.xnor(al, bl), liblapzt.u2.xnor(ah, bh)]
}

// Returns the bitwise XNOR of a and b.
liblapzt.u4.xnor = liblapzt.u4.xnor.erased

liblapzt.u4.from.bool.erased = (a: liblapzt.bool) liblapzt.u4 {
    [liblapzt.u2.from.bool(a), liblapzt.u2.zero]
}

// Returns one when a is true and zero when a is false.
liblapzt.u4.from.bool = liblapzt.u4.from.bool.erased

// Returns the sum of a and b as a pair [sum, carry], where carry is
// the carry out of the top bit.
liblapzt.u4.add.carry = (a: liblapzt.u4, b: liblapzt.u4) [liblapzt.u4, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, cl] = liblapzt.u2.add.carry(al, bl)
    [sh, ch] = liblapzt.u2.add.carry(ah, bh)
    [sh2, ch2] = liblapzt.u2.add.carry(sh, liblapzt.u2.from.bool(cl))
    [[sl, sh2], liblapzt.bool.or(ch, ch2)]
}

liblapzt.u4.add.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [sum, carry] = liblapzt.u4.add.carry(a, b)
    sum
}

// Returns the sum of a and b, discarding the carry out of the top
// bit.
liblapzt.u4.add = liblapzt.u4.add.erased

// Returns a - b as a pair [difference, borrow], where borrow is the
// borrow out of the top bit.
liblapzt.u4.sub.borrow = (a: liblapzt.u4, b: liblapzt.u4) [liblapzt.u4, liblapzt.bool] {
    [al, ah] = a
    [bl, bh] = b
    [sl, blw] = liblapzt.u2.sub.borrow(al, bl)
    [sh, bhw] = liblapzt.u2.sub.borrow(ah, bh)
    [sh2, bhw2] = liblapzt.u2.sub.borrow(sh, liblapzt.u2.from.bool(blw))
    [[sl, sh2], liblapzt.bool.or(bhw, bhw2)]
}

liblapzt.u4.sub.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [difference, borrow] = liblapzt.u4.sub.borrow(a, b)
    difference
}

// Returns a - b modulo 16, discarding the borrow. Wraps when b is
// greater than a.
liblapzt.u4.sub = liblapzt.u4.sub.erased

// Returns the sum of a, b and c as a pair [sum, carry].
liblapzt.u4.add3 = (a: liblapzt.u4, b: liblapzt.u4, c: liblapzt.u4) [liblapzt.u4, liblapzt.u4] {
    [s1, c1] = liblapzt.u4.add.carry(a, b)
    [s2, c2] = liblapzt.u4.add.carry(s1, c)
    carry: liblapzt.u4 = liblapzt.u4.add(liblapzt.u4.from.bool(c1), liblapzt.u4.from.bool(c2))
    [s2, carry]
}

// Returns the full 8-bit product of a and b as a pair
// [low, high].
liblapzt.u4.mul.full = (a: liblapzt.u4, b: liblapzt.u4) [liblapzt.u4, liblapzt.u4] {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u2.mul.full(al, bl)
    [cl, ch] = liblapzt.u2.mul.full(al, bh)
    [dl, dh] = liblapzt.u2.mul.full(ah, bl)
    [el, eh] = liblapzt.u2.mul.full(ah, bh)
    [low.sum, low.carry] = liblapzt.u2.add3(lh, cl, dl)
    low: liblapzt.u4 = [ll, low.sum]
    [high.sum, high.carry] = liblapzt.u2.add3(ch, dh, el)
    [high.sum2, high.carry2] = liblapzt.u2.add.carry(high.sum, low.carry)
    high.high: liblapzt.u2 = liblapzt.u2.add(liblapzt.u2.add(eh, high.carry), liblapzt.u2.from.bool(high.carry2))
    high: liblapzt.u4 = [high.sum2, high.high]
    [low, high]
}

liblapzt.u4.mul.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    [al, ah] = a
    [bl, bh] = b
    [ll, lh] = liblapzt.u2.mul.full(al, bl)
    cross: liblapzt.u2 = liblapzt.u2.add(liblapzt.u2.mul(al, bh), liblapzt.u2.mul(ah, bl))
    [ll, liblapzt.u2.add(lh, cross)]
}

// Returns the low 4 bits of the product of a and b, discarding the
// high half.
liblapzt.u4.mul = liblapzt.u4.mul.erased

// Returns a shifted left by one bit. The top bit is discarded and
// the low bit becomes zero.
liblapzt.u4.shl1 = (a: liblapzt.u4) liblapzt.u4 {
    [low, high] = a
    [liblapzt.u2.shl1(low), liblapzt.u2.or(liblapzt.u2.shl1(high), liblapzt.u2.from.bool(liblapzt.u2.msb(low)))]
}

// Returns a with its least significant bit replaced by bit.
liblapzt.u4.with.lsb = (a: liblapzt.u4, bit: liblapzt.bool) liblapzt.u4 {
    [low, high] = a
    [liblapzt.u2.with.lsb(low, bit), high]
}

// Returns the most significant bit of a as a u1.
liblapzt.u4.msb = (a: liblapzt.u4) liblapzt.u1 {
    [low, high] = a
    liblapzt.u2.msb(high)
}

liblapzt.u4.eq.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    liblapzt.bool.and(liblapzt.u2.eq(al, bl), liblapzt.u2.eq(ah, bh))
}

// Returns true when a and b have the same value.
liblapzt.u4.eq = liblapzt.u4.eq.erased

liblapzt.u4.ne.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    liblapzt.bool.not(liblapzt.u4.eq(a, b))
}

// Returns true when a and b differ.
liblapzt.u4.ne = liblapzt.u4.ne.erased

liblapzt.u4.lt.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    [al, ah] = a
    [bl, bh] = b
    high.lt: liblapzt.bool = liblapzt.u2.lt(ah, bh)
    high.eq: liblapzt.bool = liblapzt.u2.eq(ah, bh)
    low.lt: liblapzt.bool = liblapzt.u2.lt(al, bl)
    liblapzt.bool.or(high.lt, liblapzt.bool.and(high.eq, low.lt))
}

// Returns true when a is less than b.
liblapzt.u4.lt = liblapzt.u4.lt.erased

liblapzt.u4.le.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    liblapzt.bool.or(liblapzt.u4.lt(a, b), liblapzt.u4.eq(a, b))
}

// Returns true when a is less than or equal to b.
liblapzt.u4.le = liblapzt.u4.le.erased

liblapzt.u4.gt.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    liblapzt.u4.lt(b, a)
}

// Returns true when a is greater than b.
liblapzt.u4.gt = liblapzt.u4.gt.erased

liblapzt.u4.ge.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.bool {
    liblapzt.u4.le(b, a)
}

// Returns true when a is greater than or equal to b.
liblapzt.u4.ge = liblapzt.u4.ge.erased

liblapzt.u4.select.erased = (flag: liblapzt.bool, when.true: liblapzt.u4, when.false: liblapzt.u4) liblapzt.u4 {
    [tl, th] = when.true
    [fl, fh] = when.false
    [liblapzt.u2.select(flag, tl, fl), liblapzt.u2.select(flag, th, fh)]
}

// Returns when.true when flag is true, otherwise when.false.
liblapzt.u4.select = liblapzt.u4.select.erased

liblapzt.u4.min.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    liblapzt.u4.select(liblapzt.u4.lt(a, b), a, b)
}

// Returns the smaller of a and b.
liblapzt.u4.min = liblapzt.u4.min.erased

liblapzt.u4.max.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    liblapzt.u4.select(liblapzt.u4.gt(a, b), a, b)
}

// Returns the larger of a and b.
liblapzt.u4.max = liblapzt.u4.max.erased

liblapzt.u4.inc.erased = (a: liblapzt.u4) liblapzt.u4 {
    liblapzt.u4.add(a, liblapzt.u4.one)
}

// Returns a plus one, wrapping to zero at the maximum value.
liblapzt.u4.inc = liblapzt.u4.inc.erased

liblapzt.u4.dec.erased = (a: liblapzt.u4) liblapzt.u4 {
    liblapzt.u4.sub(a, liblapzt.u4.one)
}

// Returns a minus one, wrapping to the maximum value at zero.
liblapzt.u4.dec = liblapzt.u4.dec.erased

liblapzt.u4.is.zero.erased = (a: liblapzt.u4) liblapzt.bool {
    [low, high] = a
    liblapzt.bool.and(liblapzt.u2.is.zero(low), liblapzt.u2.is.zero(high))
}

// Returns true when every bit of a is clear.
liblapzt.u4.is.zero = liblapzt.u4.is.zero.erased

liblapzt.u4.is.one.erased = (a: liblapzt.u4) liblapzt.bool {
    [low, high] = a
    liblapzt.bool.and(liblapzt.u2.is.one(low), liblapzt.u2.is.zero(high))
}

// Returns true when a equals one.
liblapzt.u4.is.one = liblapzt.u4.is.one.erased

liblapzt.u4.to.bool.erased = (a: liblapzt.u4) liblapzt.bool {
    liblapzt.bool.not(liblapzt.u4.is.zero(a))
}

// Returns true when a is nonzero.
liblapzt.u4.to.bool = liblapzt.u4.to.bool.erased

liblapzt.u4.div.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    zero: liblapzt.bool = liblapzt.u4.is.zero(b)
    BRANCH (zero) {
        liblapzt.u4.zero
    } {
        [[a0, a1], [a2, a3]] = a
        r0: liblapzt.u4 = liblapzt.u4.zero
        r1: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r0), a3)
        q3: liblapzt.bool = liblapzt.u4.ge(r1, b)
        r2: liblapzt.u4 = liblapzt.u4.select(q3, liblapzt.u4.sub(r1, b), r1)
        r3: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r2), a2)
        q2: liblapzt.bool = liblapzt.u4.ge(r3, b)
        r4: liblapzt.u4 = liblapzt.u4.select(q2, liblapzt.u4.sub(r3, b), r3)
        r5: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r4), a1)
        q1: liblapzt.bool = liblapzt.u4.ge(r5, b)
        r6: liblapzt.u4 = liblapzt.u4.select(q1, liblapzt.u4.sub(r5, b), r5)
        r7: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r6), a0)
        q0: liblapzt.bool = liblapzt.u4.ge(r7, b)
        r8: liblapzt.u4 = liblapzt.u4.select(q0, liblapzt.u4.sub(r7, b), r7)
        [[q0, q1], [q2, q3]]
    }
}

// Returns the quotient of a divided by b, rounding toward zero.
// Returns zero when b is zero.
liblapzt.u4.div = liblapzt.u4.div.erased

liblapzt.u4.mod.erased = (a: liblapzt.u4, b: liblapzt.u4) liblapzt.u4 {
    zero: liblapzt.bool = liblapzt.u4.is.zero(b)
    BRANCH (zero) {
        liblapzt.u4.zero
    } {
        [[a0, a1], [a2, a3]] = a
        r0: liblapzt.u4 = liblapzt.u4.zero
        r1: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r0), a3)
        q3: liblapzt.bool = liblapzt.u4.ge(r1, b)
        r2: liblapzt.u4 = liblapzt.u4.select(q3, liblapzt.u4.sub(r1, b), r1)
        r3: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r2), a2)
        q2: liblapzt.bool = liblapzt.u4.ge(r3, b)
        r4: liblapzt.u4 = liblapzt.u4.select(q2, liblapzt.u4.sub(r3, b), r3)
        r5: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r4), a1)
        q1: liblapzt.bool = liblapzt.u4.ge(r5, b)
        r6: liblapzt.u4 = liblapzt.u4.select(q1, liblapzt.u4.sub(r5, b), r5)
        r7: liblapzt.u4 = liblapzt.u4.with.lsb(liblapzt.u4.shl1(r6), a0)
        q0: liblapzt.bool = liblapzt.u4.ge(r7, b)
        r8: liblapzt.u4 = liblapzt.u4.select(q0, liblapzt.u4.sub(r7, b), r7)
        r8
    }
}

// Returns the remainder of a divided by b. Returns zero when b is
// zero.
liblapzt.u4.mod = liblapzt.u4.mod.erased
