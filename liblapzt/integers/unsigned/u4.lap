//! 4-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u4.erased = [liblapzt.integer.u2, liblapzt.integer.u2]
__liblapzt.integer.u4.MIN.erased = [liblapzt.integer.u2.MIN, liblapzt.integer.u2.MIN]
__liblapzt.integer.u4.MAX.erased = [liblapzt.integer.u2.MAX, liblapzt.integer.u2.MAX]

// --- Types ---

liblapzt.integer.u4 = __liblapzt.integer.u4.erased
liblapzt.integer.u4.MIN = __liblapzt.integer.u4.MIN.erased
liblapzt.integer.u4.MAX = __liblapzt.integer.u4.MAX.erased

// --- Functions ---

// Returns the bitwise complement of self.
liblapzt.integer.u4.not = (self: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [liblapzt.integer.u2.not(self_low), liblapzt.integer.u2.not(self_high)]
}

// Returns the bitwise and of self and other.
liblapzt.integer.u4.and = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u2.and(self_low, other_low), liblapzt.integer.u2.and(self_high, other_high)]
}

// Returns the bitwise or of self and other.
liblapzt.integer.u4.or = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u2.or(self_low, other_low), liblapzt.integer.u2.or(self_high, other_high)]
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u4.not.and = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u2.not.and(self_low, other_low), liblapzt.integer.u2.not.and(self_high, other_high)]
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u4.not.or = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u2.not.or(self_low, other_low), liblapzt.integer.u2.not.or(self_high, other_high)]
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u4.exclusive.or = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [liblapzt.integer.u2.exclusive.or(self_low, other_low), liblapzt.integer.u2.exclusive.or(self_high, other_high)]
}

// Returns true when self and other have the same value.
liblapzt.integer.u4.equal = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_equal: liblapzt.boolean = liblapzt.integer.u2.equal(self_low, other_low)
    high_equal: liblapzt.boolean = liblapzt.integer.u2.equal(self_high, other_high)
    liblapzt.boolean.and(low_equal, high_equal)
}

// Returns true when self and other differ.
liblapzt.integer.u4.not.equal = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    low_differ: liblapzt.boolean = liblapzt.integer.u2.not.equal(self_low, other_low)
    high_differ: liblapzt.boolean = liblapzt.integer.u2.not.equal(self_high, other_high)
    liblapzt.boolean.or(low_differ, high_differ)
}

// Returns true when self is greater than other.
liblapzt.integer.u4.greater_than = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_greater: liblapzt.boolean = liblapzt.integer.u2.greater_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u2.equal(self_high, other_high)
    low_greater: liblapzt.boolean = liblapzt.integer.u2.greater_than(self_low, other_low)
    liblapzt.boolean.or(high_greater, liblapzt.boolean.and(high_equal, low_greater))
}

// Returns true when self is less than other.
liblapzt.integer.u4.less_than = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.boolean {
    [self_low, self_high] = self
    [other_low, other_high] = other
    high_less: liblapzt.boolean = liblapzt.integer.u2.less_than(self_high, other_high)
    high_equal: liblapzt.boolean = liblapzt.integer.u2.equal(self_high, other_high)
    low_less: liblapzt.boolean = liblapzt.integer.u2.less_than(self_low, other_low)
    liblapzt.boolean.or(high_less, liblapzt.boolean.and(high_equal, low_less))
}

// Returns the smaller of self and other.
liblapzt.integer.u4.min = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    less: liblapzt.boolean = liblapzt.integer.u4.less_than(self, other)
    BRANCH (less) { self } { other }
}

// Returns the larger of self and other.
liblapzt.integer.u4.max = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    greater: liblapzt.boolean = liblapzt.integer.u4.greater_than(self, other)
    BRANCH (greater) { self } { other }
}

// Returns the sum of self and other modulo 2^4.
liblapzt.integer.u4.add.wrapping = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u2 = liblapzt.integer.u2.and(self_low, other_low)
    xor_high: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(xor_high, carry_low)
    [sum_low, sum_high]
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u4.add.checked = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.boolean, liblapzt.integer.u4] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    sum_low: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(self_low, other_low)
    carry_low: liblapzt.integer.u2 = liblapzt.integer.u2.and(self_low, other_low)
    xor_high: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(self_high, other_high)
    sum_high: liblapzt.integer.u2 = liblapzt.integer.u2.add.wrapping(xor_high, carry_low)
    carry_high: liblapzt.integer.u2 = liblapzt.integer.u2.or(liblapzt.integer.u2.and(self_high, other_high), liblapzt.integer.u2.and(carry_low, xor_high))
    BRANCH (carry_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u4.MIN]
    } {
        [liblapzt.boolean.TRUE, [sum_low, sum_high]]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u4.add.saturating = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [ok, sum] = liblapzt.integer.u4.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u4.MAX }
}

// Returns the difference of self and other modulo 2^4.
liblapzt.integer.u4.subtract.wrapping = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u2.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(xor_high, borrow_low)
    [diff_low, diff_high]
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u4.subtract.checked = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.boolean, liblapzt.integer.u4] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    diff_low: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(self_low, other_low)
    borrow_low: liblapzt.boolean = liblapzt.integer.u2.less_than(self_low, other_low)
    xor_high: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(self_high, other_high)
    diff_high: liblapzt.integer.u2 = liblapzt.integer.u2.subtract.wrapping(xor_high, borrow_low)
    borrow_high: liblapzt.boolean = liblapzt.boolean.or(liblapzt.integer.u2.less_than(self_high, other_high), liblapzt.boolean.and(borrow_low, liblapzt.integer.u2.not(xor_high)))
    BRANCH (borrow_high) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u4.MIN]
    } {
        [liblapzt.boolean.TRUE, [diff_low, diff_high]]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u4.subtract.saturating = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [ok, difference] = liblapzt.integer.u4.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u4.MIN }
}

// Returns the full 2*4-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u4.multiply.full = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.integer.u4, liblapzt.integer.u4] {
    [self_low, self_high] = self
    [other_low, other_high] = other
    [p_low, p_high] = liblapzt.integer.u2.multiply.full(self_low, other_low)
    lh: liblapzt.integer.u4 = liblapzt.integer.u2.multiply.full(self_low, other_high)
    hl: liblapzt.integer.u4 = liblapzt.integer.u2.multiply.full(self_high, other_low)
    [q_ok, q] = liblapzt.integer.u4.add.checked(lh, hl)
    [q_low, q_high] = q
    [low_ok, low] = liblapzt.integer.u4.add.checked([p_low, p_high], [liblapzt.integer.u2.MIN, q_low])
    carry_low: liblapzt.boolean = liblapzt.boolean.not(low_ok)
    [r_low, r_high] = liblapzt.integer.u2.multiply.full(self_high, other_high)
    [high_ok, high] = liblapzt.integer.u4.add.checked([q_high, liblapzt.integer.u2.MIN], [r_low, r_high])
    one: liblapzt.integer.u4 = liblapzt.integer.u4.subtract.wrapping(liblapzt.integer.u4.MIN, liblapzt.integer.u4.MAX)
    high2: liblapzt.integer.u4 = BRANCH (carry_low) { liblapzt.integer.u4.add.wrapping(high, one) } { high }
    carry_high: liblapzt.integer.u4 = BRANCH (liblapzt.boolean.not(q_ok)) { [liblapzt.integer.u2.MIN, liblapzt.integer.u2.MAX] } { liblapzt.integer.u4.MIN }
    high3: liblapzt.integer.u4 = liblapzt.integer.u4.add.wrapping(high2, carry_high)
    [low, high3]
}

// Returns the low 4 bits of the product of self and other.
liblapzt.integer.u4.multiply.wrapping = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [low, high] = liblapzt.integer.u4.multiply.full(self, other)
    low
}

// Returns [ok, product]. Ok is false when the product overflows,
// and the value is then MIN.
liblapzt.integer.u4.multiply.checked = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.boolean, liblapzt.integer.u4] {
    [low, high] = liblapzt.integer.u4.multiply.full(self, other)
    [liblapzt.integer.u4.equal(high, liblapzt.integer.u4.MIN), low]
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u4.multiply.saturating = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [ok, low] = liblapzt.integer.u4.multiply.checked(self, other)
    BRANCH (ok) { low } { liblapzt.integer.u4.MAX }
}

// Returns [quotient, remainder] of self divided by other. Returns
// [MAX, MIN] when other is zero.
liblapzt.integer.u4.divide.full = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.integer.u4, liblapzt.integer.u4] {
    zero: liblapzt.boolean = liblapzt.integer.u4.equal(other, liblapzt.integer.u4.MIN)
    BRANCH (zero) {
        [liblapzt.integer.u4.MAX, liblapzt.integer.u4.MIN]
    } {
        [[a0, a1], [a2, a3]] = self
        one: liblapzt.integer.u4 = liblapzt.integer.u4.subtract.wrapping(liblapzt.integer.u4.MIN, liblapzt.integer.u4.MAX)
        mask: liblapzt.integer.u4 = liblapzt.integer.u4.not(one)
        r0: liblapzt.integer.u4 = liblapzt.integer.u4.MIN
        r1: liblapzt.integer.u4 = BRANCH (a3) { liblapzt.integer.u4.or(liblapzt.integer.u4.add.wrapping(r0, r0), one) } { liblapzt.integer.u4.and(liblapzt.integer.u4.add.wrapping(r0, r0), mask) }
        q3: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u4.less_than(r1, other))
        r2: liblapzt.integer.u4 = BRANCH (q3) { liblapzt.integer.u4.subtract.wrapping(r1, other) } { r1 }
        r3: liblapzt.integer.u4 = BRANCH (a2) { liblapzt.integer.u4.or(liblapzt.integer.u4.add.wrapping(r2, r2), one) } { liblapzt.integer.u4.and(liblapzt.integer.u4.add.wrapping(r2, r2), mask) }
        q2: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u4.less_than(r3, other))
        r4: liblapzt.integer.u4 = BRANCH (q2) { liblapzt.integer.u4.subtract.wrapping(r3, other) } { r3 }
        r5: liblapzt.integer.u4 = BRANCH (a1) { liblapzt.integer.u4.or(liblapzt.integer.u4.add.wrapping(r4, r4), one) } { liblapzt.integer.u4.and(liblapzt.integer.u4.add.wrapping(r4, r4), mask) }
        q1: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u4.less_than(r5, other))
        r6: liblapzt.integer.u4 = BRANCH (q1) { liblapzt.integer.u4.subtract.wrapping(r5, other) } { r5 }
        r7: liblapzt.integer.u4 = BRANCH (a0) { liblapzt.integer.u4.or(liblapzt.integer.u4.add.wrapping(r6, r6), one) } { liblapzt.integer.u4.and(liblapzt.integer.u4.add.wrapping(r6, r6), mask) }
        q0: liblapzt.boolean = liblapzt.boolean.not(liblapzt.integer.u4.less_than(r7, other))
        r8: liblapzt.integer.u4 = BRANCH (q0) { liblapzt.integer.u4.subtract.wrapping(r7, other) } { r7 }
        quotient: liblapzt.integer.u4 = [[q0, q1], [q2, q3]]
        [quotient, r8]
    }
}

// Returns self divided by other. Division cannot overflow, so this
// matches saturating. Division by zero saturates to MAX.
liblapzt.integer.u4.divide.wrapping = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
    quotient
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u4.divide.saturating = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
    quotient
}

// Returns [ok, quotient]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u4.divide.checked = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.boolean, liblapzt.integer.u4] {
    zero: liblapzt.boolean = liblapzt.integer.u4.equal(other, liblapzt.integer.u4.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u4.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
        [liblapzt.boolean.TRUE, quotient]
    }
}

// Returns the remainder of self divided by other. Division by zero
// saturates to MAX.
liblapzt.integer.u4.remainder.wrapping = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    zero: liblapzt.boolean = liblapzt.integer.u4.equal(other, liblapzt.integer.u4.MIN)
    BRANCH (zero) {
        liblapzt.integer.u4.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
        remainder
    }
}

// Returns the remainder of self divided by other, saturated at MAX.
liblapzt.integer.u4.remainder.saturating = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) liblapzt.integer.u4 {
    zero: liblapzt.boolean = liblapzt.integer.u4.equal(other, liblapzt.integer.u4.MIN)
    BRANCH (zero) {
        liblapzt.integer.u4.MAX
    } {
        [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
        remainder
    }
}

// Returns [ok, remainder]. Ok is false when other is zero, and the
// value is then MIN.
liblapzt.integer.u4.remainder.checked = (self: liblapzt.integer.u4, other: liblapzt.integer.u4) [liblapzt.boolean, liblapzt.integer.u4] {
    zero: liblapzt.boolean = liblapzt.integer.u4.equal(other, liblapzt.integer.u4.MIN)
    BRANCH (zero) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u4.MIN]
    } {
        [quotient, remainder] = liblapzt.integer.u4.divide.full(self, other)
        [liblapzt.boolean.TRUE, remainder]
    }
}

// Converts self to void, truncating or zero extending.
liblapzt.integer.u4.to.void = (self: liblapzt.integer.u4) liblapzt.integer.void {
    []
}

// Converts a void to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.void = (value: liblapzt.integer.void) liblapzt.integer.u4 {
    liblapzt.integer.u4.MIN
}

// Converts self to u1, truncating or zero extending.
liblapzt.integer.u4.to.u1 = (self: liblapzt.integer.u4) liblapzt.integer.u1 {
    [low, high] = self
    liblapzt.integer.u2.to.u1(low)
}

// Converts a u1 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u1 = (value: liblapzt.integer.u1) liblapzt.integer.u4 {
    [liblapzt.integer.u1.to.u2(value), liblapzt.integer.u2.MIN]
}

// Converts self to u2, truncating or zero extending.
liblapzt.integer.u4.to.u2 = (self: liblapzt.integer.u4) liblapzt.integer.u2 {
    [low, high] = self
    low
}

// Converts a u2 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u2 = (value: liblapzt.integer.u2) liblapzt.integer.u4 {
    [liblapzt.integer.u2.to.u2(value), liblapzt.integer.u2.MIN]
}

// Converts self to u4, truncating or zero extending.
liblapzt.integer.u4.to.u4 = (self: liblapzt.integer.u4) liblapzt.integer.u4 {
    self
}

// Converts a u4 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u4 = (value: liblapzt.integer.u4) liblapzt.integer.u4 {
    value
}

// Converts self to u8, truncating or zero extending.
liblapzt.integer.u4.to.u8 = (self: liblapzt.integer.u4) liblapzt.integer.u8 {
    [liblapzt.integer.u4.to.u4(self), liblapzt.integer.u4.MIN]
}

// Converts a u8 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u8 = (value: liblapzt.integer.u8) liblapzt.integer.u4 {
    [low, high] = value
    low
}

// Converts self to u16, truncating or zero extending.
liblapzt.integer.u4.to.u16 = (self: liblapzt.integer.u4) liblapzt.integer.u16 {
    [liblapzt.integer.u4.to.u8(self), liblapzt.integer.u8.MIN]
}

// Converts a u16 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u16 = (value: liblapzt.integer.u16) liblapzt.integer.u4 {
    [low, high] = value
    liblapzt.integer.u8.to.u4(low)
}

// Converts self to u32, truncating or zero extending.
liblapzt.integer.u4.to.u32 = (self: liblapzt.integer.u4) liblapzt.integer.u32 {
    [liblapzt.integer.u4.to.u16(self), liblapzt.integer.u16.MIN]
}

// Converts a u32 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u32 = (value: liblapzt.integer.u32) liblapzt.integer.u4 {
    [low, high] = value
    liblapzt.integer.u16.to.u4(low)
}

// Converts self to u64, truncating or zero extending.
liblapzt.integer.u4.to.u64 = (self: liblapzt.integer.u4) liblapzt.integer.u64 {
    [liblapzt.integer.u4.to.u32(self), liblapzt.integer.u32.MIN]
}

// Converts a u64 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u64 = (value: liblapzt.integer.u64) liblapzt.integer.u4 {
    [low, high] = value
    liblapzt.integer.u32.to.u4(low)
}

// Converts self to u128, truncating or zero extending.
liblapzt.integer.u4.to.u128 = (self: liblapzt.integer.u4) liblapzt.integer.u128 {
    [liblapzt.integer.u4.to.u64(self), liblapzt.integer.u64.MIN]
}

// Converts a u128 to liblapzt.integer.u4, truncating or zero extending.
liblapzt.integer.u4.from.u128 = (value: liblapzt.integer.u128) liblapzt.integer.u4 {
    [low, high] = value
    liblapzt.integer.u64.to.u4(low)
}
