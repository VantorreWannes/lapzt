liblapzt.u1.erased = BIT
liblapzt.bool.erased = BIT

// A one-bit unsigned integer, stored as a single bit.
liblapzt.u1 = liblapzt.u1.erased
liblapzt.bool = liblapzt.bool.erased

liblapzt.u1.one.erased: liblapzt.u1.erased = NAND(BIT, NAND(BIT, BIT))
liblapzt.u1.zero.erased: liblapzt.u1.erased = NAND(liblapzt.u1.one.erased, liblapzt.u1.one.erased)
liblapzt.u1.maximum.erased: liblapzt.u1.erased = liblapzt.u1.one.erased

// The value one, with the bit set.
liblapzt.u1.one: liblapzt.u1 = liblapzt.u1.one.erased
// The additive identity, with the bit clear.
liblapzt.u1.zero: liblapzt.u1 = liblapzt.u1.zero.erased
// The largest representable value, which is one.
liblapzt.u1.maximum: liblapzt.u1 = liblapzt.u1.maximum.erased

// Returns the bitwise complement of a, flipping the bit.
liblapzt.u1.not = (a: liblapzt.u1) liblapzt.u1 {
    NAND(a, a)
}

// Returns the bitwise AND of a and b.
liblapzt.u1.and = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    n: liblapzt.u1 = NAND(a, b)
    liblapzt.u1.not(n)
}

// Returns the bitwise OR of a and b.
liblapzt.u1.or = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    na: liblapzt.u1 = NAND(a, a)
    nb: liblapzt.u1 = NAND(b, b)
    NAND(na, nb)
}

// Returns the bitwise XOR of a and b.
liblapzt.u1.xor = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    n: liblapzt.u1 = NAND(a, b)
    na: liblapzt.u1 = NAND(a, n)
    nb: liblapzt.u1 = NAND(b, n)
    NAND(na, nb)
}

// Returns the bitwise NAND of a and b.
liblapzt.u1.nand = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    NAND(a, b)
}

// Returns the bitwise NOR of a and b.
liblapzt.u1.nor = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    na: liblapzt.u1 = NAND(a, a)
    nb: liblapzt.u1 = NAND(b, b)
    liblapzt.u1.and(na, nb)
}

// Returns the bitwise XNOR of a and b.
liblapzt.u1.xnor = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.not(liblapzt.u1.xor(a, b))
}

// Returns false only when a is one and b is zero.
liblapzt.u1.implies = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    na: liblapzt.u1 = NAND(a, a)
    liblapzt.u1.or(na, b)
}

// Returns one when a is true and zero when a is false.
liblapzt.u1.from.bool = (a: liblapzt.bool) liblapzt.u1 {
    a
}

// Returns the sum of a and b as a pair [sum, carry].
liblapzt.u1.add.carry = (a: liblapzt.u1, b: liblapzt.u1) [liblapzt.u1, liblapzt.bool] {
    [liblapzt.u1.xor(a, b), liblapzt.u1.and(a, b)]
}

// Returns the sum of a and b modulo 2, discarding the carry.
liblapzt.u1.add = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    [sum, carry] = liblapzt.u1.add.carry(a, b)
    sum
}

// Returns a - b as a pair [difference, borrow].
liblapzt.u1.sub.borrow = (a: liblapzt.u1, b: liblapzt.u1) [liblapzt.u1, liblapzt.bool] {
    na: liblapzt.u1 = liblapzt.u1.not(a)
    [liblapzt.u1.xor(a, b), liblapzt.u1.and(na, b)]
}

// Returns a - b modulo 2, discarding the borrow.
liblapzt.u1.sub = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    [difference, borrow] = liblapzt.u1.sub.borrow(a, b)
    difference
}

// Returns the sum of a, b and c as a pair [sum, carry].
liblapzt.u1.add3 = (a: liblapzt.u1, b: liblapzt.u1, c: liblapzt.u1) [liblapzt.u1, liblapzt.u1] {
    [s1, c1] = liblapzt.u1.add.carry(a, b)
    [s2, c2] = liblapzt.u1.add.carry(s1, c)
    carry: liblapzt.u1 = liblapzt.u1.add(liblapzt.u1.from.bool(c1), liblapzt.u1.from.bool(c2))
    [s2, carry]
}

// Returns the product of a and b as a pair [low, high].
liblapzt.u1.mul.full = (a: liblapzt.u1, b: liblapzt.u1) [liblapzt.u1, liblapzt.u1] {
    [liblapzt.u1.and(a, b), liblapzt.u1.zero]
}

// Returns the product of a and b modulo 2.
liblapzt.u1.mul = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    [low, high] = liblapzt.u1.mul.full(a, b)
    low
}

// Returns a when b is one, and zero when b is zero.
liblapzt.u1.div = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.and(a, b)
}

// Returns the remainder of a divided by b, always zero for
// one-bit values.
liblapzt.u1.mod = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.zero
}

// Returns true when a and b have the same value.
liblapzt.u1.eq = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    liblapzt.u1.not(liblapzt.u1.xor(a, b))
}

// Returns true when a and b differ.
liblapzt.u1.ne = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    liblapzt.u1.xor(a, b)
}

// Returns true when a is less than b.
liblapzt.u1.lt = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    na: liblapzt.u1 = liblapzt.u1.not(a)
    liblapzt.u1.and(na, b)
}

// Returns true when a is less than or equal to b.
liblapzt.u1.le = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    na: liblapzt.u1 = liblapzt.u1.not(a)
    liblapzt.u1.or(na, b)
}

// Returns true when a is greater than b.
liblapzt.u1.gt = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    nb: liblapzt.u1 = liblapzt.u1.not(b)
    liblapzt.u1.and(a, nb)
}

// Returns true when a is greater than or equal to b.
liblapzt.u1.ge = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.bool {
    nb: liblapzt.u1 = liblapzt.u1.not(b)
    liblapzt.u1.or(a, nb)
}

// Returns the smaller of a and b.
liblapzt.u1.min = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.and(a, b)
}

// Returns the larger of a and b.
liblapzt.u1.max = (a: liblapzt.u1, b: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.or(a, b)
}

// Returns a plus one modulo 2, which flips the bit.
liblapzt.u1.inc = (a: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.not(a)
}

// Returns a minus one modulo 2, which flips the bit.
liblapzt.u1.dec = (a: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.not(a)
}

// Returns when.one when flag is true, otherwise when.zero.
liblapzt.u1.select = (flag: liblapzt.bool, when.one: liblapzt.u1, when.zero: liblapzt.u1) liblapzt.u1 {
    BRANCH (flag) { when.one } { when.zero }
}

// Returns true when a is zero.
liblapzt.u1.is.zero = (a: liblapzt.u1) liblapzt.bool {
    liblapzt.u1.not(a)
}

// Returns true when a is one.
liblapzt.u1.is.one = (a: liblapzt.u1) liblapzt.bool {
    a
}

// Returns a as a bool.
liblapzt.u1.to.bool = (a: liblapzt.u1) liblapzt.bool {
    a
}

// Returns a shifted left by one bit, which is always zero.
liblapzt.u1.shl1 = (a: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.zero
}

// Returns a with its only bit replaced by bit.
liblapzt.u1.with.lsb = (a: liblapzt.u1, bit: liblapzt.bool) liblapzt.u1 {
    bit
}

// Returns a, since the most significant bit is the only bit.
liblapzt.u1.msb = (a: liblapzt.u1) liblapzt.u1 {
    a
}
