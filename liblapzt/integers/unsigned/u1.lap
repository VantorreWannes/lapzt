//! 1-bit unsigned integer type

// --- Erased ---

__liblapzt.integer.u1.erased = BIT
__liblapzt.integer.u1.MAX.erased: __liblapzt.integer.u1.erased = NAND(BIT, NAND(BIT, BIT))
__liblapzt.integer.u1.MIN.erased: __liblapzt.integer.u1.erased = NAND(__liblapzt.integer.u1.MAX.erased, __liblapzt.integer.u1.MAX.erased)

// --- Types ---

liblapzt.integer.u1 = __liblapzt.integer.u1.erased
liblapzt.integer.u1.MIN: liblapzt.integer.u1 = __liblapzt.integer.u1.MIN.erased
liblapzt.integer.u1.MAX: liblapzt.integer.u1 = __liblapzt.integer.u1.MAX.erased

// --- Functions ---

// Returns one when boolean is true and zero when it is false.
liblapzt.integer.u1.from.bool = (boolean: liblapzt.boolean) liblapzt.integer.u1 {
    boolean
}

// Returns true when self is one.
liblapzt.integer.u1.to.bool = (self: liblapzt.integer.u1) liblapzt.boolean {
    self
}

// Returns the bitwise complement of self.
liblapzt.integer.u1.not = (self: liblapzt.integer.u1) liblapzt.integer.u1 {
    NAND(self, self)
}

// Returns the bitwise not.and of self and other.
liblapzt.integer.u1.not.and = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    NAND(self, other)
}

// Returns the bitwise and of self and other.
liblapzt.integer.u1.and = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not(liblapzt.integer.u1.not.and(self, other))
}

// Returns the bitwise or of self and other.
liblapzt.integer.u1.or = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not.and(liblapzt.integer.u1.not(self), liblapzt.integer.u1.not(other))
}

// Returns the bitwise not.or of self and other.
liblapzt.integer.u1.not.or = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not(liblapzt.integer.u1.or(self, other))
}

// Returns the bitwise exclusive.or of self and other.
liblapzt.integer.u1.exclusive.or = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not.and(liblapzt.integer.u1.not.and(self, other), liblapzt.integer.u1.or(self, other))
}

// Returns true when self and other differ.
liblapzt.integer.u1.not.equal = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.boolean {
    liblapzt.integer.u1.exclusive.or(self, other)
}

// Returns true when self and other have the same value.
liblapzt.integer.u1.equal = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.boolean {
    liblapzt.integer.u1.not(liblapzt.integer.u1.not.equal(self, other))
}

// Returns true when self is greater than other.
liblapzt.integer.u1.greater_than = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.boolean {
    liblapzt.integer.u1.and(self, liblapzt.integer.u1.not(other))
}

// Returns true when self is less than other.
liblapzt.integer.u1.less_than = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.boolean {
    liblapzt.integer.u1.and(liblapzt.integer.u1.not(self), other)
}

// Returns the smaller of self and other.
liblapzt.integer.u1.min = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.and(self, other)
}

// Returns the larger of self and other.
liblapzt.integer.u1.max = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.or(self, other)
}

// Returns the sum of self and other modulo 2.
liblapzt.integer.u1.add.wrapping = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.exclusive.or(self, other)
}

// Returns [ok, sum]. Ok is false when the sum overflows, and
// the value is then MIN.
liblapzt.integer.u1.add.checked = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.boolean, liblapzt.integer.u1] {
    overflow: liblapzt.integer.u1 = liblapzt.integer.u1.and(self, other)
    BRANCH (overflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u1.MIN]
    } {
        [liblapzt.boolean.TRUE, liblapzt.integer.u1.exclusive.or(self, other)]
    }
}

// Returns the sum of self and other, saturated at MAX.
liblapzt.integer.u1.add.saturating = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    [ok, sum] = liblapzt.integer.u1.add.checked(self, other)
    BRANCH (ok) { sum } { liblapzt.integer.u1.MAX }
}

// Returns the difference of self and other modulo 2.
liblapzt.integer.u1.subtract.wrapping = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.exclusive.or(self, other)
}

// Returns [ok, difference]. Ok is false when the difference
// underflows, and the value is then MIN.
liblapzt.integer.u1.subtract.checked = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.boolean, liblapzt.integer.u1] {
    underflow: liblapzt.boolean = liblapzt.integer.u1.less_than(self, other)
    BRANCH (underflow) {
        [liblapzt.boolean.FALSE, liblapzt.integer.u1.MIN]
    } {
        [liblapzt.boolean.TRUE, liblapzt.integer.u1.exclusive.or(self, other)]
    }
}

// Returns the difference of self and other, saturated at MIN.
liblapzt.integer.u1.subtract.saturating = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    [ok, difference] = liblapzt.integer.u1.subtract.checked(self, other)
    BRANCH (ok) { difference } { liblapzt.integer.u1.MIN }
}

// Returns the product of self and other modulo 2.
liblapzt.integer.u1.multiply.wrapping = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.and(self, other)
}

// Returns the product of self and other, saturated at MAX.
liblapzt.integer.u1.multiply.saturating = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.and(self, other)
}

// Returns [ok, product]. The product of two one-bit values is
// at most one, so it never overflows.
liblapzt.integer.u1.multiply.checked = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.boolean, liblapzt.integer.u1] {
    [liblapzt.boolean.TRUE, liblapzt.integer.u1.and(self, other)]
}

// Returns the full two-bit product of self and other as a pair
// [low, high].
liblapzt.integer.u1.multiply.full = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.integer.u1, liblapzt.integer.u1] {
    [liblapzt.integer.u1.and(self, other), liblapzt.integer.u1.MIN]
}

// Returns self divided by other. Division by zero saturates to
// MAX.
liblapzt.integer.u1.divide.wrapping = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.or(self, liblapzt.integer.u1.not(other))
}

// Returns self divided by other, saturated at MAX.
liblapzt.integer.u1.divide.saturating = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.or(self, liblapzt.integer.u1.not(other))
}

// Returns [ok, quotient]. Ok is false when other is zero, and
// the value is then MIN.
liblapzt.integer.u1.divide.checked = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.boolean, liblapzt.integer.u1] {
    BRANCH (other) {
        [liblapzt.boolean.TRUE, self]
    } {
        [liblapzt.boolean.FALSE, liblapzt.integer.u1.MIN]
    }
}

// Returns [quotient, remainder] of self divided by other.
// Returns [MAX, MIN] when other is zero.
liblapzt.integer.u1.divide.full = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.integer.u1, liblapzt.integer.u1] {
    BRANCH (other) {
        [self, liblapzt.integer.u1.MIN]
    } {
        [liblapzt.integer.u1.MAX, liblapzt.integer.u1.MIN]
    }
}

// Returns the remainder of self divided by other. The remainder
// of a one-bit value is always zero. Division by zero saturates
// to MAX.
liblapzt.integer.u1.remainder.wrapping = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not(other)
}

// Returns the remainder of self divided by other, saturated at
// MAX.
liblapzt.integer.u1.remainder.saturating = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) liblapzt.integer.u1 {
    liblapzt.integer.u1.not(other)
}

// Returns [ok, remainder]. Ok is false when other is zero, and
// the value is then MIN.
liblapzt.integer.u1.remainder.checked = (self: liblapzt.integer.u1, other: liblapzt.integer.u1) [liblapzt.boolean, liblapzt.integer.u1] {
    [liblapzt.integer.u1.to.bool(other), liblapzt.integer.u1.MIN]
}
