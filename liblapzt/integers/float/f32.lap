        w29: liblapzt.u32 = liblapzt.u32.select(low28, liblapzt.u32.mul(w28, liblapzt.f32.divisor.1), w28)
        d29: liblapzt.u32 = liblapzt.u32.select(low28, liblapzt.u32.sub(d28, liblapzt.u32.one), d28)
        low29: liblapzt.bool = liblapzt.u32.lt(w29, liblapzt.f32.hidden)
        w30: liblapzt.u32 = liblapzt.u32.select(low29, liblapzt.u32.mul(w29, liblapzt.f32.divisor.1), w29)
        d30: liblapzt.u32 = liblapzt.u32.select(low29, liblapzt.u32.sub(d29, liblapzt.u32.one), d29)
        low30: liblapzt.bool = liblapzt.u32.lt(w30, liblapzt.f32.hidden)
        w31: liblapzt.u32 = liblapzt.u32.select(low30, liblapzt.u32.mul(w30, liblapzt.f32.divisor.1), w30)
        d31: liblapzt.u32 = liblapzt.u32.select(low30, liblapzt.u32.sub(d30, liblapzt.u32.one), d30)
        low31: liblapzt.bool = liblapzt.u32.lt(w31, liblapzt.f32.hidden)
        w32: liblapzt.u32 = liblapzt.u32.select(low31, liblapzt.u32.mul(w31, liblapzt.f32.divisor.1), w31)
        d32: liblapzt.u32 = liblapzt.u32.select(low31, liblapzt.u32.sub(d31, liblapzt.u32.one), d31)
        man.final: liblapzt.u32 = liblapzt.u32.sub(w32, liblapzt.f32.hidden)
        liblapzt.f32.pack(liblapzt.bool.false, d32, man.final)
    }
}

// Converts a u32 to the corresponding value, truncating toward zero
// when the integer needs more than 24 significant bits.
liblapzt.f32.from.u32 = liblapzt.f32.from.u32.erased

liblapzt.f32.to.i32.erased = (a: liblapzt.f32) liblapzt.i32 {
    magnitude: liblapzt.u32 = liblapzt.f32.to.u32(liblapzt.f32.abs(a))
    positive: liblapzt.i32 = liblapzt.i32.from.u32(magnitude)
    BRANCH (liblapzt.f32.sign(a)) {
        liblapzt.i32.neg(positive)
    } {
        positive
    }
}

// Converts to i32 by truncating toward zero. The magnitude is
// converted through u32 and reinterpreted, so values outside the i32
// range wrap rather than saturate.
liblapzt.f32.to.i32 = liblapzt.f32.to.i32.erased

liblapzt.f32.from.i32.erased = (a: liblapzt.i32) liblapzt.f32 {
    magnitude: liblapzt.u32 = liblapzt.i32.to.u32(liblapzt.i32.abs(a))
    positive: liblapzt.f32 = liblapzt.f32.from.u32(magnitude)
    BRANCH (liblapzt.i32.sign(a)) {
        liblapzt.f32.neg(positive)
    } {
        positive
    }
}

// Converts an i32 to the corresponding value, truncating toward zero
// when the integer needs more than 24 significant bits.
liblapzt.f32.from.i32 = liblapzt.f32.from.i32.erased

liblapzt.f32.inc.erased = (a: liblapzt.f32) liblapzt.f32 {
    liblapzt.f32.add(a, liblapzt.f32.one)
}

// Returns a + 1.0, with the same NaN, infinity, and rounding rules as
// add.
liblapzt.f32.inc = liblapzt.f32.inc.erased

liblapzt.f32.dec.erased = (a: liblapzt.f32) liblapzt.f32 {
    liblapzt.f32.sub(a, liblapzt.f32.one)
}

// Returns a - 1.0, with the same NaN, infinity, and rounding rules as
// sub.
liblapzt.f32.dec = liblapzt.f32.dec.erased

