    r12: liblapzt.u32 = liblapzt.u32.select(ge5, liblapzt.u32.sub(r11, b.man.eff), r11)
    q6: liblapzt.u32 = liblapzt.u32.select(ge5, liblapzt.u32.or(q5, liblapzt.f32.bit.17), q5)
