    below7: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s7, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e7)))
    s8: liblapzt.u32 = liblapzt.u32.select(below7, liblapzt.u32.mul(s7, liblapzt.f32.divisor.1), s7)
