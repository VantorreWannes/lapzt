// Reinterprets the value as its 32-bit IEEE 754 encoding.
liblapzt.f32.to.bits = (a: liblapzt.f32) liblapzt.u32 {
    [low, high] = a
    [low, high]
}

// Reinterprets a 32-bit IEEE 754 encoding as the value it denotes.
liblapzt.f32.from.bits = (a: liblapzt.u32) liblapzt.f32 {
    [low, high] = a
    [low, high]
}

// Logical right shift of the bit pattern by amount, filling with
// zeros. Bits shifted past the least significant end are discarded.
liblapzt.f32.shr = (a: liblapzt.u32, amount: liblapzt.u32) liblapzt.u32 {
    s0: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.1)), a, liblapzt.u32.div(a, liblapzt.f32.divisor.1))
    s1: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.2)), s0, liblapzt.u32.div(s0, liblapzt.f32.divisor.2))
    s2: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.4)), s1, liblapzt.u32.div(s1, liblapzt.f32.divisor.4))
    s3: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.8)), s2, liblapzt.u32.div(s2, liblapzt.f32.divisor.8))
    s4: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.16)), s3, liblapzt.u32.div(s3, liblapzt.f32.divisor.16))
    s4
}

// Logical left shift of the bit pattern by amount, filling with
// zeros. Bits shifted past the most significant end are discarded.
liblapzt.f32.shl = (a: liblapzt.u32, amount: liblapzt.u32) liblapzt.u32 {
    s0: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.1)), a, liblapzt.u32.mul(a, liblapzt.f32.divisor.1))
    s1: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.2)), s0, liblapzt.u32.mul(s0, liblapzt.f32.divisor.2))
    s2: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.4)), s1, liblapzt.u32.mul(s1, liblapzt.f32.divisor.4))
    s3: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.8)), s2, liblapzt.u32.mul(s2, liblapzt.f32.divisor.8))
    s4: liblapzt.u32 = liblapzt.u32.select(liblapzt.u32.is.zero(liblapzt.u32.and(amount, liblapzt.f32.shift.16)), s3, liblapzt.u32.mul(s3, liblapzt.f32.divisor.16))
    s4
}

// True when the sign bit is set, so it is true for -0 and for NaNs
// with the sign bit set.
liblapzt.f32.sign = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.u32.msb(liblapzt.f32.to.bits(a))
}

// The biased exponent field: 0 for zero and subnormals, all ones for
// infinity and NaN, and bias + e for a normal value of magnitude 2^e.
liblapzt.f32.exponent = (a: liblapzt.f32) liblapzt.u32 {
    liblapzt.u32.mod(liblapzt.u32.div(liblapzt.f32.to.bits(a), liblapzt.f32.two.pow.mantissa), liblapzt.f32.two.pow.exponent)
}

// The stored mantissa field, without the implicit leading bit.
liblapzt.f32.mantissa = (a: liblapzt.f32) liblapzt.u32 {
    liblapzt.u32.mod(liblapzt.f32.to.bits(a), liblapzt.f32.two.pow.mantissa)
}

// Builds a value from a sign, a biased exponent field, and a mantissa
// field. The fields are not validated or normalized.
liblapzt.f32.pack = (sign: liblapzt.bool, exponent: liblapzt.u32, mantissa: liblapzt.u32) liblapzt.f32 {
    liblapzt.f32.from.bits(liblapzt.u32.or(liblapzt.u32.or(liblapzt.f32.shl(exponent, liblapzt.f32.mantissa.width), mantissa), liblapzt.u32.select(sign, liblapzt.f32.sign.mask, liblapzt.u32.zero)))
}

liblapzt.f32.select.erased = (flag: liblapzt.bool, when.true: liblapzt.f32, when.false: liblapzt.f32) liblapzt.f32 {
    BRANCH (flag) {
        when.true
    } {
        when.false
    }
}

// Returns when.true if flag holds and when.false otherwise.
liblapzt.f32.select = liblapzt.f32.select.erased

// True for both positive and negative zero.
liblapzt.f32.is.zero = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u32.is.zero(liblapzt.f32.exponent(a)), liblapzt.u32.is.zero(liblapzt.f32.mantissa(a)))
}

// True only for exactly +1.0.
liblapzt.f32.is.one = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.u32.eq(liblapzt.f32.to.bits(a), liblapzt.f32.one.bits)
}

// True for any NaN, whatever its payload or sign.
liblapzt.f32.is.nan = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u32.eq(liblapzt.f32.exponent(a), liblapzt.f32.exponent.maximum), liblapzt.bool.not(liblapzt.u32.is.zero(liblapzt.f32.mantissa(a))))
}

// True for both positive and negative infinity.
liblapzt.f32.is.infinite = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u32.eq(liblapzt.f32.exponent(a), liblapzt.f32.exponent.maximum), liblapzt.u32.is.zero(liblapzt.f32.mantissa(a)))
}

// True when the sign bit is set, including for -0 and negative NaN.
liblapzt.f32.is.negative = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.f32.sign(a)
}

liblapzt.f32.neg.erased = (a: liblapzt.f32) liblapzt.f32 {
    liblapzt.f32.from.bits(liblapzt.u32.xor(liblapzt.f32.to.bits(a), liblapzt.f32.sign.mask))
}

// Flips the sign bit. neg(0) is -0, neg(NaN) is a NaN with the
// opposite sign bit, and neg(infinity) is negative infinity.
liblapzt.f32.neg = liblapzt.f32.neg.erased

liblapzt.f32.abs.erased = (a: liblapzt.f32) liblapzt.f32 {
    liblapzt.f32.from.bits(liblapzt.u32.and(liblapzt.f32.to.bits(a), liblapzt.u32.not(liblapzt.f32.sign.mask)))
}

// Clears the sign bit. abs(-0) is +0 and abs(-infinity) is infinity.
liblapzt.f32.abs = liblapzt.f32.abs.erased

// False only for zero. NaN and infinity are true.
liblapzt.f32.to.bool = (a: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.not(liblapzt.f32.is.zero(a))
}

// Returns 1.0 for true and 0.0 for false.
liblapzt.f32.from.bool = (a: liblapzt.bool) liblapzt.f32 {
    liblapzt.f32.select(a, liblapzt.f32.one, liblapzt.f32.zero)
}

liblapzt.f32.eq.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.bool.false
    } {
        liblapzt.bool.or(liblapzt.u32.eq(liblapzt.f32.to.bits(a), liblapzt.f32.to.bits(b)), liblapzt.bool.and(liblapzt.f32.is.zero(a), liblapzt.f32.is.zero(b)))
    }
}

// True when a and b denote the same value. False if either is NaN.
// Positive and negative zero compare equal.
liblapzt.f32.eq = liblapzt.f32.eq.erased

liblapzt.f32.ne.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.not(liblapzt.f32.eq(a, b))
}

// The negation of eq, so it is true if either operand is NaN.
liblapzt.f32.ne = liblapzt.f32.ne.erased

liblapzt.f32.lt.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.bool.false
    } {
        a.sign: liblapzt.bool = liblapzt.f32.sign(a)
        b.sign: liblapzt.bool = liblapzt.f32.sign(b)
        differ: liblapzt.bool = liblapzt.bool.xor(a.sign, b.sign)
        BRANCH (differ) {
            a.sign
        } {
            BRANCH (a.sign) {
                liblapzt.u32.gt(liblapzt.f32.to.bits(a), liblapzt.f32.to.bits(b))
            } {
                liblapzt.u32.lt(liblapzt.f32.to.bits(a), liblapzt.f32.to.bits(b))
            }
        }
    }
}

// True when a is less than b. False if either is NaN, and false for
// -0 against +0.
liblapzt.f32.lt = liblapzt.f32.lt.erased

liblapzt.f32.le.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    liblapzt.bool.or(liblapzt.f32.lt(a, b), liblapzt.f32.eq(a, b))
}

// True when a is less than or equal to b. False if either is NaN.
liblapzt.f32.le = liblapzt.f32.le.erased

liblapzt.f32.gt.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    liblapzt.f32.lt(b, a)
}

// True when a is greater than b. False if either is NaN.
liblapzt.f32.gt = liblapzt.f32.gt.erased

liblapzt.f32.ge.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.bool {
    liblapzt.f32.le(b, a)
}

// True when a is greater than or equal to b. False if either is NaN.
liblapzt.f32.ge = liblapzt.f32.ge.erased

liblapzt.f32.min.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f32.nan
    } {
        liblapzt.f32.select(liblapzt.f32.lt(a, b), a, b)
    }
}

// The smaller of a and b, or NaN if either is NaN. When the operands
// compare equal, b is returned.
liblapzt.f32.min = liblapzt.f32.min.erased

liblapzt.f32.max.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f32.nan
    } {
        liblapzt.f32.select(liblapzt.f32.gt(a, b), a, b)
    }
}

// The larger of a and b, or NaN if either is NaN. When the operands
// compare equal, b is returned.
liblapzt.f32.max = liblapzt.f32.max.erased

liblapzt.f32.add.finite = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.exp: liblapzt.u32 = liblapzt.f32.exponent(a)
    b.exp: liblapzt.u32 = liblapzt.f32.exponent(b)
    a.man: liblapzt.u32 = liblapzt.f32.mantissa(a)
    b.man: liblapzt.u32 = liblapzt.f32.mantissa(b)
    a.sign: liblapzt.bool = liblapzt.f32.sign(a)
    b.sign: liblapzt.bool = liblapzt.f32.sign(b)
    a.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u32.is.zero(a.exp))
    b.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u32.is.zero(b.exp))
    a.man.eff: liblapzt.u32 = liblapzt.u32.select(a.normal, liblapzt.u32.or(a.man, liblapzt.f32.hidden), a.man)
    b.man.eff: liblapzt.u32 = liblapzt.u32.select(b.normal, liblapzt.u32.or(b.man, liblapzt.f32.hidden), b.man)
    a.exp.eff: liblapzt.u32 = liblapzt.u32.select(a.normal, a.exp, liblapzt.u32.one)
    b.exp.eff: liblapzt.u32 = liblapzt.u32.select(b.normal, b.exp, liblapzt.u32.one)
    a.bigger: liblapzt.bool = liblapzt.u32.ge(a.exp.eff, b.exp.eff)
    big.man: liblapzt.u32 = liblapzt.u32.select(a.bigger, a.man.eff, b.man.eff)
    small.man: liblapzt.u32 = liblapzt.u32.select(a.bigger, b.man.eff, a.man.eff)
    big.exp: liblapzt.u32 = liblapzt.u32.select(a.bigger, a.exp.eff, b.exp.eff)
    small.exp: liblapzt.u32 = liblapzt.u32.select(a.bigger, b.exp.eff, a.exp.eff)
    big.sign: liblapzt.bool = liblapzt.bool.select(a.bigger, a.sign, b.sign)
    small.sign: liblapzt.bool = liblapzt.bool.select(a.bigger, b.sign, a.sign)
    d: liblapzt.u32 = liblapzt.u32.sub(big.exp, small.exp)
    d.clamped: liblapzt.u32 = liblapzt.u32.min(d, liblapzt.f32.shift.limit)
    small.shifted: liblapzt.u32 = liblapzt.f32.shr(small.man, d.clamped)
    shifted.out: liblapzt.u32 = liblapzt.u32.sub(small.man, liblapzt.f32.shl(small.shifted, d.clamped))
    sticky: liblapzt.bool = liblapzt.bool.not(liblapzt.u32.is.zero(shifted.out))
    same.sign: liblapzt.bool = liblapzt.bool.eq(big.sign, small.sign)
    difference: liblapzt.u32 = liblapzt.u32.sub(big.man, small.shifted)
    borrow: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(same.sign), liblapzt.u32.lt(big.man, small.shifted))
    sum: liblapzt.u32 = liblapzt.u32.select(same.sign, liblapzt.u32.add(big.man, small.shifted), liblapzt.u32.select(borrow, liblapzt.u32.sub(small.shifted, big.man), difference))
    sign: liblapzt.bool = liblapzt.bool.select(borrow, small.sign, big.sign)
    carry: liblapzt.bool = liblapzt.u32.is.one(liblapzt.u32.mod(liblapzt.u32.div(sum, liblapzt.f32.two.pow.mantissa.plus.one), liblapzt.f32.divisor.1))
    s0: liblapzt.u32 = liblapzt.u32.select(carry, liblapzt.u32.div(sum, liblapzt.f32.divisor.1), sum)
    e0: liblapzt.u32 = liblapzt.u32.select(carry, liblapzt.u32.add(big.exp, liblapzt.u32.one), big.exp)
    below0: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s0, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e0)))
    s1: liblapzt.u32 = liblapzt.u32.select(below0, liblapzt.u32.mul(s0, liblapzt.f32.divisor.1), s0)
    e1: liblapzt.u32 = liblapzt.u32.select(below0, liblapzt.u32.sub(e0, liblapzt.u32.one), e0)
    below1: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s1, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e1)))
    s2: liblapzt.u32 = liblapzt.u32.select(below1, liblapzt.u32.mul(s1, liblapzt.f32.divisor.1), s1)
    e2: liblapzt.u32 = liblapzt.u32.select(below1, liblapzt.u32.sub(e1, liblapzt.u32.one), e1)
    below2: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s2, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e2)))
    s3: liblapzt.u32 = liblapzt.u32.select(below2, liblapzt.u32.mul(s2, liblapzt.f32.divisor.1), s2)
    e3: liblapzt.u32 = liblapzt.u32.select(below2, liblapzt.u32.sub(e2, liblapzt.u32.one), e2)
    below3: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s3, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e3)))
    s4: liblapzt.u32 = liblapzt.u32.select(below3, liblapzt.u32.mul(s3, liblapzt.f32.divisor.1), s3)
    e4: liblapzt.u32 = liblapzt.u32.select(below3, liblapzt.u32.sub(e3, liblapzt.u32.one), e3)
    below4: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s4, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e4)))
    s5: liblapzt.u32 = liblapzt.u32.select(below4, liblapzt.u32.mul(s4, liblapzt.f32.divisor.1), s4)
    e5: liblapzt.u32 = liblapzt.u32.select(below4, liblapzt.u32.sub(e4, liblapzt.u32.one), e4)
    below5: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s5, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e5)))
    s6: liblapzt.u32 = liblapzt.u32.select(below5, liblapzt.u32.mul(s5, liblapzt.f32.divisor.1), s5)
