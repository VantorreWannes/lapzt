    r9: liblapzt.u32 = liblapzt.u32.mul(r8, liblapzt.f32.divisor.1)
    ge4: liblapzt.bool = liblapzt.u32.ge(r9, b.man.eff)
    r10: liblapzt.u32 = liblapzt.u32.select(ge4, liblapzt.u32.sub(r9, b.man.eff), r9)
    q5: liblapzt.u32 = liblapzt.u32.select(ge4, liblapzt.u32.or(q4, liblapzt.f32.bit.18), q4)
    r11: liblapzt.u32 = liblapzt.u32.mul(r10, liblapzt.f32.divisor.1)
