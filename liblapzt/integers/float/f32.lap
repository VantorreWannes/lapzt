    s24: liblapzt.u32 = liblapzt.u32.select(below23, liblapzt.u32.mul(s23, liblapzt.f32.divisor.1), s23)
    e24: liblapzt.u32 = liblapzt.u32.select(below23, liblapzt.u32.sub(e23, liblapzt.u32.one), e23)
    below24: liblapzt.bool = liblapzt.bool.and(liblapzt.u32.lt(s24, liblapzt.f32.hidden), liblapzt.bool.not(liblapzt.u32.is.zero(e24)))
    s25: liblapzt.u32 = liblapzt.u32.select(below24, liblapzt.u32.mul(s24, liblapzt.f32.divisor.1), s24)
    e25: liblapzt.u32 = liblapzt.u32.select(below24, liblapzt.u32.sub(e24, liblapzt.u32.one), e24)
    rounded: liblapzt.u32 = liblapzt.u32.select(sticky, liblapzt.u32.add(s25, liblapzt.u32.one), s25)
    carry2: liblapzt.bool = liblapzt.u32.is.one(liblapzt.u32.mod(liblapzt.u32.div(rounded, liblapzt.f32.two.pow.mantissa.plus.one), liblapzt.f32.divisor.1))
    s.final: liblapzt.u32 = liblapzt.u32.select(carry2, liblapzt.u32.div(rounded, liblapzt.f32.divisor.1), rounded)
    e.final: liblapzt.u32 = liblapzt.u32.select(carry2, liblapzt.u32.add(e25, liblapzt.u32.one), e25)
    overflow: liblapzt.bool = liblapzt.u32.ge(e.final, liblapzt.f32.exponent.maximum)
    BRANCH (overflow) {
        liblapzt.f32.pack(sign, liblapzt.f32.exponent.maximum, liblapzt.u32.zero)
    } {
        BRANCH (liblapzt.u32.is.zero(s.final)) {
            liblapzt.f32.zero
        } {
            subnormal: liblapzt.bool = liblapzt.u32.is.zero(e.final)
            man.final: liblapzt.u32 = liblapzt.u32.select(subnormal, s.final, liblapzt.u32.sub(s.final, liblapzt.f32.hidden))
            liblapzt.f32.pack(sign, e.final, man.final)
        }
    }
}

liblapzt.f32.add.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f32.nan
    } {
        a.inf: liblapzt.bool = liblapzt.f32.is.infinite(a)
        b.inf: liblapzt.bool = liblapzt.f32.is.infinite(b)
        BRANCH (liblapzt.bool.and(a.inf, b.inf)) {
            BRANCH (liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b))) {
                liblapzt.f32.nan
            } {
                a
            }
        } {
            BRANCH (a.inf) {
                a
            } {
                BRANCH (b.inf) {
                    b
                } {
                    a.zero: liblapzt.bool = liblapzt.f32.is.zero(a)
                    b.zero: liblapzt.bool = liblapzt.f32.is.zero(b)
                    BRANCH (liblapzt.bool.and(a.zero, b.zero)) {
                        BRANCH (liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b))) {
                            liblapzt.f32.zero
                        } {
                            a
                        }
                    } {
                        BRANCH (a.zero) {
                            b
                        } {
                            BRANCH (b.zero) {
                                a
                            } {
                                liblapzt.f32.add.finite(a, b)
                            }
                        }
                    }
                }
            }
        }
    }
}

// Returns a + b. NaN if either operand is NaN, and NaN for infinity
// plus infinity of opposite signs. +0 + -0 is +0. Results that
// overflow become infinity. Rounding is not round-to-nearest: when
// aligning the operands discards any nonzero bits, the magnitude is
// incremented by one unit in the last place.
liblapzt.f32.add = liblapzt.f32.add.erased

liblapzt.f32.sub.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    liblapzt.f32.add(a, liblapzt.f32.neg(b))
}

// Returns a - b, computed as a + (-b). The same NaN, infinity, signed
// zero, and rounding rules as add apply.
liblapzt.f32.sub = liblapzt.f32.sub.erased

liblapzt.f32.mul.finite = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.exp: liblapzt.u32 = liblapzt.f32.exponent(a)
    b.exp: liblapzt.u32 = liblapzt.f32.exponent(b)
    a.man: liblapzt.u32 = liblapzt.f32.mantissa(a)
    b.man: liblapzt.u32 = liblapzt.f32.mantissa(b)
    a.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u32.is.zero(a.exp))
    b.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u32.is.zero(b.exp))
    a.man.eff: liblapzt.u32 = liblapzt.u32.select(a.normal, liblapzt.u32.or(a.man, liblapzt.f32.hidden), a.man)
    b.man.eff: liblapzt.u32 = liblapzt.u32.select(b.normal, liblapzt.u32.or(b.man, liblapzt.f32.hidden), b.man)
    a.exp.eff: liblapzt.u32 = liblapzt.u32.select(a.normal, a.exp, liblapzt.u32.one)
    b.exp.eff: liblapzt.u32 = liblapzt.u32.select(b.normal, b.exp, liblapzt.u32.one)
    sign: liblapzt.bool = liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b))
    exp: liblapzt.u32 = liblapzt.u32.sub(liblapzt.u32.add(a.exp.eff, b.exp.eff), liblapzt.f32.bias)
    [low, high] = liblapzt.u32.mul.full(a.man.eff, b.man.eff)
    extra: liblapzt.bool = liblapzt.u32.is.one(liblapzt.u32.mod(liblapzt.u32.div(high, liblapzt.f32.mul.extra.bit), liblapzt.f32.divisor.1))
    shifted.extra: liblapzt.u32 = liblapzt.u32.or(liblapzt.u32.mul(high, liblapzt.f32.mul.low.extra), liblapzt.u32.div(low, liblapzt.f32.two.pow.mantissa.plus.one))
    shifted.normal: liblapzt.u32 = liblapzt.u32.or(liblapzt.u32.mul(high, liblapzt.f32.mul.low.normal), liblapzt.u32.div(low, liblapzt.f32.two.pow.mantissa))
    shifted: liblapzt.u32 = liblapzt.u32.select(extra, shifted.extra, shifted.normal)
    exp.final: liblapzt.u32 = liblapzt.u32.add(exp, liblapzt.u32.select(extra, liblapzt.u32.one, liblapzt.u32.zero))
    overflow: liblapzt.bool = liblapzt.u32.ge(exp.final, liblapzt.f32.exponent.maximum)
    BRANCH (overflow) {
        liblapzt.f32.pack(sign, liblapzt.f32.exponent.maximum, liblapzt.u32.zero)
    } {
        subnormal: liblapzt.bool = liblapzt.u32.is.zero(exp.final)
        man.final: liblapzt.u32 = liblapzt.u32.select(subnormal, liblapzt.u32.mod(shifted, liblapzt.f32.two.pow.mantissa), liblapzt.u32.sub(shifted, liblapzt.f32.hidden))
        liblapzt.f32.pack(sign, exp.final, man.final)
    }
}

liblapzt.f32.mul.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
