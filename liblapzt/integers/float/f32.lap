liblapzt.f32.div.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    a.nan: liblapzt.bool = liblapzt.f32.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f32.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f32.nan
    } {
        a.inf: liblapzt.bool = liblapzt.f32.is.infinite(a)
        b.inf: liblapzt.bool = liblapzt.f32.is.infinite(b)
        a.zero: liblapzt.bool = liblapzt.f32.is.zero(a)
        b.zero: liblapzt.bool = liblapzt.f32.is.zero(b)
        BRANCH (liblapzt.bool.or(liblapzt.bool.and(a.inf, b.inf), liblapzt.bool.and(a.zero, b.zero))) {
            liblapzt.f32.nan
        } {
            BRANCH (a.inf) {
                liblapzt.f32.pack(liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b)), liblapzt.f32.exponent.maximum, liblapzt.u32.zero)
            } {
                BRANCH (b.inf) {
                    liblapzt.f32.pack(liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b)), liblapzt.u32.zero, liblapzt.u32.zero)
                } {
                    BRANCH (a.zero) {
                        liblapzt.f32.pack(liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b)), liblapzt.u32.zero, liblapzt.u32.zero)
                    } {
                        BRANCH (b.zero) {
                            liblapzt.f32.pack(liblapzt.bool.xor(liblapzt.f32.sign(a), liblapzt.f32.sign(b)), liblapzt.f32.exponent.maximum, liblapzt.u32.zero)
                        } {
                            liblapzt.f32.div.finite(a, b)
                        }
                    }
                }
            }
        }
    }
}

// Returns a / b. NaN if either operand is NaN, and NaN for 0/0 and
// infinity/infinity. A nonzero value divided by zero gives infinity,
// a finite value divided by infinity gives zero, and both take the
// sign from the operands. Results that overflow become infinity; the
// quotient is rounded away from zero.
liblapzt.f32.div = liblapzt.f32.div.erased

// Rounds toward zero to an integer value. Values with magnitude below
// 1 become a zero with the same sign, and values with magnitude of at
// least 2^23 are returned unchanged. NaN and infinity are returned
// unchanged.
liblapzt.f32.trunc = (a: liblapzt.f32) liblapzt.f32 {
    exp: liblapzt.u32 = liblapzt.f32.exponent(a)
    small: liblapzt.bool = liblapzt.u32.lt(exp, liblapzt.f32.bias)
    BRANCH (small) {
        liblapzt.f32.pack(liblapzt.f32.sign(a), liblapzt.u32.zero, liblapzt.u32.zero)
    } {
        large: liblapzt.bool = liblapzt.u32.ge(exp, liblapzt.u32.add(liblapzt.f32.bias, liblapzt.f32.mantissa.width))
        BRANCH (large) {
            a
        } {
            shift: liblapzt.u32 = liblapzt.u32.sub(liblapzt.u32.add(liblapzt.f32.bias, liblapzt.f32.mantissa.width), exp)
            mask: liblapzt.u32 = liblapzt.u32.sub(liblapzt.f32.shl(liblapzt.u32.one, shift), liblapzt.u32.one)
            man: liblapzt.u32 = liblapzt.u32.and(liblapzt.f32.mantissa(a), liblapzt.u32.not(mask))
            liblapzt.f32.pack(liblapzt.f32.sign(a), exp, man)
        }
    }
}

liblapzt.f32.mod.erased = (a: liblapzt.f32, b: liblapzt.f32) liblapzt.f32 {
    quotient: liblapzt.f32 = liblapzt.f32.div(a, b)
    truncated: liblapzt.f32 = liblapzt.f32.trunc(quotient)
    liblapzt.f32.sub(a, liblapzt.f32.mul(truncated, b))
}

// Returns a - trunc(a / b) * b, the remainder with the sign of a.
// NaN if either operand is NaN or infinite, or if b is zero.
liblapzt.f32.mod = liblapzt.f32.mod.erased

liblapzt.f32.to.u32.erased = (a: liblapzt.f32) liblapzt.u32 {
    negative: liblapzt.bool = liblapzt.f32.sign(a)
    exp: liblapzt.u32 = liblapzt.f32.exponent(a)
    small: liblapzt.bool = liblapzt.u32.lt(exp, liblapzt.f32.bias)
    BRANCH (liblapzt.bool.or(negative, small)) {
        liblapzt.u32.zero
    } {
        too.large: liblapzt.bool = liblapzt.u32.ge(exp, liblapzt.u32.add(liblapzt.f32.bias, liblapzt.f32.integer.width))
        BRANCH (too.large) {
            liblapzt.u32.maximum
        } {
            man: liblapzt.u32 = liblapzt.u32.or(liblapzt.f32.mantissa(a), liblapzt.f32.hidden)
            shift: liblapzt.u32 = liblapzt.u32.sub(exp, liblapzt.f32.bias)
            left: liblapzt.bool = liblapzt.u32.ge(shift, liblapzt.f32.mantissa.width)
            left.amount: liblapzt.u32 = liblapzt.u32.sub(shift, liblapzt.f32.mantissa.width)
            right.amount: liblapzt.u32 = liblapzt.u32.sub(liblapzt.f32.mantissa.width, shift)
            liblapzt.u32.select(left, liblapzt.f32.shl(man, left.amount), liblapzt.f32.shr(man, right.amount))
        }
    }
}

// Converts to u32 by truncating toward zero. Negative values,
// including negative NaN, become 0, as do values with magnitude below
// 1. Values of magnitude 2^32 or more, including positive NaN and
// infinity, become u32.maximum.
liblapzt.f32.to.u32 = liblapzt.f32.to.u32.erased

liblapzt.f32.from.u32.erased = (a: liblapzt.u32) liblapzt.f32 {
    BRANCH (liblapzt.u32.is.zero(a)) {
