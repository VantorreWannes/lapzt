        d4: liblapzt.integer.u16 = BRANCH (low3) { liblapzt.integer.u16.subtract.wrapping(d3, _liblapzt.f16.BIT_0) } { d3 }
        low4: liblapzt.boolean = liblapzt.integer.u16.less_than(w4, _liblapzt.f16.HIDDEN)
