// Converts a u16 to the corresponding value, truncating toward zero
// when the integer needs more than 11 significant bits.
liblapzt.f16.from.u16 = liblapzt.f16.from.u16.erased

liblapzt.f16.to.i16.erased = (a: liblapzt.f16) liblapzt.i16 {
    magnitude: liblapzt.integer.u16 = liblapzt.f16.to.u16(liblapzt.f16.abs(a))
    positive: liblapzt.i16 = liblapzt.i16.from.u16(magnitude)
    BRANCH (liblapzt.f16.sign(a)) {
        liblapzt.i16.neg(positive)
    } {
        positive
    }
}

// Converts to i16 by truncating toward zero. The magnitude is
// converted through u16 and reinterpreted, so values outside the i16
// range wrap rather than saturate.
liblapzt.f16.to.i16 = liblapzt.f16.to.i16.erased

liblapzt.f16.from.i16.erased = (a: liblapzt.i16) liblapzt.f16 {
    magnitude: liblapzt.integer.u16 = liblapzt.i16.to.u16(liblapzt.i16.abs(a))
    positive: liblapzt.f16 = liblapzt.f16.from.u16(magnitude)
    BRANCH (liblapzt.i16.sign(a)) {
        liblapzt.f16.neg(positive)
    } {
        positive
    }
}

// Converts an i16 to the corresponding value, truncating toward zero
// when the integer needs more than 11 significant bits.
liblapzt.f16.from.i16 = liblapzt.f16.from.i16.erased

liblapzt.f16.inc.erased = (a: liblapzt.f16) liblapzt.f16 {
    liblapzt.f16.add(a, liblapzt.f16.ONE)
}

// Returns a + 1.0, with the same NaN, infinity, and rounding rules as
// add.
liblapzt.f16.inc = liblapzt.f16.inc.erased

liblapzt.f16.dec.erased = (a: liblapzt.f16) liblapzt.f16 {
    liblapzt.f16.sub(a, liblapzt.f16.ONE)
}

// Returns a - 1.0, with the same NaN, infinity, and rounding rules as
// sub.
liblapzt.f16.dec = liblapzt.f16.dec.erased
