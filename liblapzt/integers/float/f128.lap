    positive: liblapzt.integer.i128 = magnitude
    BRANCH (liblapzt.f128.sign(a)) {
        liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, positive)
    } {
        positive
    }
}

// Converts to i128 by truncating toward zero. The magnitude is
// converted through u128 and reinterpreted, so values outside the
// i128 range wrap rather than saturate.
