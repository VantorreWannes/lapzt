    liblapzt.f128.add(a, liblapzt.f128.ONE)
}

// Returns a + 1.0, with the same NaN, infinity, and rounding rules as
// add.
liblapzt.f128.inc = liblapzt.f128.inc.erased

liblapzt.f128.dec.erased = (a: liblapzt.f128) liblapzt.f128 {
    liblapzt.f128.sub(a, liblapzt.f128.ONE)
}

// Returns a - 1.0, with the same NaN, infinity, and rounding rules as
// sub.
