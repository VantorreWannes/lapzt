    BRANCH (liblapzt.integer.i128.less_than(a, liblapzt.integer.i128.ZERO)) {
        liblapzt.f128.neg(positive)
    } {
        positive
    }
}

// Converts an i128 to the corresponding value, truncating toward zero
// when the integer needs more than 113 significant bits.
