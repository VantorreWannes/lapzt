liblapzt.f128.from.i128.erased = (a: liblapzt.integer.i128) liblapzt.f128 {
    magnitude: liblapzt.integer.u128 = BRANCH (liblapzt.integer.i128.less_than(a, liblapzt.integer.i128.ZERO)) { liblapzt.integer.u128.subtract.wrapping(liblapzt.integer.u128.MIN, a) } { a }
