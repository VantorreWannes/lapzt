        e12: liblapzt.u64 = liblapzt.u64.select(high11, liblapzt.u64.add(e11, liblapzt.u64.one), e11)
        high12: liblapzt.bool = liblapzt.u64.ge(v12, liblapzt.f64.two.pow.mantissa.plus.one)
