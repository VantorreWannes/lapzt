}

// The biased exponent field: 0 for zero and subnormals, all ones for
// infinity and NaN, and bias + e for a normal value of magnitude 2^e.
liblapzt.f64.exponent = (a: liblapzt.f64) liblapzt.u64 {
    liblapzt.u64.mod(liblapzt.u64.div(liblapzt.f64.to.bits(a), liblapzt.f64.two.pow.mantissa), liblapzt.f64.two.pow.exponent)
}

// The stored mantissa field, without the implicit leading bit.
liblapzt.f64.mantissa = (a: liblapzt.f64) liblapzt.u64 {
