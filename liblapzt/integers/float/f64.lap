// The larger of a and b, or NaN if either is NaN. When the operands
// compare equal, b is returned.
liblapzt.f64.max = liblapzt.f64.max.erased

liblapzt.f64.add.finite = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.exp: liblapzt.u64 = liblapzt.f64.exponent(a)
    b.exp: liblapzt.u64 = liblapzt.f64.exponent(b)
    a.man: liblapzt.u64 = liblapzt.f64.mantissa(a)
    b.man: liblapzt.u64 = liblapzt.f64.mantissa(b)
    a.sign: liblapzt.bool = liblapzt.f64.sign(a)
    b.sign: liblapzt.bool = liblapzt.f64.sign(b)
    a.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u64.is.zero(a.exp))
    b.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u64.is.zero(b.exp))
    a.man.eff: liblapzt.u64 = liblapzt.u64.select(a.normal, liblapzt.u64.or(a.man, liblapzt.f64.hidden), a.man)
    b.man.eff: liblapzt.u64 = liblapzt.u64.select(b.normal, liblapzt.u64.or(b.man, liblapzt.f64.hidden), b.man)
    a.exp.eff: liblapzt.u64 = liblapzt.u64.select(a.normal, a.exp, liblapzt.u64.one)
    b.exp.eff: liblapzt.u64 = liblapzt.u64.select(b.normal, b.exp, liblapzt.u64.one)
    a.bigger: liblapzt.bool = liblapzt.u64.ge(a.exp.eff, b.exp.eff)
    big.man: liblapzt.u64 = liblapzt.u64.select(a.bigger, a.man.eff, b.man.eff)
    small.man: liblapzt.u64 = liblapzt.u64.select(a.bigger, b.man.eff, a.man.eff)
    big.exp: liblapzt.u64 = liblapzt.u64.select(a.bigger, a.exp.eff, b.exp.eff)
    small.exp: liblapzt.u64 = liblapzt.u64.select(a.bigger, b.exp.eff, a.exp.eff)
    big.sign: liblapzt.bool = liblapzt.bool.select(a.bigger, a.sign, b.sign)
    small.sign: liblapzt.bool = liblapzt.bool.select(a.bigger, b.sign, a.sign)
    d: liblapzt.u64 = liblapzt.u64.sub(big.exp, small.exp)
    d.clamped: liblapzt.u64 = liblapzt.u64.min(d, liblapzt.f64.shift.limit)
    small.shifted: liblapzt.u64 = liblapzt.f64.shr(small.man, d.clamped)
    shifted.out: liblapzt.u64 = liblapzt.u64.sub(small.man, liblapzt.f64.shl(small.shifted, d.clamped))
    sticky: liblapzt.bool = liblapzt.bool.not(liblapzt.u64.is.zero(shifted.out))
    same.sign: liblapzt.bool = liblapzt.bool.eq(big.sign, small.sign)
    difference: liblapzt.u64 = liblapzt.u64.sub(big.man, small.shifted)
    borrow: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(same.sign), liblapzt.u64.lt(big.man, small.shifted))
    sum: liblapzt.u64 = liblapzt.u64.select(same.sign, liblapzt.u64.add(big.man, small.shifted), liblapzt.u64.select(borrow, liblapzt.u64.sub(small.shifted, big.man), difference))
    sign: liblapzt.bool = liblapzt.bool.select(borrow, small.sign, big.sign)
    carry: liblapzt.bool = liblapzt.u64.is.one(liblapzt.u64.mod(liblapzt.u64.div(sum, liblapzt.f64.two.pow.mantissa.plus.one), liblapzt.f64.divisor.1))
    s0: liblapzt.u64 = liblapzt.u64.select(carry, liblapzt.u64.div(sum, liblapzt.f64.divisor.1), sum)
    e0: liblapzt.u64 = liblapzt.u64.select(carry, liblapzt.u64.add(big.exp, liblapzt.u64.one), big.exp)
    below0: liblapzt.bool = liblapzt.bool.and(liblapzt.u64.lt(s0, liblapzt.f64.hidden), liblapzt.bool.not(liblapzt.u64.is.zero(e0)))
    s1: liblapzt.u64 = liblapzt.u64.select(below0, liblapzt.u64.mul(s0, liblapzt.f64.divisor.1), s0)
    e1: liblapzt.u64 = liblapzt.u64.select(below0, liblapzt.u64.sub(e0, liblapzt.u64.one), e0)
    below1: liblapzt.bool = liblapzt.bool.and(liblapzt.u64.lt(s1, liblapzt.f64.hidden), liblapzt.bool.not(liblapzt.u64.is.zero(e1)))
    s2: liblapzt.u64 = liblapzt.u64.select(below1, liblapzt.u64.mul(s1, liblapzt.f64.divisor.1), s1)
    e2: liblapzt.u64 = liblapzt.u64.select(below1, liblapzt.u64.sub(e1, liblapzt.u64.one), e1)
    below2: liblapzt.bool = liblapzt.bool.and(liblapzt.u64.lt(s2, liblapzt.f64.hidden), liblapzt.bool.not(liblapzt.u64.is.zero(e2)))
    s3: liblapzt.u64 = liblapzt.u64.select(below2, liblapzt.u64.mul(s2, liblapzt.f64.divisor.1), s2)
    e3: liblapzt.u64 = liblapzt.u64.select(below2, liblapzt.u64.sub(e2, liblapzt.u64.one), e2)
    below3: liblapzt.bool = liblapzt.bool.and(liblapzt.u64.lt(s3, liblapzt.f64.hidden), liblapzt.bool.not(liblapzt.u64.is.zero(e3)))
    s4: liblapzt.u64 = liblapzt.u64.select(below3, liblapzt.u64.mul(s3, liblapzt.f64.divisor.1), s3)
    e4: liblapzt.u64 = liblapzt.u64.select(below3, liblapzt.u64.sub(e3, liblapzt.u64.one), e3)
