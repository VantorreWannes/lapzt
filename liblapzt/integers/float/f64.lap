    s5: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.32)), s4, liblapzt.u64.div(s4, liblapzt.f64.divisor.32))
    s5
}

// Logical left shift of the bit pattern by amount, filling with
// zeros. Bits shifted past the most significant end are discarded.
liblapzt.f64.shl = (a: liblapzt.u64, amount: liblapzt.u64) liblapzt.u64 {
    s0: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.1)), a, liblapzt.u64.mul(a, liblapzt.f64.divisor.1))
    s1: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.2)), s0, liblapzt.u64.mul(s0, liblapzt.f64.divisor.2))
    s2: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.4)), s1, liblapzt.u64.mul(s1, liblapzt.f64.divisor.4))
    s3: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.8)), s2, liblapzt.u64.mul(s2, liblapzt.f64.divisor.8))
    s4: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.16)), s3, liblapzt.u64.mul(s3, liblapzt.f64.divisor.16))
    s5: liblapzt.u64 = liblapzt.u64.select(liblapzt.u64.is.zero(liblapzt.u64.and(amount, liblapzt.f64.shift.32)), s4, liblapzt.u64.mul(s4, liblapzt.f64.divisor.32))
