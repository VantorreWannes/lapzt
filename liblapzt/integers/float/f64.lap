// Converts a u64 to the corresponding value, truncating toward zero
// when the integer needs more than 53 significant bits.
liblapzt.f64.from.u64 = liblapzt.f64.from.u64.erased

liblapzt.f64.to.i64.erased = (a: liblapzt.f64) liblapzt.integer.i64 {
    magnitude: liblapzt.integer.u64 = liblapzt.f64.to.u64(liblapzt.f64.abs(a))
    positive: liblapzt.integer.i64 = magnitude
    BRANCH (liblapzt.f64.sign(a)) {
        liblapzt.integer.u64.subtract.wrapping(liblapzt.integer.u64.MIN, positive)
    } {
        positive
    }
}

// Converts to i64 by truncating toward zero. The magnitude is
// converted through u64 and reinterpreted, so values outside the i64
// range wrap rather than saturate.
liblapzt.f64.to.i64 = liblapzt.f64.to.i64.erased

liblapzt.f64.from.i64.erased = (a: liblapzt.integer.i64) liblapzt.f64 {
    magnitude: liblapzt.integer.u64 = BRANCH (liblapzt.integer.i64.less_than(a, liblapzt.integer.i64.ZERO)) { liblapzt.integer.u64.subtract.wrapping(liblapzt.integer.u64.MIN, a) } { a }
    positive: liblapzt.f64 = liblapzt.f64.from.u64(magnitude)
    BRANCH (liblapzt.integer.i64.less_than(a, liblapzt.integer.i64.ZERO)) {
        liblapzt.f64.neg(positive)
    } {
        positive
    }
}

// Converts an i64 to the corresponding value, truncating toward zero
// when the integer needs more than 53 significant bits.
liblapzt.f64.from.i64 = liblapzt.f64.from.i64.erased

liblapzt.f64.inc.erased = (a: liblapzt.f64) liblapzt.f64 {
    liblapzt.f64.add(a, liblapzt.f64.ONE)
}

// Returns a + 1.0, with the same NaN, infinity, and rounding rules as
// add.
liblapzt.f64.inc = liblapzt.f64.inc.erased

liblapzt.f64.dec.erased = (a: liblapzt.f64) liblapzt.f64 {
    liblapzt.f64.sub(a, liblapzt.f64.ONE)
}

// Returns a - 1.0, with the same NaN, infinity, and rounding rules as
// sub.
liblapzt.f64.dec = liblapzt.f64.dec.erased

