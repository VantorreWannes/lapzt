}

// Flips the sign bit. neg(0) is -0, neg(NaN) is a NaN with the
// opposite sign bit, and neg(infinity) is negative infinity.
liblapzt.f64.neg = liblapzt.f64.neg.erased

liblapzt.f64.abs.erased = (a: liblapzt.f64) liblapzt.f64 {
    liblapzt.f64.from.bits(liblapzt.u64.and(liblapzt.f64.to.bits(a), liblapzt.u64.not(liblapzt.f64.sign.mask)))
}

// Clears the sign bit. abs(-0) is +0 and abs(-infinity) is infinity.
liblapzt.f64.abs = liblapzt.f64.abs.erased

// False only for zero. NaN and infinity are true.
liblapzt.f64.to.bool = (a: liblapzt.f64) liblapzt.bool {
    liblapzt.bool.not(liblapzt.f64.is.zero(a))
}

// Returns 1.0 for true and 0.0 for false.
liblapzt.f64.from.bool = (a: liblapzt.bool) liblapzt.f64 {
    liblapzt.f64.select(a, liblapzt.f64.one, liblapzt.f64.zero)
}

liblapzt.f64.eq.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.bool {
    a.nan: liblapzt.bool = liblapzt.f64.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f64.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.bool.false
    } {
        liblapzt.bool.or(liblapzt.u64.eq(liblapzt.f64.to.bits(a), liblapzt.f64.to.bits(b)), liblapzt.bool.and(liblapzt.f64.is.zero(a), liblapzt.f64.is.zero(b)))
    }
}

// True when a and b denote the same value. False if either is NaN.
// Positive and negative zero compare equal.
liblapzt.f64.eq = liblapzt.f64.eq.erased

liblapzt.f64.ne.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.bool {
