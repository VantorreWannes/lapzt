}

// Builds a value from a sign, a biased exponent field, and a mantissa
// field. The fields are not validated or normalized.
liblapzt.f64.pack = (sign: liblapzt.bool, exponent: liblapzt.u64, mantissa: liblapzt.u64) liblapzt.f64 {
    liblapzt.f64.from.bits(liblapzt.u64.or(liblapzt.u64.or(liblapzt.f64.shl(exponent, liblapzt.f64.mantissa.width), mantissa), liblapzt.u64.select(sign, liblapzt.f64.sign.mask, liblapzt.u64.zero)))
}

liblapzt.f64.select.erased = (flag: liblapzt.bool, when.true: liblapzt.f64, when.false: liblapzt.f64) liblapzt.f64 {
    BRANCH (flag) {
        when.true
    } {
        when.false
    }
}

// Returns when.true if flag holds and when.false otherwise.
liblapzt.f64.select = liblapzt.f64.select.erased

// True for both positive and negative zero.
liblapzt.f64.is.zero = (a: liblapzt.f64) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u64.is.zero(liblapzt.f64.exponent(a)), liblapzt.u64.is.zero(liblapzt.f64.mantissa(a)))
}

// True only for exactly +1.0.
liblapzt.f64.is.one = (a: liblapzt.f64) liblapzt.bool {
    liblapzt.u64.eq(liblapzt.f64.to.bits(a), liblapzt.f64.one.bits)
}

// True for any NaN, whatever its payload or sign.
liblapzt.f64.is.nan = (a: liblapzt.f64) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u64.eq(liblapzt.f64.exponent(a), liblapzt.f64.exponent.maximum), liblapzt.bool.not(liblapzt.u64.is.zero(liblapzt.f64.mantissa(a))))
}

// True for both positive and negative infinity.
liblapzt.f64.is.infinite = (a: liblapzt.f64) liblapzt.bool {
    liblapzt.bool.and(liblapzt.u64.eq(liblapzt.f64.exponent(a), liblapzt.f64.exponent.maximum), liblapzt.u64.is.zero(liblapzt.f64.mantissa(a)))
}

// True when the sign bit is set, including for -0 and negative NaN.
liblapzt.f64.is.negative = (a: liblapzt.f64) liblapzt.bool {
