// True when a is greater than or equal to b. False if either is NaN.
liblapzt.f64.ge = liblapzt.f64.ge.erased

liblapzt.f64.min.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.nan: liblapzt.bool = liblapzt.f64.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f64.is.nan(b)
