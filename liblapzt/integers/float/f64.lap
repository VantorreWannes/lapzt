// The smaller of a and b, or NaN if either is NaN. When the operands
// compare equal, b is returned.
liblapzt.f64.min = liblapzt.f64.min.erased

liblapzt.f64.max.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.nan: liblapzt.bool = liblapzt.f64.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f64.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f64.nan
    } {
