liblapzt.f64.add.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.nan: liblapzt.bool = liblapzt.f64.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f64.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f64.nan
    } {
        a.inf: liblapzt.bool = liblapzt.f64.is.infinite(a)
        b.inf: liblapzt.bool = liblapzt.f64.is.infinite(b)
        BRANCH (liblapzt.bool.and(a.inf, b.inf)) {
            BRANCH (liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b))) {
                liblapzt.f64.nan
            } {
                a
            }
        } {
            BRANCH (a.inf) {
                a
            } {
                BRANCH (b.inf) {
                    b
                } {
                    a.zero: liblapzt.bool = liblapzt.f64.is.zero(a)
                    b.zero: liblapzt.bool = liblapzt.f64.is.zero(b)
                    BRANCH (liblapzt.bool.and(a.zero, b.zero)) {
                        BRANCH (liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b))) {
                            liblapzt.f64.zero
                        } {
                            a
                        }
                    } {
                        BRANCH (a.zero) {
                            b
                        } {
                            BRANCH (b.zero) {
                                a
                            } {
                                liblapzt.f64.add.finite(a, b)
                            }
                        }
                    }
                }
            }
        }
    }
}

// Returns a + b. NaN if either operand is NaN, and NaN for infinity
// plus infinity of opposite signs. +0 + -0 is +0. Results that
// overflow become infinity. Rounding is not round-to-nearest: when
// aligning the operands discards any nonzero bits, the magnitude is
// incremented by one unit in the last place.
liblapzt.f64.add = liblapzt.f64.add.erased

liblapzt.f64.sub.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    liblapzt.f64.add(a, liblapzt.f64.neg(b))
}

// Returns a - b, computed as a + (-b). The same NaN, infinity, signed
// zero, and rounding rules as add apply.
liblapzt.f64.sub = liblapzt.f64.sub.erased

liblapzt.f64.mul.finite = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.exp: liblapzt.u64 = liblapzt.f64.exponent(a)
    b.exp: liblapzt.u64 = liblapzt.f64.exponent(b)
    a.man: liblapzt.u64 = liblapzt.f64.mantissa(a)
    b.man: liblapzt.u64 = liblapzt.f64.mantissa(b)
    a.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u64.is.zero(a.exp))
    b.normal: liblapzt.bool = liblapzt.bool.not(liblapzt.u64.is.zero(b.exp))
    a.man.eff: liblapzt.u64 = liblapzt.u64.select(a.normal, liblapzt.u64.or(a.man, liblapzt.f64.hidden), a.man)
    b.man.eff: liblapzt.u64 = liblapzt.u64.select(b.normal, liblapzt.u64.or(b.man, liblapzt.f64.hidden), b.man)
    a.exp.eff: liblapzt.u64 = liblapzt.u64.select(a.normal, a.exp, liblapzt.u64.one)
    b.exp.eff: liblapzt.u64 = liblapzt.u64.select(b.normal, b.exp, liblapzt.u64.one)
    sign: liblapzt.bool = liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b))
    exp: liblapzt.u64 = liblapzt.u64.sub(liblapzt.u64.add(a.exp.eff, b.exp.eff), liblapzt.f64.bias)
    [low, high] = liblapzt.u64.mul.full(a.man.eff, b.man.eff)
    extra: liblapzt.bool = liblapzt.u64.is.one(liblapzt.u64.mod(liblapzt.u64.div(high, liblapzt.f64.mul.extra.bit), liblapzt.f64.divisor.1))
    shifted.extra: liblapzt.u64 = liblapzt.u64.or(liblapzt.u64.mul(high, liblapzt.f64.mul.low.extra), liblapzt.u64.div(low, liblapzt.f64.two.pow.mantissa.plus.one))
    shifted.normal: liblapzt.u64 = liblapzt.u64.or(liblapzt.u64.mul(high, liblapzt.f64.mul.low.normal), liblapzt.u64.div(low, liblapzt.f64.two.pow.mantissa))
    shifted: liblapzt.u64 = liblapzt.u64.select(extra, shifted.extra, shifted.normal)
    exp.final: liblapzt.u64 = liblapzt.u64.add(exp, liblapzt.u64.select(extra, liblapzt.u64.one, liblapzt.u64.zero))
    overflow: liblapzt.bool = liblapzt.u64.ge(exp.final, liblapzt.f64.exponent.maximum)
    BRANCH (overflow) {
        liblapzt.f64.pack(sign, liblapzt.f64.exponent.maximum, liblapzt.u64.zero)
    } {
        subnormal: liblapzt.bool = liblapzt.u64.is.zero(exp.final)
