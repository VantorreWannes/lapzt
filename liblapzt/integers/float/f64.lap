        w55: liblapzt.integer.u64 = BRANCH (low54) { liblapzt.integer.u64.multiply.wrapping(w54, _liblapzt.f64.DIVISOR_1) } { w54 }
        d55: liblapzt.integer.u64 = BRANCH (low54) { liblapzt.integer.u64.subtract.wrapping(d54, _liblapzt.f64.BIT_0) } { d54 }
