    r83: liblapzt.u64 = liblapzt.u64.mul(r82, liblapzt.f64.divisor.1)
    ge41: liblapzt.bool = liblapzt.u64.ge(r83, b.man.eff)
    r84: liblapzt.u64 = liblapzt.u64.select(ge41, liblapzt.u64.sub(r83, b.man.eff), r83)
    q42: liblapzt.u64 = liblapzt.u64.select(ge41, liblapzt.u64.or(q41, liblapzt.f64.bit.10), q41)
    r85: liblapzt.u64 = liblapzt.u64.mul(r84, liblapzt.f64.divisor.1)
    ge42: liblapzt.bool = liblapzt.u64.ge(r85, b.man.eff)
    r86: liblapzt.u64 = liblapzt.u64.select(ge42, liblapzt.u64.sub(r85, b.man.eff), r85)
    q43: liblapzt.u64 = liblapzt.u64.select(ge42, liblapzt.u64.or(q42, liblapzt.f64.bit.9), q42)
    r87: liblapzt.u64 = liblapzt.u64.mul(r86, liblapzt.f64.divisor.1)
    ge43: liblapzt.bool = liblapzt.u64.ge(r87, b.man.eff)
    r88: liblapzt.u64 = liblapzt.u64.select(ge43, liblapzt.u64.sub(r87, b.man.eff), r87)
    q44: liblapzt.u64 = liblapzt.u64.select(ge43, liblapzt.u64.or(q43, liblapzt.f64.bit.8), q43)
    r89: liblapzt.u64 = liblapzt.u64.mul(r88, liblapzt.f64.divisor.1)
    ge44: liblapzt.bool = liblapzt.u64.ge(r89, b.man.eff)
    r90: liblapzt.u64 = liblapzt.u64.select(ge44, liblapzt.u64.sub(r89, b.man.eff), r89)
    q45: liblapzt.u64 = liblapzt.u64.select(ge44, liblapzt.u64.or(q44, liblapzt.f64.bit.7), q44)
    r91: liblapzt.u64 = liblapzt.u64.mul(r90, liblapzt.f64.divisor.1)
    ge45: liblapzt.bool = liblapzt.u64.ge(r91, b.man.eff)
    r92: liblapzt.u64 = liblapzt.u64.select(ge45, liblapzt.u64.sub(r91, b.man.eff), r91)
    q46: liblapzt.u64 = liblapzt.u64.select(ge45, liblapzt.u64.or(q45, liblapzt.f64.bit.6), q45)
    r93: liblapzt.u64 = liblapzt.u64.mul(r92, liblapzt.f64.divisor.1)
    ge46: liblapzt.bool = liblapzt.u64.ge(r93, b.man.eff)
    r94: liblapzt.u64 = liblapzt.u64.select(ge46, liblapzt.u64.sub(r93, b.man.eff), r93)
    q47: liblapzt.u64 = liblapzt.u64.select(ge46, liblapzt.u64.or(q46, liblapzt.f64.bit.5), q46)
    r95: liblapzt.u64 = liblapzt.u64.mul(r94, liblapzt.f64.divisor.1)
    ge47: liblapzt.bool = liblapzt.u64.ge(r95, b.man.eff)
    r96: liblapzt.u64 = liblapzt.u64.select(ge47, liblapzt.u64.sub(r95, b.man.eff), r95)
    q48: liblapzt.u64 = liblapzt.u64.select(ge47, liblapzt.u64.or(q47, liblapzt.f64.bit.4), q47)
    r97: liblapzt.u64 = liblapzt.u64.mul(r96, liblapzt.f64.divisor.1)
    ge48: liblapzt.bool = liblapzt.u64.ge(r97, b.man.eff)
    r98: liblapzt.u64 = liblapzt.u64.select(ge48, liblapzt.u64.sub(r97, b.man.eff), r97)
    q49: liblapzt.u64 = liblapzt.u64.select(ge48, liblapzt.u64.or(q48, liblapzt.f64.bit.3), q48)
    r99: liblapzt.u64 = liblapzt.u64.mul(r98, liblapzt.f64.divisor.1)
    ge49: liblapzt.bool = liblapzt.u64.ge(r99, b.man.eff)
    r100: liblapzt.u64 = liblapzt.u64.select(ge49, liblapzt.u64.sub(r99, b.man.eff), r99)
    q50: liblapzt.u64 = liblapzt.u64.select(ge49, liblapzt.u64.or(q49, liblapzt.f64.bit.2), q49)
    r101: liblapzt.u64 = liblapzt.u64.mul(r100, liblapzt.f64.divisor.1)
    ge50: liblapzt.bool = liblapzt.u64.ge(r101, b.man.eff)
    r102: liblapzt.u64 = liblapzt.u64.select(ge50, liblapzt.u64.sub(r101, b.man.eff), r101)
    q51: liblapzt.u64 = liblapzt.u64.select(ge50, liblapzt.u64.or(q50, liblapzt.f64.bit.1), q50)
    r103: liblapzt.u64 = liblapzt.u64.mul(r102, liblapzt.f64.divisor.1)
    ge51: liblapzt.bool = liblapzt.u64.ge(r103, b.man.eff)
    r104: liblapzt.u64 = liblapzt.u64.select(ge51, liblapzt.u64.sub(r103, b.man.eff), r103)
    q52: liblapzt.u64 = liblapzt.u64.select(ge51, liblapzt.u64.or(q51, liblapzt.f64.bit.0), q51)
    rounded: liblapzt.u64 = liblapzt.u64.select(liblapzt.bool.not(liblapzt.u64.is.zero(r104)), liblapzt.u64.add(q52, liblapzt.u64.one), q52)
    carry: liblapzt.bool = liblapzt.u64.is.one(liblapzt.u64.mod(liblapzt.u64.div(rounded, liblapzt.f64.two.pow.mantissa.plus.one), liblapzt.f64.divisor.1))
    s.final: liblapzt.u64 = liblapzt.u64.select(carry, liblapzt.u64.div(rounded, liblapzt.f64.divisor.1), rounded)
    e.final: liblapzt.u64 = liblapzt.u64.select(carry, liblapzt.u64.add(exp.final, liblapzt.u64.one), exp.final)
    overflow: liblapzt.bool = liblapzt.u64.ge(e.final, liblapzt.f64.exponent.maximum)
    BRANCH (overflow) {
        liblapzt.f64.pack(sign, liblapzt.f64.exponent.maximum, liblapzt.u64.zero)
    } {
        subnormal: liblapzt.bool = liblapzt.u64.is.zero(e.final)
        man.final: liblapzt.u64 = liblapzt.u64.select(subnormal, liblapzt.u64.mod(s.final, liblapzt.f64.two.pow.mantissa), liblapzt.u64.sub(s.final, liblapzt.f64.hidden))
        liblapzt.f64.pack(sign, e.final, man.final)
    }
}

liblapzt.f64.div.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    a.nan: liblapzt.bool = liblapzt.f64.is.nan(a)
    b.nan: liblapzt.bool = liblapzt.f64.is.nan(b)
    BRANCH (liblapzt.bool.or(a.nan, b.nan)) {
        liblapzt.f64.nan
    } {
        a.inf: liblapzt.bool = liblapzt.f64.is.infinite(a)
        b.inf: liblapzt.bool = liblapzt.f64.is.infinite(b)
        a.zero: liblapzt.bool = liblapzt.f64.is.zero(a)
        b.zero: liblapzt.bool = liblapzt.f64.is.zero(b)
        BRANCH (liblapzt.bool.or(liblapzt.bool.and(a.inf, b.inf), liblapzt.bool.and(a.zero, b.zero))) {
            liblapzt.f64.nan
        } {
            BRANCH (a.inf) {
                liblapzt.f64.pack(liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b)), liblapzt.f64.exponent.maximum, liblapzt.u64.zero)
            } {
                BRANCH (b.inf) {
                    liblapzt.f64.pack(liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b)), liblapzt.u64.zero, liblapzt.u64.zero)
                } {
                    BRANCH (a.zero) {
                        liblapzt.f64.pack(liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b)), liblapzt.u64.zero, liblapzt.u64.zero)
                    } {
                        BRANCH (b.zero) {
                            liblapzt.f64.pack(liblapzt.bool.xor(liblapzt.f64.sign(a), liblapzt.f64.sign(b)), liblapzt.f64.exponent.maximum, liblapzt.u64.zero)
                        } {
                            liblapzt.f64.div.finite(a, b)
                        }
                    }
                }
            }
        }
    }
}

// Returns a / b. NaN if either operand is NaN, and NaN for 0/0 and
// infinity/infinity. A nonzero value divided by zero gives infinity,
// a finite value divided by infinity gives zero, and both take the
// sign from the operands. Results that overflow become infinity; the
// quotient is rounded away from zero.
liblapzt.f64.div = liblapzt.f64.div.erased

// Rounds toward zero to an integer value. Values with magnitude below
// 1 become a zero with the same sign, and values with magnitude of at
// least 2^52 are returned unchanged. NaN and infinity are returned
// unchanged.
liblapzt.f64.trunc = (a: liblapzt.f64) liblapzt.f64 {
    exp: liblapzt.u64 = liblapzt.f64.exponent(a)
    small: liblapzt.bool = liblapzt.u64.lt(exp, liblapzt.f64.bias)
    BRANCH (small) {
        liblapzt.f64.pack(liblapzt.f64.sign(a), liblapzt.u64.zero, liblapzt.u64.zero)
    } {
        large: liblapzt.bool = liblapzt.u64.ge(exp, liblapzt.u64.add(liblapzt.f64.bias, liblapzt.f64.mantissa.width))
        BRANCH (large) {
            a
        } {
            shift: liblapzt.u64 = liblapzt.u64.sub(liblapzt.u64.add(liblapzt.f64.bias, liblapzt.f64.mantissa.width), exp)
            mask: liblapzt.u64 = liblapzt.u64.sub(liblapzt.f64.shl(liblapzt.u64.one, shift), liblapzt.u64.one)
            man: liblapzt.u64 = liblapzt.u64.and(liblapzt.f64.mantissa(a), liblapzt.u64.not(mask))
            liblapzt.f64.pack(liblapzt.f64.sign(a), exp, man)
        }
    }
}

liblapzt.f64.mod.erased = (a: liblapzt.f64, b: liblapzt.f64) liblapzt.f64 {
    quotient: liblapzt.f64 = liblapzt.f64.div(a, b)
    truncated: liblapzt.f64 = liblapzt.f64.trunc(quotient)
    liblapzt.f64.sub(a, liblapzt.f64.mul(truncated, b))
}

// Returns a - trunc(a / b) * b, the remainder with the sign of a.
// NaN if either operand is NaN or infinite, or if b is zero.
liblapzt.f64.mod = liblapzt.f64.mod.erased

liblapzt.f64.to.u64.erased = (a: liblapzt.f64) liblapzt.u64 {
    negative: liblapzt.bool = liblapzt.f64.sign(a)
    exp: liblapzt.u64 = liblapzt.f64.exponent(a)
    small: liblapzt.bool = liblapzt.u64.lt(exp, liblapzt.f64.bias)
    BRANCH (liblapzt.bool.or(negative, small)) {
        liblapzt.u64.zero
    } {
        too.large: liblapzt.bool = liblapzt.u64.ge(exp, liblapzt.u64.add(liblapzt.f64.bias, liblapzt.f64.integer.width))
        BRANCH (too.large) {
            liblapzt.u64.maximum
        } {
            man: liblapzt.u64 = liblapzt.u64.or(liblapzt.f64.mantissa(a), liblapzt.f64.hidden)
            shift: liblapzt.u64 = liblapzt.u64.sub(exp, liblapzt.f64.bias)
            left: liblapzt.bool = liblapzt.u64.ge(shift, liblapzt.f64.mantissa.width)
            left.amount: liblapzt.u64 = liblapzt.u64.sub(shift, liblapzt.f64.mantissa.width)
            right.amount: liblapzt.u64 = liblapzt.u64.sub(liblapzt.f64.mantissa.width, shift)
            liblapzt.u64.select(left, liblapzt.f64.shl(man, left.amount), liblapzt.f64.shr(man, right.amount))
        }
    }
}

// Converts to u64 by truncating toward zero. Negative values,
// including negative NaN, become 0, as do values with magnitude below
// 1. Values of magnitude 2^64 or more, including positive NaN and
// infinity, become u64.maximum.
liblapzt.f64.to.u64 = liblapzt.f64.to.u64.erased

liblapzt.f64.from.u64.erased = (a: liblapzt.u64) liblapzt.f64 {
    BRANCH (liblapzt.u64.is.zero(a)) {
        liblapzt.f64.zero
    } {
