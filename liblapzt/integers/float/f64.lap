        e0: liblapzt.u64 = liblapzt.u64.add(liblapzt.f64.bias, liblapzt.f64.mantissa.width)
        high0: liblapzt.bool = liblapzt.u64.ge(v0, liblapzt.f64.two.pow.mantissa.plus.one)
