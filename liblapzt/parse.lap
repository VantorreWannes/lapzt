// Returns the value of a decimal ASCII digit, or none when byte is not
// between zero and nine.
liblapzt.parse.digit = (byte: liblapzt.u8) liblapzt.option {
    below.zero: liblapzt.bool = liblapzt.u8.lt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.zero))
    above.nine: liblapzt.bool = liblapzt.u8.gt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.nine))
    invalid: liblapzt.bool = liblapzt.bool.or(below.zero, above.nine)
    BRANCH (invalid) {
        liblapzt.option.none
    } {
        liblapzt.option.some(liblapzt.u64.sub(liblapzt.u8.to.u64(byte), liblapzt.constants.ascii.zero))
    }
}

// Returns the value of a hexadecimal ASCII digit in either case, or
// none when byte is not a hex digit.
liblapzt.parse.hex.digit = (byte: liblapzt.u8) liblapzt.option {
    below.zero: liblapzt.bool = liblapzt.u8.lt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.zero))
    above.nine: liblapzt.bool = liblapzt.u8.gt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.nine))
    below.a: liblapzt.bool = liblapzt.u8.lt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.lower.a))
    above.f: liblapzt.bool = liblapzt.u8.gt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.lower.f))
    below.A: liblapzt.bool = liblapzt.u8.lt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.upper.a))
    above.F: liblapzt.bool = liblapzt.u8.gt(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.upper.f))
    decimal: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(below.zero), liblapzt.bool.not(above.nine))
    lower: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(below.a), liblapzt.bool.not(above.f))
    upper: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(below.A), liblapzt.bool.not(above.F))
    BRANCH (decimal) {
        liblapzt.option.some(liblapzt.u64.sub(liblapzt.u8.to.u64(byte), liblapzt.constants.ascii.zero))
    } {
        BRANCH (lower) {
            liblapzt.option.some(liblapzt.u64.add(liblapzt.u64.sub(liblapzt.u8.to.u64(byte), liblapzt.constants.ascii.lower.a), liblapzt.constants.ten))
        } {
            BRANCH (upper) {
                liblapzt.option.some(liblapzt.u64.add(liblapzt.u64.sub(liblapzt.u8.to.u64(byte), liblapzt.constants.ascii.upper.a), liblapzt.constants.ten))
            } {
                liblapzt.option.none
            }
        }
    }
}

// Accumulates decimal digits from index into value. Returns err with
// code one on the first non digit.
liblapzt.parse.u64.helper = (string: liblapzt.string, index: liblapzt.u64, value: liblapzt.u64) liblapzt.result {
    [handle, offset, length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, length)
    BRANCH (done) {
        liblapzt.result.ok(value)
    } {
        [ok, byte] = liblapzt.string.byte(string, index)
        [digit.ok, digit] = liblapzt.parse.digit(byte)
        BRANCH (digit.ok) {
            liblapzt.parse.u64.helper(string, liblapzt.u64.inc(index), liblapzt.u64.add(liblapzt.u64.mul(value, liblapzt.constants.ten), digit))
        } {
            liblapzt.result.err(liblapzt.constants.one)
        }
    }
}

// Parses the whole view as an unsigned decimal number. Returns ok with
// the value, or err with code one when the view is empty or holds a
// non digit. Overflow is not detected.
liblapzt.parse.u64 = (string: liblapzt.string) liblapzt.result {
    [handle, offset, length] = string
    empty: liblapzt.bool = liblapzt.u64.is.zero(length)
    BRANCH (empty) {
        liblapzt.result.err(liblapzt.constants.one)
    } {
        liblapzt.parse.u64.helper(string, liblapzt.u64.zero, liblapzt.u64.zero)
    }
}

// Parses the whole view as a signed decimal number with an optional
// leading plus or minus. Returns ok with the value, or err with code
// one when the view is empty or malformed.
liblapzt.parse.i64 = (string: liblapzt.string) liblapzt.result {
    [handle, offset, length] = string
    empty: liblapzt.bool = liblapzt.u64.is.zero(length)
    BRANCH (empty) {
        liblapzt.result.err(liblapzt.constants.one)
    } {
        [ok, first] = liblapzt.string.byte(string, liblapzt.u64.zero)
        minus: liblapzt.bool = liblapzt.u8.eq(first, liblapzt.u64.to.u8(liblapzt.constants.ascii.minus))
        plus: liblapzt.bool = liblapzt.u8.eq(first, liblapzt.u64.to.u8(liblapzt.constants.ascii.plus))
        signed: liblapzt.bool = liblapzt.bool.or(minus, plus)
        BRANCH (signed) {
            rest: liblapzt.string = [handle, liblapzt.u64.add(offset, liblapzt.u64.one), liblapzt.u64.dec(length)]
            [result.ok, result.value, result.code] = liblapzt.parse.u64(rest)
            BRANCH (result.ok) {
                magnitude: liblapzt.i64 = liblapzt.i64.from.u64(result.value)
                BRANCH (minus) {
                    liblapzt.result.ok(liblapzt.i64.to.u64(liblapzt.i64.neg(magnitude)))
                } {
                    liblapzt.result.ok(liblapzt.i64.to.u64(magnitude))
                }
            } {
                liblapzt.result.err(result.code)
            }
        } {
            [result.ok, result.value, result.code] = liblapzt.parse.u64(string)
            BRANCH (result.ok) {
                liblapzt.result.ok(liblapzt.i64.to.u64(liblapzt.i64.from.u64(result.value)))
            } {
                liblapzt.result.err(result.code)
            }
        }
    }
}

// Accumulates hexadecimal digits from index into value. Returns err
// with code one on the first non digit.
liblapzt.parse.hex.u64.helper = (string: liblapzt.string, index: liblapzt.u64, value: liblapzt.u64) liblapzt.result {
    [handle, offset, length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, length)
    BRANCH (done) {
        liblapzt.result.ok(value)
    } {
        [ok, byte] = liblapzt.string.byte(string, index)
        [digit.ok, digit] = liblapzt.parse.hex.digit(byte)
        BRANCH (digit.ok) {
            liblapzt.parse.hex.u64.helper(string, liblapzt.u64.inc(index), liblapzt.u64.add(liblapzt.u64.mul(value, liblapzt.constants.sixteen), digit))
        } {
            liblapzt.result.err(liblapzt.constants.one)
        }
    }
}

// Parses the whole view as an unsigned hexadecimal number without a
// prefix. Returns ok with the value, or err with code one when the
// view is empty or holds a non digit.
liblapzt.parse.hex.u64 = (string: liblapzt.string) liblapzt.result {
    [handle, offset, length] = string
    empty: liblapzt.bool = liblapzt.u64.is.zero(length)
    BRANCH (empty) {
        liblapzt.result.err(liblapzt.constants.one)
    } {
        liblapzt.parse.hex.u64.helper(string, liblapzt.u64.zero, liblapzt.u64.zero)
    }
}

// Reports whether the byte at index equals ascii. Out of range reads
// compare false.
liblapzt.parse.bool.byte = (string: liblapzt.string, index: liblapzt.u64, ascii: liblapzt.u64) liblapzt.bool {
    [ok, byte] = liblapzt.string.byte(string, index)
    liblapzt.u8.eq(byte, liblapzt.u64.to.u8(ascii))
}

// Reports whether the view starts with true. The length is not
// checked.
liblapzt.parse.bool.true = (string: liblapzt.string) liblapzt.bool {
    t: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.u64.zero, liblapzt.constants.ascii.lower.t)
    r: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.u64.one, liblapzt.constants.ascii.lower.r)
    u: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.constants.two, liblapzt.constants.ascii.lower.u)
    e: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.constants.three, liblapzt.constants.ascii.lower.e)
    liblapzt.bool.and(liblapzt.bool.and(t, r), liblapzt.bool.and(u, e))
}

// Reports whether the view starts with false. The length is not
// checked.
liblapzt.parse.bool.false = (string: liblapzt.string) liblapzt.bool {
    f: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.u64.zero, liblapzt.constants.ascii.lower.f)
    a: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.u64.one, liblapzt.constants.ascii.lower.a)
    l: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.constants.two, liblapzt.constants.ascii.lower.l)
    s: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.constants.three, liblapzt.constants.ascii.lower.s)
    e: liblapzt.bool = liblapzt.parse.bool.byte(string, liblapzt.constants.four, liblapzt.constants.ascii.lower.e)
    liblapzt.bool.and(liblapzt.bool.and(f, a), liblapzt.bool.and(l, liblapzt.bool.and(s, e)))
}

// Parses the whole view as true or false. Returns ok with one for true
// and zero for false, or err with code one for any other input.
liblapzt.parse.bool = (string: liblapzt.string) liblapzt.result {
    [handle, offset, length] = string
    is.true: liblapzt.bool = liblapzt.u64.eq(length, liblapzt.constants.four)
    is.false: liblapzt.bool = liblapzt.u64.eq(length, liblapzt.constants.five)
    true.match: liblapzt.bool = liblapzt.bool.and(is.true, liblapzt.parse.bool.true(string))
    false.match: liblapzt.bool = liblapzt.bool.and(is.false, liblapzt.parse.bool.false(string))
    BRANCH (true.match) {
        liblapzt.result.ok(liblapzt.u64.one)
    } {
        BRANCH (false.match) {
            liblapzt.result.ok(liblapzt.u64.zero)
        } {
            liblapzt.result.err(liblapzt.constants.one)
        }
    }
}

// Accumulates digits from index into value, switching to fractional
// scaling after the first dot. Returns [ok, value]; ok is false on a
// second dot or a non digit.
liblapzt.parse.f64.helper = (string: liblapzt.string, index: liblapzt.u64, value: liblapzt.f64, scale: liblapzt.f64, fractional: liblapzt.bool) [liblapzt.bool, liblapzt.f64] {
    [handle, offset, length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, length)
    BRANCH (done) {
        [liblapzt.bool.true, value]
    } {
        [ok, byte] = liblapzt.string.byte(string, index)
        dot: liblapzt.bool = liblapzt.u8.eq(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.dot))
        BRANCH (dot) {
            BRANCH (fractional) {
                [liblapzt.bool.false, liblapzt.f64.zero]
            } {
                liblapzt.parse.f64.helper(string, liblapzt.u64.inc(index), value, liblapzt.f64.one, liblapzt.bool.true)
            }
        } {
            [digit.ok, digit] = liblapzt.parse.digit(byte)
            BRANCH (digit.ok) {
                BRANCH (fractional) {
                    ten: liblapzt.f64 = liblapzt.f64.from.u64(liblapzt.constants.ten)
                    digit.value: liblapzt.f64 = liblapzt.f64.from.u64(digit)
                    next.scale: liblapzt.f64 = liblapzt.f64.mul(scale, ten)
                    next.value: liblapzt.f64 = liblapzt.f64.add(value, liblapzt.f64.div(digit.value, next.scale))
                    liblapzt.parse.f64.helper(string, liblapzt.u64.inc(index), next.value, next.scale, liblapzt.bool.true)
                } {
                    ten: liblapzt.f64 = liblapzt.f64.from.u64(liblapzt.constants.ten)
                    digit.value: liblapzt.f64 = liblapzt.f64.from.u64(digit)
                    next.value: liblapzt.f64 = liblapzt.f64.add(liblapzt.f64.mul(value, ten), digit.value)
                    liblapzt.parse.f64.helper(string, liblapzt.u64.inc(index), next.value, scale, liblapzt.bool.false)
                }
            } {
                [liblapzt.bool.false, liblapzt.f64.zero]
            }
        }
    }
}

// Parses the whole view as a decimal floating point number with an
// optional leading sign and at most one dot. Returns [ok, value]; ok
// is false when the view is empty or malformed.
liblapzt.parse.f64 = (string: liblapzt.string) [liblapzt.bool, liblapzt.f64] {
    [handle, offset, length] = string
    empty: liblapzt.bool = liblapzt.u64.is.zero(length)
    BRANCH (empty) {
        [liblapzt.bool.false, liblapzt.f64.zero]
    } {
        [ok, first] = liblapzt.string.byte(string, liblapzt.u64.zero)
        minus: liblapzt.bool = liblapzt.u8.eq(first, liblapzt.u64.to.u8(liblapzt.constants.ascii.minus))
        plus: liblapzt.bool = liblapzt.u8.eq(first, liblapzt.u64.to.u8(liblapzt.constants.ascii.plus))
        signed: liblapzt.bool = liblapzt.bool.or(minus, plus)
        BRANCH (signed) {
            rest: liblapzt.string = [handle, liblapzt.u64.add(offset, liblapzt.u64.one), liblapzt.u64.dec(length)]
            [ok2, value] = liblapzt.parse.f64.helper(rest, liblapzt.u64.zero, liblapzt.f64.zero, liblapzt.f64.one, liblapzt.bool.false)
            BRANCH (ok2) {
                BRANCH (minus) {
                    [liblapzt.bool.true, liblapzt.f64.neg(value)]
                } {
                    [liblapzt.bool.true, value]
                }
            } {
                [liblapzt.bool.false, liblapzt.f64.zero]
            }
        } {
            liblapzt.parse.f64.helper(string, liblapzt.u64.zero, liblapzt.f64.zero, liblapzt.f64.one, liblapzt.bool.false)
        }
    }
}

// Parses the view as a decimal number and narrows it to 32 bits.
// Returns [ok, value]; ok is false when the input is malformed.
liblapzt.parse.f32 = (string: liblapzt.string) [liblapzt.bool, liblapzt.f32] {
    [ok, value] = liblapzt.parse.f64(string)
    [ok, liblapzt.f64.to.f32(value)]
}

// Parses the view as a decimal number and narrows it to 16 bits.
// Returns [ok, value]; ok is false when the input is malformed.
liblapzt.parse.f16 = (string: liblapzt.string) [liblapzt.bool, liblapzt.f16] {
    [ok, value] = liblapzt.parse.f64(string)
    [ok, liblapzt.f64.to.f16(value)]
}

// Parses the view as a decimal number and widens it to 128 bits.
// Returns [ok, value]; ok is false when the input is malformed.
liblapzt.parse.f128 = (string: liblapzt.string) [liblapzt.bool, liblapzt.f128] {
    [ok, value] = liblapzt.parse.f64(string)
    [ok, liblapzt.f64.to.f128(value)]
}
