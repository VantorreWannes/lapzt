liblapzt.ordering = [liblapzt.bool, liblapzt.bool]

liblapzt.ordering.less: liblapzt.ordering = [liblapzt.bool.true, liblapzt.bool.false]
liblapzt.ordering.equal: liblapzt.ordering = [liblapzt.bool.false, liblapzt.bool.false]
liblapzt.ordering.greater: liblapzt.ordering = [liblapzt.bool.false, liblapzt.bool.true]

liblapzt.ordering.is.less = (ordering: liblapzt.ordering) liblapzt.bool {
    [less, greater] = ordering
    less
}

liblapzt.ordering.is.equal = (ordering: liblapzt.ordering) liblapzt.bool {
    [less, greater] = ordering
    liblapzt.bool.and(liblapzt.bool.not(less), liblapzt.bool.not(greater))
}

liblapzt.ordering.is.greater = (ordering: liblapzt.ordering) liblapzt.bool {
    [less, greater] = ordering
    greater
}

liblapzt.ordering.reverse = (ordering: liblapzt.ordering) liblapzt.ordering {
    [less, greater] = ordering
    [greater, less]
}

liblapzt.ordering.then = (first: liblapzt.ordering, second: liblapzt.ordering) liblapzt.ordering {
    equal: liblapzt.bool = liblapzt.ordering.is.equal(first)
    BRANCH (equal) {
        second
    } {
        first
    }
}

liblapzt.compare.bool = (a: liblapzt.bool, b: liblapzt.bool) liblapzt.ordering {
    less: liblapzt.bool = liblapzt.bool.and(a, liblapzt.bool.not(b))
    greater: liblapzt.bool = liblapzt.bool.and(liblapzt.bool.not(a), b)
    [less, greater]
}

liblapzt.compare.u8 = (a: liblapzt.u8, b: liblapzt.u8) liblapzt.ordering {
    [liblapzt.u8.lt(a, b), liblapzt.u8.gt(a, b)]
}

liblapzt.compare.u16 = (a: liblapzt.u16, b: liblapzt.u16) liblapzt.ordering {
    [liblapzt.u16.lt(a, b), liblapzt.u16.gt(a, b)]
}

liblapzt.compare.u32 = (a: liblapzt.u32, b: liblapzt.u32) liblapzt.ordering {
    [liblapzt.u32.lt(a, b), liblapzt.u32.gt(a, b)]
}

liblapzt.compare.u64 = (a: liblapzt.u64, b: liblapzt.u64) liblapzt.ordering {
    [liblapzt.u64.lt(a, b), liblapzt.u64.gt(a, b)]
}

liblapzt.compare.u128 = (a: liblapzt.u128, b: liblapzt.u128) liblapzt.ordering {
    [liblapzt.u128.lt(a, b), liblapzt.u128.gt(a, b)]
}

liblapzt.compare.i8 = (a: liblapzt.i8, b: liblapzt.i8) liblapzt.ordering {
    [liblapzt.i8.lt(a, b), liblapzt.i8.gt(a, b)]
}

liblapzt.compare.i16 = (a: liblapzt.i16, b: liblapzt.i16) liblapzt.ordering {
    [liblapzt.i16.lt(a, b), liblapzt.i16.gt(a, b)]
}

liblapzt.compare.i32 = (a: liblapzt.i32, b: liblapzt.i32) liblapzt.ordering {
