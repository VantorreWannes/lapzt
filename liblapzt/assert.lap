liblapzt.assert.true = (condition: liblapzt.bool) [] {
    BRANCH (condition) {
        []
    } {
        liblapzt.process.exit(liblapzt.u64.one)
    }
}

liblapzt.assert.false = (condition: liblapzt.bool) [] {
    liblapzt.assert.true(liblapzt.bool.not(condition))
}

liblapzt.assert.eq.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.eq(a, b))
}

liblapzt.assert.ne.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.ne(a, b))
}

liblapzt.assert.lt.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.lt(a, b))
}

liblapzt.assert.le.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.le(a, b))
}

liblapzt.assert.gt.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.gt(a, b))
}

liblapzt.assert.ge.u64 = (a: liblapzt.u64, b: liblapzt.u64) [] {
    liblapzt.assert.true(liblapzt.u64.ge(a, b))
}

liblapzt.assert.eq.bool = (a: liblapzt.bool, b: liblapzt.bool) [] {
    liblapzt.assert.true(liblapzt.bool.eq(a, b))
}
