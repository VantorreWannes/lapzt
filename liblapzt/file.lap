// File access through OP.FILE.OPEN, OP.FILE.CLOSE, and OP.FILE.SEEK.
//
// A file handle is a seekable stream, so liblapzt.io.read.word and
// liblapzt.io.write.word use the current position and ignore offset.

// Opens an existing file for reading.
liblapzt.file.mode.read: liblapzt.u64 = liblapzt.constants.n0
// Creates or truncates a file for writing.
liblapzt.file.mode.write: liblapzt.u64 = liblapzt.constants.n1
// Creates a file if needed and seeks to the end for writing.
liblapzt.file.mode.append: liblapzt.u64 = liblapzt.constants.n2
// Opens an existing file for reading and writing.
liblapzt.file.mode.read.write: liblapzt.u64 = liblapzt.constants.n3

// Seeks from the start of the file.
liblapzt.file.whence.start: liblapzt.u64 = liblapzt.constants.n0
// Seeks from the current position. The offset is signed.
liblapzt.file.whence.current: liblapzt.u64 = liblapzt.constants.n1
// Seeks from the end of the file. The offset is signed.
liblapzt.file.whence.end: liblapzt.u64 = liblapzt.constants.n2

// Opens the bytes of a string as a file path. Returns a status and a file
// handle. Read mode fails when the file is missing.
liblapzt.file.open = (path: liblapzt.string, mode: liblapzt.u64) [BIT, liblapzt.u64] {
    EXTERN(OP.FILE.OPEN, liblapzt.string.handle(path), liblapzt.string.offset(path), liblapzt.string.length(path), mode)
}

// Opens length bytes at offset in a memory handle as a file path.
liblapzt.file.open.at = (handle: liblapzt.u64, offset: liblapzt.u64, length: liblapzt.u64, mode: liblapzt.u64) [BIT, liblapzt.u64] {
    EXTERN(OP.FILE.OPEN, handle, offset, length, mode)
}

// Closes a file handle. The handle is invalid afterwards.
liblapzt.file.close = (handle: liblapzt.u64) [BIT] {
    EXTERN(OP.FILE.CLOSE, handle)
}

// Moves a file handle by offset relative to whence.
liblapzt.file.seek = (handle: liblapzt.u64, offset: liblapzt.u64, whence: liblapzt.u64) [BIT] {
    EXTERN(OP.FILE.SEEK, handle, offset, whence)
}

// Reads the next word from a file handle. Returns false at end of file.
liblapzt.file.read = (handle: liblapzt.u64) [BIT, liblapzt.u64] {
    liblapzt.io.read.word(handle)
}

// Writes a word to a file handle at the current position.
liblapzt.file.write = (handle: liblapzt.u64, value: liblapzt.u64) [BIT] {
    liblapzt.io.write.word(handle, value)
}

// Writes the bytes of a string to a file handle at the current position.
liblapzt.file.write.string = (handle: liblapzt.u64, string: liblapzt.string) [BIT] {
    liblapzt.string.write(handle, string)
}
