// A string is a view over bytes in a memory handle, stored as
// [handle, offset, length]. It does not own its bytes.
liblapzt.string = [liblapzt.u64, liblapzt.u64, liblapzt.u64]

// Builds a string view over length bytes at offset in a memory handle.
// The view does not own its bytes; the caller keeps the handle alive.
// No bounds check is performed here, so an out of range view fails
// later when a byte is read.
liblapzt.string.new = (handle: liblapzt.u64, offset: liblapzt.u64, length: liblapzt.u64) liblapzt.string {
    [handle, offset, length]
}

// Returns the memory handle the view points into.
liblapzt.string.handle = (string: liblapzt.string) liblapzt.u64 {
    [handle, offset, length] = string
    handle
}

// Returns the byte offset of the first byte within the handle.
liblapzt.string.offset = (string: liblapzt.string) liblapzt.u64 {
    [handle, offset, length] = string
    offset
}

// Returns the number of bytes in the view. An empty string has length
// zero.
liblapzt.string.length = (string: liblapzt.string) liblapzt.u64 {
    [handle, offset, length] = string
    length
}

// Reads the byte at index within the view. Returns [ok, byte]; ok is
// false when the read falls outside the handle, in which case byte is
// unspecified.
liblapzt.string.byte = (string: liblapzt.string, index: liblapzt.u64) [BIT, liblapzt.u8] {
    [handle, offset, length] = string
    liblapzt.memory.read.byte(handle, liblapzt.u64.add(offset, index))
}

// Compares both views from index to the end of a. Callers must pass
// equal lengths.
liblapzt.string.eq.helper = (a: liblapzt.string, b: liblapzt.string, index: liblapzt.u64) liblapzt.bool {
    [a.handle, a.offset, a.length] = a
    [b.handle, b.offset, b.length] = b
    done: liblapzt.bool = liblapzt.u64.ge(index, a.length)
    BRANCH (done) {
        liblapzt.bool.true
    } {
        [a.ok, a.byte] = liblapzt.memory.read.byte(a.handle, liblapzt.u64.add(a.offset, index))
        [b.ok, b.byte] = liblapzt.memory.read.byte(b.handle, liblapzt.u64.add(b.offset, index))
        same: liblapzt.bool = liblapzt.u8.eq(a.byte, b.byte)
        BRANCH (same) {
            liblapzt.string.eq.helper(a, b, liblapzt.u64.inc(index))
        } {
            liblapzt.bool.false
        }
    }
}

// Reports whether both views hold the same bytes. Views of different
// lengths are never equal.
liblapzt.string.eq = (a: liblapzt.string, b: liblapzt.string) liblapzt.bool {
    [a.handle, a.offset, a.length] = a
    [b.handle, b.offset, b.length] = b
    same.length: liblapzt.bool = liblapzt.u64.eq(a.length, b.length)
    BRANCH (same.length) {
        liblapzt.string.eq.helper(a, b, liblapzt.u64.zero)
    } {
        liblapzt.bool.false
    }
}

// Compares both views from index, treating a shorter prefix as less.
liblapzt.string.compare.helper = (a: liblapzt.string, b: liblapzt.string, index: liblapzt.u64) liblapzt.ordering {
    [a.handle, a.offset, a.length] = a
    [b.handle, b.offset, b.length] = b
    a.done: liblapzt.bool = liblapzt.u64.ge(index, a.length)
    b.done: liblapzt.bool = liblapzt.u64.ge(index, b.length)
    BRANCH (a.done) {
        BRANCH (b.done) {
            liblapzt.ordering.equal
        } {
            liblapzt.ordering.less
        }
    } {
        BRANCH (b.done) {
            liblapzt.ordering.greater
        } {
            [a.ok, a.byte] = liblapzt.memory.read.byte(a.handle, liblapzt.u64.add(a.offset, index))
            [b.ok, b.byte] = liblapzt.memory.read.byte(b.handle, liblapzt.u64.add(b.offset, index))
            ordering: liblapzt.ordering = liblapzt.compare.u8(a.byte, b.byte)
            equal: liblapzt.bool = liblapzt.ordering.is.equal(ordering)
            BRANCH (equal) {
                liblapzt.string.compare.helper(a, b, liblapzt.u64.inc(index))
            } {
                ordering
            }
        }
    }
}

// Orders the two views byte by byte. Returns less, equal, or greater.
// A proper prefix sorts before the longer string.
liblapzt.string.compare = (a: liblapzt.string, b: liblapzt.string) liblapzt.ordering {
    liblapzt.string.compare.helper(a, b, liblapzt.u64.zero)
}

// Copies the bytes of source into destination at destination.offset.
// Returns [ok]; ok is false when the destination range is invalid.
// The source view is not modified.
liblapzt.string.copy = (destination: liblapzt.u64, destination.offset: liblapzt.u64, source: liblapzt.string) [BIT] {
    [handle, offset, length] = source
    liblapzt.memory.copy(destination, liblapzt.u64.add(handle, offset), length)
}

// Reports whether needle occurs in haystack at index, starting the
// needle comparison at needle.index. Used to walk a match.
liblapzt.string.match.at = (haystack: liblapzt.string, needle: liblapzt.string, index: liblapzt.u64, needle.index: liblapzt.u64) liblapzt.bool {
    [h.handle, h.offset, h.length] = haystack
    [n.handle, n.offset, n.length] = needle
    done: liblapzt.bool = liblapzt.u64.ge(needle.index, n.length)
    BRANCH (done) {
        liblapzt.bool.true
    } {
        [h.ok, h.byte] = liblapzt.memory.read.byte(h.handle, liblapzt.u64.add(h.offset, liblapzt.u64.add(index, needle.index)))
        [n.ok, n.byte] = liblapzt.memory.read.byte(n.handle, liblapzt.u64.add(n.offset, needle.index))
        same: liblapzt.bool = liblapzt.u8.eq(h.byte, n.byte)
        BRANCH (same) {
            liblapzt.string.match.at(haystack, needle, index, liblapzt.u64.inc(needle.index))
        } {
            liblapzt.bool.false
        }
    }
}

// Searches haystack for needle from index. Returns none when the
// remaining bytes are too short to hold a match.
liblapzt.string.find.helper = (haystack: liblapzt.string, needle: liblapzt.string, index: liblapzt.u64) liblapzt.option {
    [h.handle, h.offset, h.length] = haystack
    [n.handle, n.offset, n.length] = needle
    end: liblapzt.u64 = liblapzt.u64.add(index, n.length)
    too.far: liblapzt.bool = liblapzt.u64.gt(end, h.length)
    BRANCH (too.far) {
        liblapzt.option.none
    } {
        matched: liblapzt.bool = liblapzt.string.match.at(haystack, needle, index, liblapzt.u64.zero)
        BRANCH (matched) {
            liblapzt.option.some(index)
        } {
            liblapzt.string.find.helper(haystack, needle, liblapzt.u64.inc(index))
        }
    }
}

// Returns the index of the first occurrence of needle in haystack, or
// none when it does not occur. An empty needle matches at index zero.
liblapzt.string.find = (haystack: liblapzt.string, needle: liblapzt.string) liblapzt.option {
    [n.handle, n.offset, n.length] = needle
    empty: liblapzt.bool = liblapzt.u64.is.zero(n.length)
    BRANCH (empty) {
        liblapzt.option.some(liblapzt.u64.zero)
    } {
        liblapzt.string.find.helper(haystack, needle, liblapzt.u64.zero)
    }
}

// Reports whether string begins with prefix. An empty prefix always
// matches, and a prefix longer than the string never does.
liblapzt.string.starts.with = (string: liblapzt.string, prefix: liblapzt.string) liblapzt.bool {
    [s.handle, s.offset, s.length] = string
    [p.handle, p.offset, p.length] = prefix
    too.long: liblapzt.bool = liblapzt.u64.gt(p.length, s.length)
    BRANCH (too.long) {
        liblapzt.bool.false
    } {
        liblapzt.string.match.at(string, prefix, liblapzt.u64.zero, liblapzt.u64.zero)
    }
}

// Reports whether string ends with suffix. An empty suffix always
// matches, and a suffix longer than the string never does.
liblapzt.string.ends.with = (string: liblapzt.string, suffix: liblapzt.string) liblapzt.bool {
    [s.handle, s.offset, s.length] = string
    [p.handle, p.offset, p.length] = suffix
    too.long: liblapzt.bool = liblapzt.u64.gt(p.length, s.length)
    BRANCH (too.long) {
        liblapzt.bool.false
    } {
        liblapzt.string.match.at(string, suffix, liblapzt.u64.sub(s.length, p.length), liblapzt.u64.zero)
    }
}

// Reports whether byte is a space, tab, newline, or carriage return.
liblapzt.string.is.space = (byte: liblapzt.u8) liblapzt.bool {
    space: liblapzt.bool = liblapzt.u8.eq(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.space))
    tab: liblapzt.bool = liblapzt.u8.eq(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.tab))
    newline: liblapzt.bool = liblapzt.u8.eq(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.newline))
    carriage: liblapzt.bool = liblapzt.u8.eq(byte, liblapzt.u64.to.u8(liblapzt.constants.ascii.carriage.return))
    liblapzt.bool.or(liblapzt.bool.or(space, tab), liblapzt.bool.or(newline, carriage))
}

// Returns the view with leading whitespace skipped, starting at index.
liblapzt.string.trim.left.helper = (string: liblapzt.string, index: liblapzt.u64) liblapzt.string {
    [handle, offset, length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, length)
    BRANCH (done) {
        string
    } {
        [ok, byte] = liblapzt.memory.read.byte(handle, liblapzt.u64.add(offset, index))
        space: liblapzt.bool = liblapzt.string.is.space(byte)
        BRANCH (space) {
            liblapzt.string.trim.left.helper(string, liblapzt.u64.inc(index))
        } {
            [handle, liblapzt.u64.add(offset, index), liblapzt.u64.sub(length, index)]
        }
    }
}

// Returns the view with leading whitespace removed. The result shares
// the original bytes and is empty when the input is all whitespace.
liblapzt.string.trim.left = (string: liblapzt.string) liblapzt.string {
    liblapzt.string.trim.left.helper(string, liblapzt.u64.zero)
}

// Returns the view truncated to length after trailing whitespace is
// removed.
liblapzt.string.trim.right.helper = (string: liblapzt.string, length: liblapzt.u64) liblapzt.string {
    [handle, offset, original] = string
    done: liblapzt.bool = liblapzt.u64.is.zero(length)
    BRANCH (done) {
        [handle, offset, liblapzt.u64.zero]
    } {
        [ok, byte] = liblapzt.memory.read.byte(handle, liblapzt.u64.add(offset, liblapzt.u64.dec(length)))
        space: liblapzt.bool = liblapzt.string.is.space(byte)
        BRANCH (space) {
            liblapzt.string.trim.right.helper(string, liblapzt.u64.dec(length))
        } {
            [handle, offset, length]
        }
    }
}

// Returns the view with trailing whitespace removed. The result shares
// the original bytes and is empty when the input is all whitespace.
liblapzt.string.trim.right = (string: liblapzt.string) liblapzt.string {
    [handle, offset, length] = string
    liblapzt.string.trim.right.helper(string, length)
}

// Packs up to eight bytes starting at index into a word, low byte
// first. Bytes past the end of the view are left as zero.
liblapzt.string.print.word.helper = (handle: liblapzt.u64, offset: liblapzt.u64, length: liblapzt.u64, index: liblapzt.u64, byte.index: liblapzt.u64, word: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.ge(byte.index, liblapzt.constants.eight)
    BRANCH (done) {
        word
    } {
        position: liblapzt.u64 = liblapzt.u64.add(index, byte.index)
        in.bounds: liblapzt.bool = liblapzt.u64.lt(position, length)
        next.word: liblapzt.u64 = BRANCH (in.bounds) {
            [ok, byte] = liblapzt.memory.read.byte(handle, liblapzt.u64.add(offset, position))
            liblapzt.u64.or(word, liblapzt.math.shl.u64(liblapzt.u8.to.u64(byte), liblapzt.u64.mul(byte.index, liblapzt.constants.eight)))
        } {
            word
        }
        liblapzt.string.print.word.helper(handle, offset, length, index, liblapzt.u64.inc(byte.index), next.word)
    }
}

// Returns the eight bytes at index packed into a word, low byte first,
// zero padded past the end of the view.
liblapzt.string.print.word = (string: liblapzt.string, index: liblapzt.u64) liblapzt.u64 {
    [handle, offset, length] = string
    liblapzt.string.print.word.helper(handle, offset, length, index, liblapzt.u64.zero, liblapzt.u64.zero)
}

// Writes the view from index in eight byte words until the end.
liblapzt.string.print.helper = (string: liblapzt.string, index: liblapzt.u64) [] {
    [handle, offset, length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, length)
    BRANCH (done) {
        []
    } {
        word: liblapzt.u64 = liblapzt.string.print.word(string, index)
        remaining: liblapzt.u64 = liblapzt.u64.sub(length, index)
        count: liblapzt.u64 = liblapzt.u64.min(remaining, liblapzt.constants.eight)
        [ok] = liblapzt.io.write.bytes(liblapzt.io.stdout, liblapzt.u64.zero, word, count)
        liblapzt.assert.true(ok)
        liblapzt.string.print.helper(string, liblapzt.u64.add(index, liblapzt.constants.eight))
    }
}

// Writes the view to standard output. The final word is written with
// only the bytes that remain, so the byte count is length.
liblapzt.string.print = (string: liblapzt.string) [] {
    liblapzt.string.print.helper(string, liblapzt.u64.zero)
}

// Writes the view from index to handle, stopping at the first failed
// write.
liblapzt.string.write.helper = (handle: liblapzt.u64, string: liblapzt.string, index: liblapzt.u64) [BIT] {
    [string.handle, string.offset, string.length] = string
    done: liblapzt.bool = liblapzt.u64.ge(index, string.length)
    BRANCH (done) {
        [liblapzt.bool.true]
    } {
        word: liblapzt.u64 = liblapzt.string.print.word(string, index)
        remaining: liblapzt.u64 = liblapzt.u64.sub(string.length, index)
        count: liblapzt.u64 = liblapzt.u64.min(remaining, liblapzt.constants.eight)
        [ok] = liblapzt.io.write.bytes(handle, liblapzt.u64.zero, word, count)
        BRANCH (ok) {
            liblapzt.string.write.helper(handle, string, liblapzt.u64.add(index, liblapzt.constants.eight))
        } {
            [liblapzt.bool.false]
        }
    }
}

// Writes the view to handle. Returns [ok], false when a write fails.
// The final word is written with only the bytes that remain.
liblapzt.string.write = (handle: liblapzt.u64, string: liblapzt.string) [BIT] {
    liblapzt.string.write.helper(handle, string, liblapzt.u64.zero)
}

// Writes the view to standard output. Alias of string.print.
liblapzt.print.string = (string: liblapzt.string) [] {
    liblapzt.string.print(string)
}

// Writes the view to handle. Alias of string.write.
liblapzt.io.write.string = (handle: liblapzt.u64, string: liblapzt.string) [BIT] {
    liblapzt.string.write(handle, string)
}
