liblapzt.result = [liblapzt.bool, liblapzt.u64, liblapzt.u64]

liblapzt.result.ok = (value: liblapzt.u64) liblapzt.result {
    [liblapzt.bool.true, value, liblapzt.u64.zero]
}

liblapzt.result.err = (code: liblapzt.u64) liblapzt.result {
    [liblapzt.bool.false, liblapzt.u64.zero, code]
}

liblapzt.result.is.ok = (result: liblapzt.result) liblapzt.bool {
    [ok, value, code] = result
    ok
}

liblapzt.result.is.err = (result: liblapzt.result) liblapzt.bool {
    [ok, value, code] = result
    liblapzt.bool.not(ok)
}

liblapzt.result.value = (result: liblapzt.result) liblapzt.u64 {
    [ok, value, code] = result
    value
}

liblapzt.result.code = (result: liblapzt.result) liblapzt.u64 {
    [ok, value, code] = result
    code
}

liblapzt.result.unwrap = (result: liblapzt.result) liblapzt.u64 {
    [ok, value, code] = result
    liblapzt.assert.true(ok)
    value
}

liblapzt.result.unwrap.or = (result: liblapzt.result, default: liblapzt.u64) liblapzt.u64 {
    [ok, value, code] = result
    BRANCH (ok) {
        value
    } {
        default
    }
}
