}

liblapzt.math.isqrt.u64.helper = (value: liblapzt.u64, low: liblapzt.u64, high: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.ge(low, high)
    BRANCH (done) {
        liblapzt.u64.dec(low)
    } {
        mid: liblapzt.u64 = liblapzt.u64.div(liblapzt.u64.add(low, high), liblapzt.constants.two)
        mid.zero: liblapzt.bool = liblapzt.u64.is.zero(mid)
        too.big: liblapzt.bool = BRANCH (mid.zero) {
            liblapzt.bool.false
        } {
            liblapzt.u64.gt(mid, liblapzt.u64.div(value, mid))
        }
        BRANCH (too.big) {
            liblapzt.math.isqrt.u64.helper(value, low, mid)
        } {
            liblapzt.math.isqrt.u64.helper(value, liblapzt.u64.inc(mid), high)
        }
    }
}

