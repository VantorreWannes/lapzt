    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 16 when a is zero.
liblapzt.math.ctz.u16 = (a: liblapzt.u16) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u8.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.eight, liblapzt.math.ctz.u8(high))
    } {
