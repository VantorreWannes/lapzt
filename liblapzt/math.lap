liblapzt.math.clamp.u64 = (value: liblapzt.u64, low: liblapzt.u64, high: liblapzt.u64) liblapzt.u64 {
    below: liblapzt.bool = liblapzt.u64.lt(value, low)
    above: liblapzt.bool = liblapzt.u64.gt(value, high)
    BRANCH (below) {
