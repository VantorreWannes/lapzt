liblapzt.math.next.power.of.two.u64.helper = (value: liblapzt.u64, power: liblapzt.u64) liblapzt.u64 {
    enough: liblapzt.bool = liblapzt.u64.ge(power, value)
    BRANCH (enough) {
        power
