        BRANCH (above) {
            high
        } {
            value
        }
    }
}

liblapzt.math.abs.i8 = liblapzt.i8.abs
liblapzt.math.abs.i16 = liblapzt.i16.abs
liblapzt.math.abs.i32 = liblapzt.i32.abs
liblapzt.math.abs.i64 = liblapzt.i64.abs
liblapzt.math.abs.i128 = liblapzt.i128.abs

liblapzt.math.sign.i8 = liblapzt.i8.sign
liblapzt.math.sign.i16 = liblapzt.i16.sign
liblapzt.math.sign.i32 = liblapzt.i32.sign
liblapzt.math.sign.i64 = liblapzt.i64.sign
liblapzt.math.sign.i128 = liblapzt.i128.sign

liblapzt.math.shl.u128 = (value: liblapzt.u128, amount: liblapzt.u64) liblapzt.u128 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (zero) {
        value
    } {
        liblapzt.math.shl.u128(liblapzt.u128.shl1(value), liblapzt.u64.dec(amount))
    }
}

liblapzt.math.shr.u128 = (value: liblapzt.u128, amount: liblapzt.u64) liblapzt.u128 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (zero) {
        value
    } {
        liblapzt.math.shr.u128(liblapzt.math.shr1.u128(value), liblapzt.u64.dec(amount))
    }
}
