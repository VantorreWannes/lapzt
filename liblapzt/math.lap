    right: liblapzt.u64 = liblapzt.math.shr.u64(value, amount.mod)
    left: liblapzt.u64 = liblapzt.math.shl.u64(value, liblapzt.u64.sub(liblapzt.constants.sixty.four, amount.mod))
    liblapzt.u64.or(left, right)
}

