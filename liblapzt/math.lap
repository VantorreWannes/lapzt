liblapzt.math.align.up.u64 = (value: liblapzt.u64, alignment: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(alignment)
    BRANCH (zero) {
        value
    } {
        remainder: liblapzt.u64 = liblapzt.u64.mod(value, alignment)
        aligned: liblapzt.bool = liblapzt.u64.is.zero(remainder)
        BRANCH (aligned) {
            value
        } {
            liblapzt.u64.add(value, liblapzt.u64.sub(alignment, remainder))
        }
    }
}

