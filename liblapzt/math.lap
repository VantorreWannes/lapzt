    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 32 when a is zero.
liblapzt.math.ctz.u32 = (a: liblapzt.u32) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u16.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.sixteen, liblapzt.math.ctz.u16(high))
    } {
        liblapzt.math.ctz.u16(low)
    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 64 when a is zero.
liblapzt.math.ctz.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u32.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.thirty.two, liblapzt.math.ctz.u32(high))
    } {
