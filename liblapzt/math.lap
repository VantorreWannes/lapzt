    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 128 when a is zero.
liblapzt.math.ctz.u128 = (a: liblapzt.u128) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u64.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.sixty.four, liblapzt.math.ctz.u64(high))
    } {
        liblapzt.math.ctz.u64(low)
    }
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u1 = (a: liblapzt.u1) liblapzt.u1 {
    a
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u2 = (a: liblapzt.u2) liblapzt.u2 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u1(high), liblapzt.math.reverse.bits.u1(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u4 = (a: liblapzt.u4) liblapzt.u4 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u2(high), liblapzt.math.reverse.bits.u2(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u8 = (a: liblapzt.u8) liblapzt.u8 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u4(high), liblapzt.math.reverse.bits.u4(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u16 = (a: liblapzt.u16) liblapzt.u16 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u8(high), liblapzt.math.reverse.bits.u8(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u32 = (a: liblapzt.u32) liblapzt.u32 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u16(high), liblapzt.math.reverse.bits.u16(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u32(high), liblapzt.math.reverse.bits.u32(low)]
}

// Returns a with its bit order reversed.
liblapzt.math.reverse.bits.u128 = (a: liblapzt.u128) liblapzt.u128 {
    [low, high] = a
    [liblapzt.math.reverse.bits.u64(high), liblapzt.math.reverse.bits.u64(low)]
}

// Returns a with its byte order reversed.
liblapzt.math.bswap.u16 = (a: liblapzt.u16) liblapzt.u16 {
    [low, high] = a
    [high, low]
}

// Returns a with its byte order reversed.
liblapzt.math.bswap.u32 = (a: liblapzt.u32) liblapzt.u32 {
    [low, high] = a
    [liblapzt.math.bswap.u16(high), liblapzt.math.bswap.u16(low)]
}

// Returns a with its byte order reversed.
liblapzt.math.bswap.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    [liblapzt.math.bswap.u32(high), liblapzt.math.bswap.u32(low)]
}

// Returns a with its byte order reversed.
liblapzt.math.bswap.u128 = (a: liblapzt.u128) liblapzt.u128 {
    [low, high] = a
    [liblapzt.math.bswap.u64(high), liblapzt.math.bswap.u64(low)]
}

// Rotates value left by amount bits. amount is reduced modulo 64,
// so any amount is valid.
liblapzt.math.rotate.left.u64 = (value: liblapzt.u64, amount: liblapzt.u64) liblapzt.u64 {
    amount.mod: liblapzt.u64 = liblapzt.u64.mod(amount, liblapzt.constants.sixty.four)
    left: liblapzt.u64 = liblapzt.math.shl.u64(value, amount.mod)
    right: liblapzt.u64 = liblapzt.math.shr.u64(value, liblapzt.u64.sub(liblapzt.constants.sixty.four, amount.mod))
    liblapzt.u64.or(left, right)
}

// Rotates value right by amount bits. amount is reduced modulo 64,
// so any amount is valid.
liblapzt.math.rotate.right.u64 = (value: liblapzt.u64, amount: liblapzt.u64) liblapzt.u64 {
    amount.mod: liblapzt.u64 = liblapzt.u64.mod(amount, liblapzt.constants.sixty.four)
    right: liblapzt.u64 = liblapzt.math.shr.u64(value, amount.mod)
    left: liblapzt.u64 = liblapzt.math.shl.u64(value, liblapzt.u64.sub(liblapzt.constants.sixty.four, amount.mod))
    liblapzt.u64.or(left, right)
}

// Returns true when value is divisible by two.
liblapzt.math.is.even.u64 = (value: liblapzt.u64) liblapzt.bool {
    liblapzt.u64.is.zero(liblapzt.u64.and(value, liblapzt.u64.one))
}

// Returns true when value is not divisible by two.
liblapzt.math.is.odd.u64 = (value: liblapzt.u64) liblapzt.bool {
    liblapzt.bool.not(liblapzt.math.is.even.u64(value))
}

// Returns the smallest power of two at least value, starting from
// power.
liblapzt.math.next.power.of.two.u64.helper = (value: liblapzt.u64, power: liblapzt.u64) liblapzt.u64 {
    enough: liblapzt.bool = liblapzt.u64.ge(power, value)
    BRANCH (enough) {
        power
    } {
        liblapzt.math.next.power.of.two.u64.helper(value, liblapzt.u64.shl1(power))
    }
}

// Returns the smallest power of two greater than or equal to value.
// Returns one for values of zero or one.
liblapzt.math.next.power.of.two.u64 = (value: liblapzt.u64) liblapzt.u64 {
    small: liblapzt.bool = liblapzt.u64.le(value, liblapzt.u64.one)
    BRANCH (small) {
        liblapzt.u64.one
    } {
        liblapzt.math.next.power.of.two.u64.helper(value, liblapzt.u64.one)
    }
}

// Rounds value up to the next multiple of alignment. Returns value
// unchanged when alignment is zero or value is already aligned.
liblapzt.math.align.up.u64 = (value: liblapzt.u64, alignment: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(alignment)
    BRANCH (zero) {
        value
    } {
        remainder: liblapzt.u64 = liblapzt.u64.mod(value, alignment)
        aligned: liblapzt.bool = liblapzt.u64.is.zero(remainder)
        BRANCH (aligned) {
            value
        } {
            liblapzt.u64.add(value, liblapzt.u64.sub(alignment, remainder))
        }
    }
}

// Rounds value down to the previous multiple of alignment. Returns
// value unchanged when alignment is zero.
liblapzt.math.align.down.u64 = (value: liblapzt.u64, alignment: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(alignment)
    BRANCH (zero) {
        value
    } {
        liblapzt.u64.sub(value, liblapzt.u64.mod(value, alignment))
    }
}

// Returns the greatest common divisor of a and b. gcd(a, 0) is a.
liblapzt.math.gcd.u64 = (a: liblapzt.u64, b: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(b)
    BRANCH (zero) {
        a
    } {
        liblapzt.math.gcd.u64(b, liblapzt.u64.mod(a, b))
    }
}

// Returns the least common multiple of a and b. Returns zero when
// either is zero.
liblapzt.math.lcm.u64 = (a: liblapzt.u64, b: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.bool.or(liblapzt.u64.is.zero(a), liblapzt.u64.is.zero(b))
    BRANCH (zero) {
        liblapzt.u64.zero
    } {
        liblapzt.u64.mul(liblapzt.u64.div(a, liblapzt.math.gcd.u64(a, b)), b)
    }
}

// Raises base to exponent by repeated squaring, starting from
// accumulator.
liblapzt.math.pow.u64.helper = (base: liblapzt.u64, exponent: liblapzt.u64, accumulator: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.is.zero(exponent)
    BRANCH (done) {
        accumulator
    } {
        odd: liblapzt.bool = liblapzt.math.is.odd.u64(exponent)
        next.accumulator: liblapzt.u64 = BRANCH (odd) {
            liblapzt.u64.mul(accumulator, base)
        } {
            accumulator
        }
        liblapzt.math.pow.u64.helper(liblapzt.u64.mul(base, base), liblapzt.math.shr1.u64(exponent), next.accumulator)
    }
}

// Returns base raised to exponent. An exponent of zero yields one.
// Overflow wraps modulo 2^64.
liblapzt.math.pow.u64 = (base: liblapzt.u64, exponent: liblapzt.u64) liblapzt.u64 {
    liblapzt.math.pow.u64.helper(base, exponent, liblapzt.u64.one)
}

// Binary-searches the floor square root of value in the half-open
// range low to high.
liblapzt.math.isqrt.u64.helper = (value: liblapzt.u64, low: liblapzt.u64, high: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.ge(low, high)
    BRANCH (done) {
        liblapzt.u64.dec(low)
    } {
        mid: liblapzt.u64 = liblapzt.u64.div(liblapzt.u64.add(low, high), liblapzt.constants.two)
        mid.zero: liblapzt.bool = liblapzt.u64.is.zero(mid)
        too.big: liblapzt.bool = BRANCH (mid.zero) {
            liblapzt.bool.false
        } {
            liblapzt.u64.gt(mid, liblapzt.u64.div(value, mid))
        }
        BRANCH (too.big) {
            liblapzt.math.isqrt.u64.helper(value, low, mid)
        } {
            liblapzt.math.isqrt.u64.helper(value, liblapzt.u64.inc(mid), high)
        }
    }
}

// Returns the integer square root of value, rounded down.
liblapzt.math.isqrt.u64 = (value: liblapzt.u64) liblapzt.u64 {
    liblapzt.math.isqrt.u64.helper(value, liblapzt.u64.zero, liblapzt.u64.add(value, liblapzt.u64.one))
}

// Adds to count the number of times value can be halved before
// reaching one.
liblapzt.math.log2.u64.helper = (value: liblapzt.u64, count: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.le(value, liblapzt.u64.one)
    BRANCH (done) {
        count
    } {
        liblapzt.math.log2.u64.helper(liblapzt.math.shr1.u64(value), liblapzt.u64.inc(count))
    }
}

// Returns the base-two logarithm of value, rounded down. Returns
// zero for value zero or one.
liblapzt.math.log2.u64 = (value: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(value)
    BRANCH (zero) {
        liblapzt.u64.zero
    } {
        liblapzt.math.log2.u64.helper(value, liblapzt.u64.zero)
    }
}

// Returns value limited to the inclusive range low to high. Returns
// low when value is below low and high when above high.
liblapzt.math.clamp.u64 = (value: liblapzt.u64, low: liblapzt.u64, high: liblapzt.u64) liblapzt.u64 {
    below: liblapzt.bool = liblapzt.u64.lt(value, low)
    above: liblapzt.bool = liblapzt.u64.gt(value, high)
    BRANCH (below) {
        low
    } {
        BRANCH (above) {
            high
        } {
            value
        }
    }
}

// Returns the absolute value of a. The minimum value has no
// positive counterpart and is returned unchanged.
liblapzt.math.abs.i8 = liblapzt.i8.abs
// Returns the absolute value of a. The minimum value has no
// positive counterpart and is returned unchanged.
liblapzt.math.abs.i16 = liblapzt.i16.abs
// Returns the absolute value of a. The minimum value has no
// positive counterpart and is returned unchanged.
liblapzt.math.abs.i32 = liblapzt.i32.abs
// Returns the absolute value of a. The minimum value has no
// positive counterpart and is returned unchanged.
liblapzt.math.abs.i64 = liblapzt.i64.abs
// Returns the absolute value of a. The minimum value has no
// positive counterpart and is returned unchanged.
liblapzt.math.abs.i128 = liblapzt.i128.abs

// Returns true when a is negative.
liblapzt.math.sign.i8 = liblapzt.i8.sign
// Returns true when a is negative.
liblapzt.math.sign.i16 = liblapzt.i16.sign
// Returns true when a is negative.
liblapzt.math.sign.i32 = liblapzt.i32.sign
// Returns true when a is negative.
liblapzt.math.sign.i64 = liblapzt.i64.sign
// Returns true when a is negative.
liblapzt.math.sign.i128 = liblapzt.i128.sign

// Shifts value left by amount bits. Bits shifted past the top are
// lost; amounts of 128 or more yield zero.
liblapzt.math.shl.u128 = (value: liblapzt.u128, amount: liblapzt.u64) liblapzt.u128 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (zero) {
        value
    } {
        liblapzt.math.shl.u128(liblapzt.u128.shl1(value), liblapzt.u64.dec(amount))
    }
}

// Shifts value right by amount bits, filling the top bits with
// zero. Amounts of 128 or more yield zero.
liblapzt.math.shr.u128 = (value: liblapzt.u128, amount: liblapzt.u64) liblapzt.u128 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (zero) {
        value
    } {
        liblapzt.math.shr.u128(liblapzt.math.shr1.u128(value), liblapzt.u64.dec(amount))
    }
}
