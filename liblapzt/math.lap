// Returns bit unchanged; a has only one bit.
liblapzt.math.with.msb.u1 = (a: liblapzt.u1, bit: liblapzt.bool) liblapzt.u1 {
    bit
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u2 = (a: liblapzt.u2, bit: liblapzt.bool) liblapzt.u2 {
    [low, high] = a
    [low, bit]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u4 = (a: liblapzt.u4, bit: liblapzt.bool) liblapzt.u4 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u2(high, bit)]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u8 = (a: liblapzt.u8, bit: liblapzt.bool) liblapzt.u8 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u4(high, bit)]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u16 = (a: liblapzt.u16, bit: liblapzt.bool) liblapzt.u16 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u8(high, bit)]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u32 = (a: liblapzt.u32, bit: liblapzt.bool) liblapzt.u32 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u16(high, bit)]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u64 = (a: liblapzt.u64, bit: liblapzt.bool) liblapzt.u64 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u32(high, bit)]
}

// Returns a with its most significant bit replaced by bit.
liblapzt.math.with.msb.u128 = (a: liblapzt.u128, bit: liblapzt.bool) liblapzt.u128 {
    [low, high] = a
    [low, liblapzt.math.with.msb.u64(high, bit)]
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u2 = (a: liblapzt.u2) liblapzt.bool {
    liblapzt.u2.is.one(liblapzt.u2.and(a, liblapzt.u2.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u4 = (a: liblapzt.u4) liblapzt.bool {
    liblapzt.u4.is.one(liblapzt.u4.and(a, liblapzt.u4.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u8 = (a: liblapzt.u8) liblapzt.bool {
    liblapzt.u8.is.one(liblapzt.u8.and(a, liblapzt.u8.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u16 = (a: liblapzt.u16) liblapzt.bool {
    liblapzt.u16.is.one(liblapzt.u16.and(a, liblapzt.u16.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u32 = (a: liblapzt.u32) liblapzt.bool {
    liblapzt.u32.is.one(liblapzt.u32.and(a, liblapzt.u32.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u64 = (a: liblapzt.u64) liblapzt.bool {
    liblapzt.u64.is.one(liblapzt.u64.and(a, liblapzt.u64.one))
}

// Returns true when the least significant bit of a is set.
liblapzt.math.lsb.u128 = (a: liblapzt.u128) liblapzt.bool {
    liblapzt.u128.is.one(liblapzt.u128.and(a, liblapzt.u128.one))
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u1 = (a: liblapzt.u1) liblapzt.u1 {
    liblapzt.u1.zero
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u2 = (a: liblapzt.u2) liblapzt.u2 {
    [low, high] = a
    [high, liblapzt.u1.zero]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u4 = (a: liblapzt.u4) liblapzt.u4 {
    [low, high] = a
    [liblapzt.math.with.msb.u2(liblapzt.math.shr1.u2(low), liblapzt.math.lsb.u2(high)), liblapzt.math.shr1.u2(high)]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u8 = (a: liblapzt.u8) liblapzt.u8 {
    [low, high] = a
    [liblapzt.math.with.msb.u4(liblapzt.math.shr1.u4(low), liblapzt.math.lsb.u4(high)), liblapzt.math.shr1.u4(high)]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u16 = (a: liblapzt.u16) liblapzt.u16 {
    [low, high] = a
    [liblapzt.math.with.msb.u8(liblapzt.math.shr1.u8(low), liblapzt.math.lsb.u8(high)), liblapzt.math.shr1.u8(high)]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u32 = (a: liblapzt.u32) liblapzt.u32 {
    [low, high] = a
    [liblapzt.math.with.msb.u16(liblapzt.math.shr1.u16(low), liblapzt.math.lsb.u16(high)), liblapzt.math.shr1.u16(high)]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    [liblapzt.math.with.msb.u32(liblapzt.math.shr1.u32(low), liblapzt.math.lsb.u32(high)), liblapzt.math.shr1.u32(high)]
}

// Shifts a right by one bit, filling the top bit with zero.
liblapzt.math.shr1.u128 = (a: liblapzt.u128) liblapzt.u128 {
    [low, high] = a
    [liblapzt.math.with.msb.u64(liblapzt.math.shr1.u64(low), liblapzt.math.lsb.u64(high)), liblapzt.math.shr1.u64(high)]
}

// Shifts value left by amount bits. Bits shifted past the top are
// lost; amounts of 64 or more yield zero.
liblapzt.math.shl.u64 = (value: liblapzt.u64, amount: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (done) {
        value
    } {
        liblapzt.math.shl.u64(liblapzt.u64.shl1(value), liblapzt.u64.dec(amount))
    }
}

// Shifts value right by amount bits, filling the top bits with
// zero. Amounts of 64 or more yield zero.
liblapzt.math.shr.u64 = (value: liblapzt.u64, amount: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.is.zero(amount)
    BRANCH (done) {
        value
    } {
        liblapzt.math.shr.u64(liblapzt.math.shr1.u64(value), liblapzt.u64.dec(amount))
    }
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u1 = (a: liblapzt.u1) liblapzt.u64 {
    BRANCH (a) {
        liblapzt.u64.one
    } {
        liblapzt.u64.zero
    }
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u2 = (a: liblapzt.u2) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u1(low), liblapzt.math.popcount.u1(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u4 = (a: liblapzt.u4) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u2(low), liblapzt.math.popcount.u2(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u8 = (a: liblapzt.u8) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u4(low), liblapzt.math.popcount.u4(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u16 = (a: liblapzt.u16) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u8(low), liblapzt.math.popcount.u8(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u32 = (a: liblapzt.u32) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u16(low), liblapzt.math.popcount.u16(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u32(low), liblapzt.math.popcount.u32(high))
}

// Returns the number of set bits in a, as a u64.
liblapzt.math.popcount.u128 = (a: liblapzt.u128) liblapzt.u64 {
    [low, high] = a
    liblapzt.u64.add(liblapzt.math.popcount.u64(low), liblapzt.math.popcount.u64(high))
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 1 when a is zero.
liblapzt.math.clz.u1 = (a: liblapzt.u1) liblapzt.u64 {
    BRANCH (a) {
        liblapzt.u64.zero
    } {
        liblapzt.u64.one
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 2 when a is zero.
liblapzt.math.clz.u2 = (a: liblapzt.u2) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u1.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.u64.one, liblapzt.math.clz.u1(low))
    } {
        liblapzt.math.clz.u1(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 4 when a is zero.
liblapzt.math.clz.u4 = (a: liblapzt.u4) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u2.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.two, liblapzt.math.clz.u2(low))
    } {
        liblapzt.math.clz.u2(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 8 when a is zero.
liblapzt.math.clz.u8 = (a: liblapzt.u8) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u4.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.four, liblapzt.math.clz.u4(low))
    } {
        liblapzt.math.clz.u4(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 16 when a is zero.
liblapzt.math.clz.u16 = (a: liblapzt.u16) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u8.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.eight, liblapzt.math.clz.u8(low))
    } {
        liblapzt.math.clz.u8(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 32 when a is zero.
liblapzt.math.clz.u32 = (a: liblapzt.u32) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u16.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.sixteen, liblapzt.math.clz.u16(low))
    } {
        liblapzt.math.clz.u16(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 64 when a is zero.
liblapzt.math.clz.u64 = (a: liblapzt.u64) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u32.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.thirty.two, liblapzt.math.clz.u32(low))
    } {
        liblapzt.math.clz.u32(high)
    }
}

// Returns the number of leading zero bits in a, as a u64.
// Returns 128 when a is zero.
liblapzt.math.clz.u128 = (a: liblapzt.u128) liblapzt.u64 {
    [low, high] = a
    high.zero: liblapzt.bool = liblapzt.u64.is.zero(high)
    BRANCH (high.zero) {
        liblapzt.u64.add(liblapzt.constants.sixty.four, liblapzt.math.clz.u64(low))
    } {
        liblapzt.math.clz.u64(high)
    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 1 when a is zero.
liblapzt.math.ctz.u1 = (a: liblapzt.u1) liblapzt.u64 {
    BRANCH (a) {
        liblapzt.u64.zero
    } {
        liblapzt.u64.one
    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 2 when a is zero.
liblapzt.math.ctz.u2 = (a: liblapzt.u2) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u1.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.u64.one, liblapzt.math.ctz.u1(high))
    } {
        liblapzt.math.ctz.u1(low)
    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 4 when a is zero.
liblapzt.math.ctz.u4 = (a: liblapzt.u4) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u2.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.two, liblapzt.math.ctz.u2(high))
    } {
        liblapzt.math.ctz.u2(low)
    }
}

// Returns the number of trailing zero bits in a, as a u64.
// Returns 8 when a is zero.
liblapzt.math.ctz.u8 = (a: liblapzt.u8) liblapzt.u64 {
    [low, high] = a
    low.zero: liblapzt.bool = liblapzt.u4.is.zero(low)
    BRANCH (low.zero) {
        liblapzt.u64.add(liblapzt.constants.four, liblapzt.math.ctz.u4(high))
    } {
