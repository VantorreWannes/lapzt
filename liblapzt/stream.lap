// Byte streams over a readable handle.
//
// A stream is [handle, word, remaining, done]. It buffers one word at a
// time and hands out bytes in little-endian order.

liblapzt.stream = [liblapzt.u64, liblapzt.u64, liblapzt.u64, liblapzt.bool]

// Builds a stream over a readable handle.
liblapzt.stream.new = (handle: liblapzt.u64) liblapzt.stream {
    [handle, liblapzt.u64.zero, liblapzt.u64.zero, liblapzt.bool.false]
}

// Returns true once the stream has reached end of input.
liblapzt.stream.eof = (stream: liblapzt.stream) liblapzt.bool {
    [handle, word, remaining, done] = stream
    done
}

// Reads one byte and advances the stream. Returns false at end of input.
liblapzt.stream.read.byte = (stream: *liblapzt.stream) [liblapzt.bool, liblapzt.u8] {
    [handle, word, remaining, done] = stream
    BRANCH (done) {
        [liblapzt.bool.false, liblapzt.u8.zero]
    } {
        empty: liblapzt.bool = liblapzt.u64.is.zero(remaining)
        BRANCH (empty) {
            [ok, next] = liblapzt.io.read.word(handle)
            BRANCH (ok) {
                byte: liblapzt.u8 = liblapzt.u64.to.u8(next)
                seven: liblapzt.u64 = liblapzt.constants.seven
                stream = [handle, liblapzt.math.shr.u64(next, liblapzt.constants.eight), seven, liblapzt.bool.false]
                [liblapzt.bool.true, byte]
            } {
                zero: liblapzt.u64 = liblapzt.u64.zero
                stream = [handle, zero, zero, liblapzt.bool.true]
                [liblapzt.bool.false, liblapzt.u8.zero]
            }
        } {
            byte: liblapzt.u8 = liblapzt.u64.to.u8(word)
            next.remaining: liblapzt.u64 = liblapzt.u64.dec(remaining)
            stream = [handle, liblapzt.math.shr.u64(word, liblapzt.constants.eight), next.remaining, liblapzt.bool.false]
            [liblapzt.bool.true, byte]
        }
    }
}

// Accumulates eight bytes into a word, low byte first.
liblapzt.stream.read.word.helper = (stream: *liblapzt.stream, index: liblapzt.u64, word: liblapzt.u64) [liblapzt.bool, liblapzt.u64] {
    done: liblapzt.bool = liblapzt.u64.ge(index, liblapzt.constants.eight)
    BRANCH (done) {
        [liblapzt.bool.true, word]
    } {
        [ok, byte] = liblapzt.stream.read.byte(stream)
        BRANCH (ok) {
            next: liblapzt.u64 = liblapzt.u64.or(word, liblapzt.math.shl.u64(liblapzt.u8.to.u64(byte), liblapzt.u64.mul(index, liblapzt.constants.eight)))
            liblapzt.stream.read.word.helper(stream, liblapzt.u64.inc(index), next)
        } {
            [liblapzt.bool.false, liblapzt.u64.zero]
        }
    }
}

// Reads eight bytes and assembles them into a word, low byte first.
liblapzt.stream.read.word = (stream: *liblapzt.stream) [liblapzt.bool, liblapzt.u64] {
    liblapzt.stream.read.word.helper(stream, liblapzt.u64.zero, liblapzt.u64.zero)
}
