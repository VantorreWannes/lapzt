// The decimal radix as a word.
liblapzt.print.ten: liblapzt.u64 = [[[[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]
// The ASCII code of the digit zero.
liblapzt.print.forty.eight: liblapzt.u64 = [[[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.true, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]
// A word holding a single newline byte.
liblapzt.print.newline.word: liblapzt.u64 = [[[[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]
// The decimal radix as a 128-bit value.
liblapzt.print.ten.u128: liblapzt.u128 = [[[[[[[liblapzt.bool.false, liblapzt.bool.true], [liblapzt.bool.false, liblapzt.bool.true]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]], [[[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]], [[[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]], [[[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]], [[[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]], [[liblapzt.bool.false, liblapzt.bool.false], [liblapzt.bool.false, liblapzt.bool.false]]]]]]]

// Writes one decimal digit for a value below ten to standard output.
liblapzt.print.digit = (digit: liblapzt.u64) [] {
    ascii: liblapzt.u64 = liblapzt.u64.add(digit, liblapzt.print.forty.eight)
    [ok] = liblapzt.io.write.bytes(liblapzt.io.stdout, liblapzt.u64.zero, ascii, liblapzt.constants.one)
    liblapzt.assert.true(ok)
    []
}

// Writes value in decimal to standard output. Zero prints as a single
// zero digit.
liblapzt.print.u64 = (value: liblapzt.u64) [] {
    quotient: liblapzt.u64 = liblapzt.u64.div(value, liblapzt.print.ten)
    remainder: liblapzt.u64 = liblapzt.u64.mod(value, liblapzt.print.ten)
    done: liblapzt.bool = liblapzt.u64.is.zero(quotient)
    BRANCH (done) {
        liblapzt.print.digit(remainder)
    } {
        liblapzt.print.u64(quotient)
        liblapzt.print.digit(remainder)
    }
}

// Returns the low 64 bits of a 128 bit value.
liblapzt.print.to.u64 = (value: liblapzt.u128) liblapzt.u64 {
    [low, high] = value
    low
}

// Writes value in decimal to standard output.
liblapzt.print.u128 = (value: liblapzt.u128) [] {
    quotient: liblapzt.u128 = liblapzt.u128.div(value, liblapzt.print.ten.u128)
    remainder: liblapzt.u128 = liblapzt.u128.mod(value, liblapzt.print.ten.u128)
    digit: liblapzt.u64 = liblapzt.print.to.u64(remainder)
    done: liblapzt.bool = liblapzt.u128.is.zero(quotient)
    BRANCH (done) {
        liblapzt.print.digit(digit)
    } {
        liblapzt.print.u128(quotient)
        liblapzt.print.digit(digit)
    }
}

// Writes a newline to standard output.
liblapzt.print.newline = () [] {
    [ok] = liblapzt.io.write.bytes(liblapzt.io.stdout, liblapzt.u64.zero, liblapzt.print.newline.word, liblapzt.constants.one)
    liblapzt.assert.true(ok)
    []
}

// Writes the byte ascii to standard output. The value is not checked
// against the ASCII range.
liblapzt.print.char = (ascii: liblapzt.u64) [] {
    [ok] = liblapzt.io.write.bytes(liblapzt.io.stdout, liblapzt.u64.zero, ascii, liblapzt.constants.one)
    liblapzt.assert.true(ok)
    []
}

// Writes true or false to standard output.
liblapzt.print.bool = (value: liblapzt.bool) [] {
    BRANCH (value) {
        liblapzt.print.char(liblapzt.constants.ascii.lower.t)
        liblapzt.print.char(liblapzt.constants.ascii.lower.r)
        liblapzt.print.char(liblapzt.constants.ascii.lower.u)
        liblapzt.print.char(liblapzt.constants.ascii.lower.e)
        []
    } {
        liblapzt.print.char(liblapzt.constants.ascii.lower.f)
        liblapzt.print.char(liblapzt.constants.ascii.lower.a)
        liblapzt.print.char(liblapzt.constants.ascii.lower.l)
        liblapzt.print.char(liblapzt.constants.ascii.lower.s)
        liblapzt.print.char(liblapzt.constants.ascii.lower.e)
        []
    }
}

// Writes value in decimal to standard output.
liblapzt.print.u8 = (value: liblapzt.u8) [] {
    liblapzt.print.u64(liblapzt.u8.to.u64(value))
}

// Writes value in decimal to standard output.
liblapzt.print.u16 = (value: liblapzt.u16) [] {
    liblapzt.print.u64(liblapzt.u16.to.u64(value))
}

// Writes value in decimal to standard output.
liblapzt.print.u32 = (value: liblapzt.u32) [] {
    liblapzt.print.u64(liblapzt.u32.to.u64(value))
}

// Writes value in decimal to standard output, with a leading minus for
// negative values.
liblapzt.print.i64 = (value: liblapzt.i64) [] {
    negative: liblapzt.bool = liblapzt.i64.is.negative(value)
    BRANCH (negative) {
        liblapzt.print.char(liblapzt.constants.ascii.minus)
        liblapzt.print.u64(liblapzt.i64.to.u64(liblapzt.i64.neg(value)))
    } {
        liblapzt.print.u64(liblapzt.i64.to.u64(value))
    }
}

// Writes one lowercase hexadecimal digit for a value below sixteen.
liblapzt.print.hex.digit = (digit: liblapzt.u64) [] {
    below.ten: liblapzt.bool = liblapzt.u64.lt(digit, liblapzt.constants.ten)
    BRANCH (below.ten) {
        liblapzt.print.char(liblapzt.u64.add(digit, liblapzt.constants.ascii.zero))
    } {
        liblapzt.print.char(liblapzt.u64.add(liblapzt.u64.sub(digit, liblapzt.constants.ten), liblapzt.constants.ascii.lower.a))
    }
}

// Writes the sixteen hexadecimal digits of value from index.
liblapzt.print.hex.u64.helper = (value: liblapzt.u64, index: liblapzt.u64) [] {
    done: liblapzt.bool = liblapzt.u64.ge(index, liblapzt.constants.sixteen)
    BRANCH (done) {
        []
    } {
        shift: liblapzt.u64 = liblapzt.u64.mul(liblapzt.u64.sub(liblapzt.constants.sixteen, liblapzt.u64.inc(index)), liblapzt.constants.four)
        digit: liblapzt.u64 = liblapzt.u64.and(liblapzt.math.shr.u64(value, shift), liblapzt.constants.fifteen)
        liblapzt.print.hex.digit(digit)
        liblapzt.print.hex.u64.helper(value, liblapzt.u64.inc(index))
    }
}

// Writes value as sixteen lowercase hexadecimal digits to standard
// output, including leading zeros.
liblapzt.print.hex.u64 = (value: liblapzt.u64) [] {
    liblapzt.print.hex.u64.helper(value, liblapzt.u64.zero)
}

// Writes the sixty four bits of value from index, most significant
// first.
liblapzt.print.bin.u64.helper = (value: liblapzt.u64, index: liblapzt.u64) [] {
    done: liblapzt.bool = liblapzt.u64.ge(index, liblapzt.constants.sixty.four)
    BRANCH (done) {
        []
    } {
        shift: liblapzt.u64 = liblapzt.u64.sub(liblapzt.constants.sixty.four, liblapzt.u64.inc(index))
        bit: liblapzt.u64 = liblapzt.u64.and(liblapzt.math.shr.u64(value, shift), liblapzt.u64.one)
        liblapzt.print.char(liblapzt.u64.add(bit, liblapzt.constants.ascii.zero))
        liblapzt.print.bin.u64.helper(value, liblapzt.u64.inc(index))
    }
}

// Writes value as sixty four binary digits to standard output,
// including leading zeros.
liblapzt.print.bin.u64 = (value: liblapzt.u64) [] {
    liblapzt.print.bin.u64.helper(value, liblapzt.u64.zero)
}

// Counts the decimal digits of value, which must be non zero.
liblapzt.print.u64.digits.helper = (value: liblapzt.u64, count: liblapzt.u64) liblapzt.u64 {
    done: liblapzt.bool = liblapzt.u64.is.zero(value)
    BRANCH (done) {
        count
    } {
        liblapzt.print.u64.digits.helper(liblapzt.u64.div(value, liblapzt.constants.ten), liblapzt.u64.inc(count))
    }
}

// Returns the number of decimal digits needed to print value. Zero has
// one digit.
liblapzt.print.u64.digits = (value: liblapzt.u64) liblapzt.u64 {
    zero: liblapzt.bool = liblapzt.u64.is.zero(value)
    BRANCH (zero) {
        liblapzt.u64.one
    } {
        liblapzt.print.u64.digits.helper(value, liblapzt.u64.zero)
    }
}

// Writes count copies of pad to standard output.
liblapzt.print.u64.pad.helper = (count: liblapzt.u64, pad: liblapzt.u8) [] {
    done: liblapzt.bool = liblapzt.u64.is.zero(count)
    BRANCH (done) {
        []
    } {
        liblapzt.print.char(liblapzt.u8.to.u64(pad))
        liblapzt.print.u64.pad.helper(liblapzt.u64.dec(count), pad)
    }
}

// Writes value in decimal, left padded with pad to at least width
// characters. Values wider than width are printed in full.
liblapzt.print.u64.padded = (value: liblapzt.u64, width: liblapzt.u64, pad: liblapzt.u8) [] {
    digits: liblapzt.u64 = liblapzt.print.u64.digits(value)
    enough: liblapzt.bool = liblapzt.u64.ge(digits, width)
    BRANCH (enough) {
        liblapzt.print.u64(value)
    } {
        liblapzt.print.u64.pad.helper(liblapzt.u64.sub(width, digits), pad)
        liblapzt.print.u64(value)
    }
}

// Writes six fractional digits of fraction, which must be below one.
liblapzt.print.f64.fraction = (fraction: liblapzt.f64, index: liblapzt.u64) [] {
    done: liblapzt.bool = liblapzt.u64.ge(index, liblapzt.constants.six)
    BRANCH (done) {
        []
    } {
        ten: liblapzt.f64 = liblapzt.f64.from.u64(liblapzt.constants.ten)
        scaled: liblapzt.f64 = liblapzt.f64.mul(fraction, ten)
        digit: liblapzt.u64 = liblapzt.f64.to.u64(liblapzt.f64.trunc(scaled))
        liblapzt.print.digit(digit)
        next: liblapzt.f64 = liblapzt.f64.sub(scaled, liblapzt.f64.trunc(scaled))
        liblapzt.print.f64.fraction(next, liblapzt.u64.inc(index))
    }
}

// Writes a non negative value as whole.fraction with six fractional
// digits.
liblapzt.print.f64.positive = (value: liblapzt.f64) [] {
    whole: liblapzt.f64 = liblapzt.f64.trunc(value)
    fraction: liblapzt.f64 = liblapzt.f64.sub(value, whole)
    liblapzt.print.u64(liblapzt.f64.to.u64(whole))
    liblapzt.print.char(liblapzt.constants.ascii.dot)
    liblapzt.print.f64.fraction(fraction, liblapzt.u64.zero)
}

// Writes value in decimal with six fractional digits. NaN prints as
// nan and infinities as inf with a leading minus when negative.
liblapzt.print.f64 = (value: liblapzt.f64) [] {
    nan: liblapzt.bool = liblapzt.f64.is.nan(value)
    infinite: liblapzt.bool = liblapzt.f64.is.infinite(value)
    negative: liblapzt.bool = liblapzt.f64.is.negative(value)
    BRANCH (nan) {
        liblapzt.print.char(liblapzt.constants.ascii.lower.n)
        liblapzt.print.char(liblapzt.constants.ascii.lower.a)
        liblapzt.print.char(liblapzt.constants.ascii.lower.n)
        []
    } {
        BRANCH (infinite) {
            BRANCH (negative) {
                liblapzt.print.char(liblapzt.constants.ascii.minus)
                []
            } {
                []
            }
            liblapzt.print.char(liblapzt.constants.ascii.lower.i)
            liblapzt.print.char(liblapzt.constants.ascii.lower.n)
            liblapzt.print.char(liblapzt.constants.ascii.lower.f)
        } {
            BRANCH (negative) {
                liblapzt.print.char(liblapzt.constants.ascii.minus)
                liblapzt.print.f64.positive(liblapzt.f64.neg(value))
            } {
                liblapzt.print.f64.positive(value)
            }
        }
    }
}

// Writes value in decimal with six fractional digits.
liblapzt.print.f32 = (value: liblapzt.f32) [] {
    liblapzt.print.f64(liblapzt.f32.to.f64(value))
}

// Writes value in decimal with six fractional digits.
liblapzt.print.f16 = (value: liblapzt.f16) [] {
    liblapzt.print.f64(liblapzt.f16.to.f64(value))
}

// Writes value in decimal with six fractional digits.
liblapzt.print.f128 = (value: liblapzt.f128) [] {
    liblapzt.print.f64(liblapzt.f128.to.f64(value))
}
