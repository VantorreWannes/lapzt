liblapzt.print.digit = (digit: liblapzt.u64) [] {
    ascii: liblapzt.u64 = liblapzt.u64.add(digit, liblapzt.print.forty.eight)
    [ok] = liblapzt.io.write(liblapzt.io.stdout, liblapzt.u64.zero, ascii)
    liblapzt.assert.true(ok)
    []
}

liblapzt.print.u64 = (value: liblapzt.u64) [] {
    quotient: liblapzt.u64 = liblapzt.u64.div(value, liblapzt.print.ten)
    remainder: liblapzt.u64 = liblapzt.u64.mod(value, liblapzt.print.ten)
    done: liblapzt.bool = liblapzt.u64.is.zero(quotient)
    BRANCH (done) {
        liblapzt.print.digit(remainder)
    } {
        liblapzt.print.u64(quotient)
        liblapzt.print.digit(remainder)
    }
}

liblapzt.print.to.u64 = (value: liblapzt.u128) liblapzt.u64 {
    [low, high] = value
    low
}

liblapzt.print.u128 = (value: liblapzt.u128) [] {
    quotient: liblapzt.u128 = liblapzt.u128.div(value, liblapzt.print.ten.u128)
    remainder: liblapzt.u128 = liblapzt.u128.mod(value, liblapzt.print.ten.u128)
    digit: liblapzt.u64 = liblapzt.print.to.u64(remainder)
    done: liblapzt.bool = liblapzt.u128.is.zero(quotient)
    BRANCH (done) {
        liblapzt.print.digit(digit)
    } {
        liblapzt.print.u128(quotient)
        liblapzt.print.digit(digit)
    }
}

liblapzt.print.newline = () [] {
    [ok] = liblapzt.io.write(liblapzt.io.stdout, liblapzt.u64.zero, liblapzt.print.newline.word)
    liblapzt.assert.true(ok)
    []
}
