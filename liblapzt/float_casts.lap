liblapzt.f16.to.f32.finite = (a: liblapzt.f16) liblapzt.f32 {
    sign: liblapzt.bool = liblapzt.f16.sign(a)
    exponent: liblapzt.u16 = liblapzt.f16.exponent(a)
    mantissa: liblapzt.u16 = liblapzt.f16.mantissa(a)
    zero: liblapzt.bool = liblapzt.u16.is.zero(exponent)
    maximum: liblapzt.bool = liblapzt.u16.eq(exponent, liblapzt.f16.exponent.maximum)
    BRANCH (zero) {
        liblapzt.f32.pack(sign, liblapzt.u32.zero, liblapzt.u32.zero)
    } {
        BRANCH (maximum) {
            liblapzt.f32.pack(sign, liblapzt.f32.exponent.maximum, liblapzt.u64.to.u32(liblapzt.math.shl.u64(liblapzt.u16.to.u64(mantissa), liblapzt.constants.n13)))
        } {
            new.exponent: liblapzt.u64 = liblapzt.u64.add(liblapzt.u64.sub(liblapzt.u16.to.u64(exponent), liblapzt.u16.to.u64(liblapzt.f16.bias)), liblapzt.u32.to.u64(liblapzt.f32.bias))
            new.mantissa: liblapzt.u64 = liblapzt.math.shl.u64(liblapzt.u16.to.u64(mantissa), liblapzt.constants.n13)
            liblapzt.f32.pack(sign, liblapzt.u64.to.u32(new.exponent), liblapzt.u64.to.u32(new.mantissa))
        }
    }
}

