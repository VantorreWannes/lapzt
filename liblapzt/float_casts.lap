liblapzt.f32.to.f16.finite = (a: liblapzt.f32) liblapzt.f16 {
    sign: liblapzt.bool = liblapzt.f32.sign(a)
    exponent: liblapzt.u32 = liblapzt.f32.exponent(a)
    mantissa: liblapzt.u32 = liblapzt.f32.mantissa(a)
    zero: liblapzt.bool = liblapzt.u32.is.zero(exponent)
    maximum: liblapzt.bool = liblapzt.u32.eq(exponent, liblapzt.f32.exponent.maximum)
    difference: liblapzt.u32 = liblapzt.u32.sub(liblapzt.f32.bias, liblapzt.u16.to.u32(liblapzt.f16.bias))
    underflow: liblapzt.bool = liblapzt.u32.le(exponent, difference)
    overflow: liblapzt.bool = liblapzt.u32.ge(exponent, liblapzt.u32.add(difference, liblapzt.u16.to.u32(liblapzt.f16.exponent.maximum)))
    rounding: liblapzt.u64 = liblapzt.math.shl.u64(liblapzt.u64.one, liblapzt.constants.n12)
    rounded: liblapzt.u64 = liblapzt.u64.add(liblapzt.u32.to.u64(mantissa), rounding)
    shifted: liblapzt.u64 = liblapzt.math.shr.u64(rounded, liblapzt.constants.n13)
    mantissa.limit: liblapzt.u64 = liblapzt.math.shl.u64(liblapzt.u64.one, liblapzt.constants.n10)
    carry: liblapzt.bool = liblapzt.u64.ge(shifted, mantissa.limit)
    BRANCH (zero) {
        liblapzt.f16.pack(sign, liblapzt.u16.zero, liblapzt.u16.zero)
    } {
        BRANCH (maximum) {
            liblapzt.f16.pack(sign, liblapzt.f16.exponent.maximum, liblapzt.u64.to.u16(shifted))
        } {
            BRANCH (underflow) {
                liblapzt.f16.pack(sign, liblapzt.u16.zero, liblapzt.u16.zero)
            } {
                BRANCH (overflow) {
                    liblapzt.f16.pack(sign, liblapzt.f16.exponent.maximum, liblapzt.u16.zero)
                } {
                    new.exponent: liblapzt.u32 = liblapzt.u32.sub(exponent, difference)
                    BRANCH (carry) {
                        incremented: liblapzt.u32 = liblapzt.u32.inc(new.exponent)
                        at.maximum: liblapzt.bool = liblapzt.u32.ge(incremented, liblapzt.u16.to.u32(liblapzt.f16.exponent.maximum))
                        BRANCH (at.maximum) {
                            liblapzt.f16.pack(sign, liblapzt.f16.exponent.maximum, liblapzt.u16.zero)
                        } {
                            liblapzt.f16.pack(sign, liblapzt.u32.to.u16(incremented), liblapzt.u16.zero)
                        }
                    } {
                        liblapzt.f16.pack(sign, liblapzt.u32.to.u16(new.exponent), liblapzt.u64.to.u16(shifted))
                    }
                }
            }
        }
    }
}

